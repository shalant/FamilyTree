@inherits LayoutComponentBase
@rendermode InteractiveServer

@using MudBlazor
@using FamilyTree.Web.Services
@using FamilyTree.Web.Modules.Components

@inject ThemeService Theme
@inject NavigationManager Nav

<MudThemeProvider Theme="_mudTheme" @bind-IsDarkMode="_isDark" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />
@* ToastContainer lives once at Routes.razor's root, not here — see the comment there. *@

<MudLayout>
    <CustomAppBar @bind-IsDark="_isDark" />

    @* <MudMainContent Style="background:var(--ft-surface); min-height:100vh;"> *@
    <MudMainContent Class="ft-main ft-main--page">
        <div class="ft-page-body">@Body</div>
        <PageFooter />
    </MudMainContent>

</MudLayout>

@code {
    private bool _isDark;

    // One shared theme for every layout (ArborKinTheme, 2026-11-24).
    private readonly MudTheme _mudTheme = ArborKinTheme.Create();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Restore saved preference and keep our bool in sync
        await Theme.InitAsync();
        _isDark = Theme.IsDark;
        Theme.OnChange += OnThemeChanged;
        StateHasChanged();
    }

    private async Task ToggleTheme()
    {
        await Theme.ToggleAsync();
        _isDark = Theme.IsDark;
    }

    private void OnThemeChanged()
    {
        _isDark = Theme.IsDark;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Theme.OnChange -= OnThemeChanged;
}