@inherits LayoutComponentBase
@rendermode InteractiveServer

@using MudBlazor
@using FamilyTree.Web.Services

@inject ThemeService Theme
@inject NavigationManager Nav

<MudThemeProvider Theme="_mudTheme" @bind-IsDarkMode="_isDark" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    <CustomAppBar @bind-IsDark="_isDark" />

    @* <MudMainContent Style="background:var(--ft-surface); min-height:100vh;"> *@
    <MudMainContent Class="ft-main">
        @Body
    </MudMainContent>

</MudLayout>

@code {
    private bool _isDark;

    // Our custom MudBlazor theme — colours come from CSS vars where possible.
    // The palette here is the fallback for MudBlazor's own component coloring.
    private MudTheme _mudTheme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#1e7d50",
            PrimaryDarken = "#0f472c",
            PrimaryLighten = "#4db282",
            Success = "#1e7d50",
            Background = "#ffffff",
            Surface = "#f8faf9",
            DrawerBackground = "#f8faf9",
            AppbarBackground = "#f8faf9",
            AppbarText = "#212529",
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#4faa78",
            PrimaryDarken = "#2e6b48",
            PrimaryLighten = "#9dd6ba",
            Success = "#4faa78",
            Background = "#121417",
            Surface = "#1a1d21",
            DrawerBackground = "#1a1d21",
            AppbarBackground = "#1a1d21",
            AppbarText = "#dee2e6",
        },
        Typography = new Typography
        {
            Default = new DefaultTypography { FontFamily = ["Inter", "system-ui", "sans-serif"] }
        }
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Restore saved preference and keep our bool in sync
        await Theme.InitAsync();
        _isDark = Theme.IsDark;
        Theme.OnChange += OnThemeChanged;
        StateHasChanged();
    }

    private async Task ToggleTheme()
    {
        await Theme.ToggleAsync();
        _isDark = Theme.IsDark;
    }

    private void OnThemeChanged()
    {
        _isDark = Theme.IsDark;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Theme.OnChange -= OnThemeChanged;
}