@* Minimal full-screen layout for the tree page.
   No MudLayout wrapper — avoids stacking-context interference with
   the fixed-position canvas. Providers + AppBar are still present. *@

@inherits LayoutComponentBase
@rendermode InteractiveServer

@using FamilyTree.Web.Modules.Components
@using MudBlazor
@using FamilyTree.Web.Services

@inject ThemeService Theme

@* Lock scroll at the layout level — no JS dependency, applies from first SSR render.
   Prevents body whitespace from MudBlazor in-flow providers showing below the fixed canvas. *@
<HeadContent>
    <style>
        html, body {
            overflow: hidden !important;
            height: 100dvh !important;
            max-height: 100dvh !important;
        }
        /* The canvas fades in from opacity 0 once its JS is up, and the loading surface is
           gone by then: this keeps the page the canvas's green (minus the soft glows) so
           the hand-off never flashes white. */
        body {
            background: linear-gradient(to bottom, var(--ft-green-50) 0%, var(--ft-green-200) 100%) fixed;
        }
    </style>
</HeadContent>

<MudThemeProvider Theme="_mudTheme" @bind-IsDarkMode="_isDark" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />
@* ToastContainer lives once at Routes.razor's root, not here — see the comment there. *@

@* Signed out, the tree page is only the sign-in card. The app bar (logo, search, avatar) used to show
   as a blurred ghost behind it, the "am I already in?" signal AuthLayout exists to prevent
   (UX/UI review L1, 2026-11-18). *@
<AuthorizeView>
    <Authorized>
        <CustomAppBar @bind-IsDark="_isDark" />
    </Authorized>
</AuthorizeView>

@Body

@code {
    private bool _isDark;

    // One shared theme for every layout (ArborKinTheme, 2026-11-24).
    private readonly MudTheme _mudTheme = ArborKinTheme.Create();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Theme.InitAsync();
        _isDark = Theme.IsDark;
        Theme.OnChange += OnThemeChanged;
        StateHasChanged();
    }

    private void OnThemeChanged()
    {
        _isDark = Theme.IsDark;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Theme.OnChange -= OnThemeChanged;
}
