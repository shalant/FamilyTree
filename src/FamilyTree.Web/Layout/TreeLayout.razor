@* Minimal full-screen layout for the tree page.
   No MudLayout wrapper — avoids stacking-context interference with
   the fixed-position canvas. Providers + AppBar are still present. *@

@inherits LayoutComponentBase
@rendermode InteractiveServer

@using MudBlazor
@using FamilyTree.Web.Services

@inject ThemeService Theme

@* Lock scroll at the layout level — no JS dependency, applies from first SSR render.
   Prevents body whitespace from MudBlazor in-flow providers showing below the fixed canvas. *@
<HeadContent>
    <style>
        html, body {
            overflow: hidden !important;
            height: 100dvh !important;
            max-height: 100dvh !important;
        }
    </style>
</HeadContent>

<MudThemeProvider Theme="_mudTheme" @bind-IsDarkMode="_isDark" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<CustomAppBar @bind-IsDark="_isDark" />

@Body

@code {
    private bool _isDark;

    private MudTheme _mudTheme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#1e7d50",
            PrimaryDarken = "#0f472c",
            PrimaryLighten = "#4db282",
            Success = "#1e7d50",
            Background = "#ffffff",
            Surface = "#f8faf9",
            DrawerBackground = "#f8faf9",
            AppbarBackground = "#f8faf9",
            AppbarText = "#212529",
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#4faa78",
            PrimaryDarken = "#2e6b48",
            PrimaryLighten = "#9dd6ba",
            Success = "#4faa78",
            Background = "#121417",
            Surface = "#1a1d21",
            DrawerBackground = "#1a1d21",
            AppbarBackground = "#1a1d21",
            AppbarText = "#dee2e6",
        },
        Typography = new Typography
        {
            Default = new DefaultTypography { FontFamily = ["Inter", "system-ui", "sans-serif"] }
        }
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Theme.InitAsync();
        _isDark = Theme.IsDark;
        Theme.OnChange += OnThemeChanged;
        StateHasChanged();
    }

    private void OnThemeChanged()
    {
        _isDark = Theme.IsDark;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Theme.OnChange -= OnThemeChanged;
}
