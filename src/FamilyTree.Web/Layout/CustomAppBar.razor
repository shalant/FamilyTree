@* ═══════════════════════════════════════════════════════════════════════════
   AppHeader — top navigation bar.

   Desktop: logo | search | [add · people · import · dashboard · dark · chip · avatar]
   Mobile:  logo | search | [hamburger]  →  slide-in drawer with full nav
   ═══════════════════════════════════════════════════════════════════════════ *@

@using FamilyTree.Shared.DTOs.Person
@using FamilyTree.Web.Services
@using MudBlazor
@using System.Security.Claims
@inject IPersonService PersonService
@inject ThemeService Theme
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject TreeContextService TreeContext
@implements IAsyncDisposable

@* ── AppBar shell ──────────────────────────────────────────────────────────── *@
<MudAppBar id="ft-appbar"
           Elevation="0"
           Style="background: rgba(245,245,245,0.3) !important;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 0.5px solid rgba(255, 255, 255, 0.25);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.2);">

    @* ── Logo ─────────────────────────────────────────────────────────────── *@
    <div class="ft-appbar-logo" @onclick='() => Nav.NavigateTo("/")'>
        <img src="/images/arborkin-logo__transparent.png" alt="ArborKin" />
    </div>

    @* ── Search (desktop only) ────────────────────────────────────────────── *@
    <div class="ft-search-wrap">
        <MudAutocomplete T="PersonDto"
                         Value="_searchSelection"
                         SearchFunc="SearchPeople"
                         ValueChanged="OnPersonSelected"
                         ToStringFunc="@(p => p?.FullName ?? "")"
                         Placeholder="Search people…"
                         Variant="Variant.Outlined"
                         Margin="Margin.Dense"
                         Adornment="Adornment.Start"
                         AdornmentIcon="@Icons.Material.Outlined.Search"
                         AdornmentColor="Color.Success"
                         ResetValueOnEmptyText="true"
                         CoerceText="false"
                         Clearable="true"
                         Dense="true"
                         MaxItems="8"
                         PopoverClass="ft-search-popover">
            <ItemTemplate Context="person">
                <div style="display:flex; align-items:center; gap:10px; padding:6px 4px;">
                    <div style="width:28px; height:28px; border-radius:50%; flex-shrink:0;
                        background:var(--ft-focus-fill); color:var(--ft-focus-text);
                        display:flex; align-items:center; justify-content:center;
                        font-size:11px; font-weight:500; overflow:hidden;">
                        @if (!string.IsNullOrWhiteSpace(person.ProfilePhotoUrl))
                        {
                            <img src="@person.ProfilePhotoUrl" alt=""
                                 style="width:100%; height:100%; object-fit:cover;" />
                        }
                        else
                        {
                            @MiniInitials(person)
                        }
                    </div>
                    <div style="display:flex; flex-direction:column; line-height:1.3;">
                        <span style="font-size:13px; color:var(--ft-text-primary);">@person.FullName</span>
                        @if (person.BirthDate.HasValue || person.DeathDate.HasValue)
                        {
                            <span style="font-size:11px; color:var(--ft-text-muted);">
                                @(person.BirthDate?.Year.ToString() ?? "?")
                                @(person.DeathDate.HasValue ? $"– {person.DeathDate.Value.Year}" : "")
                            </span>
                        }
                    </div>
                </div>
            </ItemTemplate>
            <NoItemsTemplate>
                <div style="padding:12px 16px; font-size:13px; color:var(--ft-text-muted);">No matches found</div>
            </NoItemsTemplate>
        </MudAutocomplete>
    </div>

    @* ── User identity (mobile only — replaces search) ────────────────────────── *@
    <div class="ft-appbar-family-title">
        <div class="ft-appbar-user-id">
            <MudAvatar Size="Size.Small" Color="Color.Primary">
                @if (!string.IsNullOrWhiteSpace(_userPhotoUrl))
                {
                    <img src="@_userPhotoUrl" alt="You" style="width:100%; height:100%; object-fit:cover;" />
                }
                else
                {
                    @_userInitials
                }
            </MudAvatar>
            <span class="ft-family-title-name">@_userName</span>
        </div>
    </div>

    <div class="ft-appbar-spacer" style="flex:1 1 auto;"></div>

    @* ── Desktop nav (hidden on mobile) ───────────────────────────────────── *@
    <div class="ft-nav-desktop">
        <MudTooltip Text="Add person" Placement="Placement.Bottom">
            <MudIconButton Icon="@Icons.Material.Outlined.PersonAdd"
                           Style="color:var(--ft-green-600);"
                           OnClick='() => Nav.NavigateTo("/people/add")' />
        </MudTooltip>

        <MudTooltip Text="People list" Placement="Placement.Bottom">
            <MudIconButton Icon="@Icons.Material.Outlined.People"
                           Style="color:var(--ft-gray-400);"
                           OnClick='() => Nav.NavigateTo("/people")' />
        </MudTooltip>

        <MudTooltip Text="Import data" Placement="Placement.Bottom">
            <MudIconButton Icon="@Icons.Material.Outlined.Upload"
                           Style="color:var(--ft-gray-400);"
                           OnClick='() => Nav.NavigateTo("/import")' />
        </MudTooltip>

        <MudTooltip Text="Stories" Placement="Placement.Bottom">
            <MudIconButton Icon="@Icons.Material.Outlined.AutoStories"
                           Style="color:var(--ft-gray-400);"
                           OnClick='() => Nav.NavigateTo("/stories")' />
        </MudTooltip>

        <MudTooltip Text="Dashboard" Placement="Placement.Bottom">
            <MudIconButton Icon="@Icons.Material.Outlined.Dashboard"
                           Style="color:var(--ft-gray-400);"
                           OnClick='() => Nav.NavigateTo("/dashboard")' />
        </MudTooltip>

        <MudTooltip Text="@(_isDark ? "Light mode" : "Dark mode")" Placement="Placement.Bottom">
            <MudIconButton Icon="@(_isDark ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)"
                           Style="color:var(--ft-gray-400);"
                           OnClick="ToggleTheme" />
        </MudTooltip>

        @if (_authChipLabel is not null)
        {
            <MudChip T="string" Size="Size.Small" Color="_authChipColor"
                     Style="margin-right:2px; cursor:default; font-size:11px; height:22px;"
                     Ripple="false">
                @_authChipLabel
            </MudChip>
        }

        @* User avatar menu *@
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true">
            <ActivatorContent>
                <div @onclick="@context.ToggleAsync" class="custom-avatar" style="cursor:pointer;">
                    <MudAvatar Size="Size.Medium" Color="Color.Primary" Style="cursor:pointer;">
                        @if (!string.IsNullOrWhiteSpace(_userPhotoUrl))
                        {
                            <img src="@_userPhotoUrl" alt="You"
                                 style="width:100%; height:100%; object-fit:cover;" />
                        }
                        else
                        {
                            @_userInitials
                        }
                    </MudAvatar>
                </div>
            </ActivatorContent>
            <ChildContent>
                <div style="padding:12px 16px 10px; border-bottom:0.5px solid var(--ft-line-border); min-width:180px;">
                    <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
                        <span style="font-size:13px; font-weight:500; color:var(--ft-text-primary);">@_userName</span>
                        @if (_authChipLabel is "Admin" or "Super-user")
                        {
                            <MudChip T="string" Size="Size.Small" Color="_authChipColor"
                                     Style="height:18px; font-size:10px; cursor:default;" Ripple="false">
                                @_authChipLabel
                            </MudChip>
                        }
                    </div>
                    <div style="font-size:11px; color:var(--ft-text-muted); margin-top:2px;">@_userEmail</div>
                </div>
                <MudMenuItem Icon="@Icons.Material.Outlined.Dashboard"   OnClick='() => Nav.NavigateTo("/dashboard")'>Dashboard</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.Settings"    OnClick='() => Nav.NavigateTo("/settings")'>Settings</MudMenuItem>
                @if (_authChipLabel is "Admin" or "Super-user")
                {
                    <MudMenuItem Icon="@Icons.Material.Outlined.AdminPanelSettings" OnClick='() => Nav.NavigateTo("/admin")'>Admin</MudMenuItem>
                }
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Outlined.Info"         OnClick='() => Nav.NavigateTo("/about")'>About</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.HelpOutline"  OnClick='() => Nav.NavigateTo("/faq")'>FAQ & security</MudMenuItem>
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Outlined.Logout" Style="color:var(--ft-gray-500);" OnClick="SignOut">Sign out</MudMenuItem>
            </ChildContent>
        </MudMenu>
    </div>

    @* ── Hamburger (mobile only) ───────────────────────────────────────────── *@
    <div class="ft-nav-mobile">
        <MudIconButton Icon="@Icons.Material.Outlined.Menu"
                       Style="color:var(--ft-gray-600);"
                       OnClick="@(() => _drawerOpen = true)" />
    </div>

</MudAppBar>

@* ── Context mini-panel (drops below AppBar when chip is tapped, mobile only) ── *@
@if (_contextExpanded && TreeContext.FocusPerson is { } panel)
{
    <div class="ft-context-panel" @onclick:stopPropagation="true">
        <div class="ft-context-panel-name">@panel.FullName</div>
        @if (panel.BirthDate.HasValue || panel.DeathDate.HasValue)
        {
            <div class="ft-context-panel-dates">
                @(panel.BirthDate?.Year.ToString() ?? "?")
                @(panel.DeathDate.HasValue ? $" – {panel.DeathDate.Value.Year}" : (panel.IsDeceased ? "" : " – present"))
                @if (!string.IsNullOrWhiteSpace(panel.BirthPlace))
                {
                    <span> · @panel.BirthPlace</span>
                }
            </div>
        }
        <div class="ft-context-panel-stats">
            <span>@TreeContext.PeopleCount people</span>
            <span class="ft-context-panel-dot">·</span>
            <span>@TreeContext.CoupleCount couples</span>
        </div>
        <button class="ft-context-panel-center" @onclick="RequestCenter" @onclick:stopPropagation="true">
            <MudIcon Icon="@Icons.Material.Outlined.CenterFocusStrong" Style="font-size:16px; margin-right:6px;" />
            Center tree
        </button>
    </div>
    <div class="ft-context-panel-backdrop" @onclick="@(() => _contextExpanded = false)"></div>
}

@* ── Mobile nav panel (custom — no MudDrawer to avoid layout side-effects) ───── *@
@if (_drawerOpen)
{
    <div class="ft-mobile-backdrop" @onclick="@(() => _drawerOpen = false)"></div>

    <div class="ft-mobile-nav">
        <div class="ft-drawer-header">
            <div>
                <div class="ft-drawer-username">@_userName</div>
                @if (_authChipLabel is not null)
                {
                    <div class="ft-drawer-role">@_authChipLabel</div>
                }
            </div>
            <button class="ft-drawer-close" @onclick="@(() => _drawerOpen = false)" aria-label="Close">✕</button>
        </div>

        <div class="ft-drawer-divider"></div>

        <nav class="ft-drawer-nav">
            <div class="ft-drawer-item" @onclick="@(() => NavTo("/people/add"))">
                <MudIcon Icon="@Icons.Material.Outlined.PersonAdd" Class="ft-drawer-icon" />
                <span>Add person</span>
            </div>
            <div class="ft-drawer-item" @onclick="@(() => NavTo("/people"))">
                <MudIcon Icon="@Icons.Material.Outlined.People" Class="ft-drawer-icon" />
                <span>People list</span>
            </div>
            <div class="ft-drawer-item" @onclick="@(() => NavTo("/import"))">
                <MudIcon Icon="@Icons.Material.Outlined.Upload" Class="ft-drawer-icon" />
                <span>Import data</span>
            </div>
            <div class="ft-drawer-item" @onclick="@(() => NavTo("/stories"))">
                <MudIcon Icon="@Icons.Material.Outlined.AutoStories" Class="ft-drawer-icon" />
                <span>Stories</span>
            </div>
            <div class="ft-drawer-item" @onclick="@(() => NavTo("/dashboard"))">
                <MudIcon Icon="@Icons.Material.Outlined.Dashboard" Class="ft-drawer-icon" />
                <span>Dashboard</span>
            </div>
            @if (_authChipLabel is "Admin" or "Super-user")
            {
                <div class="ft-drawer-item" @onclick="@(() => NavTo("/admin"))">
                    <MudIcon Icon="@Icons.Material.Outlined.AdminPanelSettings" Class="ft-drawer-icon" />
                    <span>Admin</span>
                </div>
            }
            <div class="ft-drawer-item" @onclick="@(() => NavTo("/settings"))">
                <MudIcon Icon="@Icons.Material.Outlined.Settings" Class="ft-drawer-icon" />
                <span>Settings</span>
            </div>
        </nav>

        <div class="ft-drawer-divider"></div>

        <nav class="ft-drawer-nav">
            <div class="ft-drawer-item" @onclick="ToggleTheme">
                <MudIcon Icon="@(_isDark ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)"
                         Class="ft-drawer-icon" />
                <span>@(_isDark ? "Light mode" : "Dark mode")</span>
            </div>
            <div class="ft-drawer-item ft-drawer-item--signout" @onclick="SignOut">
                <MudIcon Icon="@Icons.Material.Outlined.Logout" Class="ft-drawer-icon" />
                <span>Sign out</span>
            </div>
        </nav>
    </div>
}

@code {
    [Parameter] public bool IsDark { get; set; }
    [Parameter] public EventCallback<bool> IsDarkChanged { get; set; }
    [Parameter] public EventCallback<PersonDto> OnPersonFocused { get; set; }

    private PersonDto? _searchSelection;
    private List<PersonDto> _allPeople = [];
    private bool _isDark;
    private bool _drawerOpen;
    private bool _contextExpanded;

    private string _userName     = "";
    private string _userEmail    = "";
    private string _userInitials = "";
    private string _userPhotoUrl = "";
    private string? _authChipLabel;
    private Color   _authChipColor = Color.Default;

    protected override async Task OnInitializedAsync()
    {
        var peopleTask = PersonService.GetAllAsync();
        var authState  = await AuthStateProvider.GetAuthenticationStateAsync();
        var result     = await peopleTask;

        if (result.Success)
            _allPeople = result.Data ?? [];

        _isDark = Theme.IsDark;
        Theme.OnChange    += OnThemeChanged;
        TreeContext.OnChange += OnTreeContextChanged;

        _ = LoadUserInfoAsync(authState.User);
    }

    private void OnTreeContextChanged() => InvokeAsync(StateHasChanged);

    private Task LoadUserInfoAsync(ClaimsPrincipal principal)
    {
        if (principal.Identity?.IsAuthenticated != true) return Task.CompletedTask;

        var isDevAuth = principal.Identity.AuthenticationType == "DevAuth";

        _userName  = principal.FindFirst("DisplayName")?.Value
                  ?? principal.FindFirst(ClaimTypes.Name)?.Value
                  ?? "—";
        _userEmail = principal.FindFirst(ClaimTypes.Email)?.Value ?? "";

        if (isDevAuth)          { _authChipLabel = "Dev";        _authChipColor = Color.Info; }
        else if (principal.IsInRole("SuperUser")) { _authChipLabel = "Super-user"; _authChipColor = Color.Default; }
        else if (principal.IsInRole("Admin"))     { _authChipLabel = "Admin";      _authChipColor = Color.Default; }
        else                    { _authChipLabel = "Member";     _authChipColor = Color.Success; }

        var parts = _userName.Split(' ', 2, StringSplitOptions.RemoveEmptyEntries);
        _userInitials = parts.Length >= 2
            ? $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant()
            : _userName.Length > 0 ? _userName[0].ToString().ToUpperInvariant() : "?";

        return Task.CompletedTask;
    }

    protected override void OnParametersSet() => _isDark = IsDark;

    public async ValueTask DisposeAsync()
    {
        Theme.OnChange       -= OnThemeChanged;
        TreeContext.OnChange -= OnTreeContextChanged;
        await ValueTask.CompletedTask;
    }

    private Task<IEnumerable<PersonDto>> SearchPeople(string value, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(_allPeople.Take(6));
        return Task.FromResult(_allPeople
            .Where(p => p.FullName.Contains(value, StringComparison.OrdinalIgnoreCase))
            .Take(8));
    }

    private void OnPersonSelected(PersonDto? person)
    {
        if (person is null) return;
        Nav.NavigateTo($"/?view={person.Id}");
        _searchSelection = null;
    }

    private void ToggleContext()
    {
        _contextExpanded = !_contextExpanded;
        if (_contextExpanded) _drawerOpen = false;
    }

    private void RequestCenter()
    {
        _contextExpanded = false;
        TreeContext.RequestCenterTree();
    }

    private void NavTo(string url)
    {
        _drawerOpen = false;
        _contextExpanded = false;
        Nav.NavigateTo(url);
    }

    private async Task ToggleTheme()
    {
        await Theme.ToggleAsync();
        _isDark = Theme.IsDark;
        await IsDarkChanged.InvokeAsync(_isDark);
    }

    private void OnThemeChanged()
    {
        _isDark = Theme.IsDark;
        InvokeAsync(StateHasChanged);
    }

    private static string MiniInitials(PersonDto p) =>
        $"{p.FirstName?.FirstOrDefault()}{p.LastName?.FirstOrDefault()}"
        .ToUpperInvariant().Trim();

    private void SignOut() => Nav.NavigateTo("/auth/logout", forceLoad: true);
}
