    // ── initials ───────────────────────────────────────────────────
    private string Initials =>
        $"{_firstName.FirstOrDefault()}{_lastName.FirstOrDefault()}".ToUpperInvariant().Trim();

    // ── submit ─────────────────────────────────────────────────────
    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_firstName) || string.IsNullOrWhiteSpace(_lastName))
        {
            StateHasChanged();
            return;
        }

        _saving = true;
        try
        {
            var dto = new PersonUpsertDto
            {
                FirstName = _firstName.Trim(),
                LastName = _lastName.Trim(),
                MiddleName = string.IsNullOrWhiteSpace(_middleName) ? null : _middleName.Trim(),
                MaidenName = string.IsNullOrWhiteSpace(_maidenName) ? null : _maidenName.Trim(),
                BirthDate = _birthDate.HasValue ? DateOnly.FromDateTime(_birthDate.Value) : null,
                DeathDate = _deathDate.HasValue ? DateOnly.FromDateTime(_deathDate.Value) : null,
                BirthPlace = string.IsNullOrWhiteSpace(_birthPlace) ? null : _birthPlace.Trim(),
                DeathPlace = string.IsNullOrWhiteSpace(_deathPlace) ? null : _deathPlace.Trim(),
                BiographyNotes = _notes.Trim(),
                ProfilePhotoUrl = string.IsNullOrWhiteSpace(_photoUrl) ? null : _photoUrl.Trim(),
                Gender = _gender,
                ParentIds = [.._parentIds],
                SpouseIds = [.._spouseIds],
                FormerSpouseIds = [.._formerSpouseIds],
                SiblingIds = [.._siblingIds],
                ChildIds = [.._childIds]
            };

            await OnSubmit.InvokeAsync(dto);
        }
        finally
        {
            _saving = false;
        }
    }
}