@using FamilyTree.Core.Services
@using FamilyTree.Shared.DTOs.Medium
@using FamilyTree.Shared.DTOs.Person
@using FamilyTree.Shared.Enums
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor

@inject IMediumService MediumService

<MudStack Spacing="4" MaxWidth="680px" Style="margin:auto; font-family:var(--ft-font-body);">

    <!-- Identity Card -->
    <MudPaper Elevation="0" Class="pa-4" Style="background:var(--ft-surface-card);">
        <MudText Typo="Typo.h5" Class="mb-3">Identity</MudText>

        <MudGrid Spacing="3">
            <MudItem xs="6">
                <MudTextField @bind-Value="_firstName"
                              Label="First name"
                              Required="true"
                              RequiredError="First name is required."
                              Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="6">
                <MudTextField @bind-Value="_lastName"
                              Label="Last name"
                              Required="true"
                              RequiredError="Last name is required."
                              Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="6">
                <MudTextField @bind-Value="_middleName"
                              Label="Middle name"
                              Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="6">
                <MudTextField @bind-Value="_maidenName"
                              Label="Maiden name"
                              Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="5">
                <MudDatePicker @bind-Date="_birthDate"
                               Label="Date of birth"
                               DateFormat="dd/MM/yyyy"
                               Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="7">
                <MudTextField @bind-Value="_birthPlace"
                              Label="Place of birth"
                              Placeholder="City, State / Country"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Outlined.LocationOn"
                              Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="5">
                <MudDatePicker @bind-Date="_deathDate"
                               Label="Date of death"
                               DateFormat="dd/MM/yyyy"
                               Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="7">
                <MudTextField @bind-Value="_deathPlace"
                              Label="Place of death"
                              Placeholder="City, State / Country"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Outlined.LocationOn"
                              Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="6">
                <MudSelect @bind-Value="_gender"
                           Label="Gender"
                           Variant="Variant.Outlined">
                    <MudSelectItem Value="@((Gender?)null)">Not specified</MudSelectItem>
                    <MudSelectItem Value="@((Gender?)Gender.Male)">Male</MudSelectItem>
                    <MudSelectItem Value="@((Gender?)Gender.Female)">Female</MudSelectItem>
                    <MudSelectItem Value="@((Gender?)Gender.Other)">Other</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- Photos Card -->
    <MudPaper Elevation="0" Class="pa-4" Style="background:var(--ft-surface-card);">
        <MudText Typo="Typo.h5" Class="mb-3">Photos</MudText>

        <MudStack Spacing="3">
            <!-- Primary avatar preview -->
            <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">
                <MudAvatar Size="Size.Large"
                           Text="@Initials"
                           Src="@AvatarSrc"
                           Style="border:2px solid var(--ft-focus-border); flex-shrink:0;" />
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle2">Profile photo</MudText>
                    <MudText Typo="Typo.caption" Style="color:var(--ft-gray-400);">
                        @if (string.IsNullOrEmpty(_photoUrl) && _pendingPreviews.Count == 0)
                        {
                            <span>Star a photo below to set it as primary</span>
                        }
                        else if (!string.IsNullOrEmpty(_photoUrl))
                        {
                            <span>Primary photo set</span>
                        }
                        else
                        {
                            <span>Will be set from first photo after saving</span>
                        }
                    </MudText>
                </MudStack>
            </MudStack>

            <!-- Existing photos (edit mode) -->
            @if (_existingPhotos.Count > 0)
            {
                <MudText Typo="Typo.subtitle2" Style="color:var(--ft-gray-600); margin-bottom:-4px;">Uploaded photos</MudText>
                <div style="display:flex; flex-wrap:wrap; gap:12px;">
                    @foreach (var photo in _existingPhotos)
                    {
                        var isPrimary = photo.Url == _photoUrl;
                        var starColor = isPrimary ? "var(--ft-green-600)" : "var(--ft-gray-400)";
                        var starStyle = $"position:absolute; bottom:-8px; right:-8px; background:#fff; border-radius:50%; padding:0; min-width:0; width:22px; height:22px; color:{starColor};";
                        <div style="position:relative; width:84px; height:84px; flex-shrink:0;">
                            <img src="@photo.Url"
                                 style="width:84px; height:84px; object-fit:cover; border-radius:8px;
                                        border:@(isPrimary ? "2.5px solid var(--ft-green-600)" : "1px solid var(--ft-line-border)");"
                                 alt="@photo.FileName" />
                            <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                           Size="Size.Small"
                                           Style="position:absolute; top:-8px; right:-8px; background:#fff; border-radius:50%; padding:0; min-width:0; width:22px; height:22px; color:var(--ft-gray-500);"
                                           OnClick="@(() => DeletePhoto(photo))" />
                            <MudTooltip Text="@(isPrimary ? "Primary photo" : "Set as primary")">
                                <MudIconButton Icon="@(isPrimary ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarOutline)"
                                               Size="Size.Small"
                                               Style="@starStyle"
                                               OnClick="@(() => SetPrimary(photo.Url))" />
                            </MudTooltip>
                        </div>
                    }
                </div>
            }
            else if (EditingId.HasValue && !_photosLoaded)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Success" Style="height:2px;" />
            }

            <!-- Pending previews (add mode) -->
            @if (_pendingPreviews.Count > 0)
            {
                <MudText Typo="Typo.subtitle2" Style="color:var(--ft-gray-600); margin-bottom:-4px;">
                    Photos to upload (@_pendingPreviews.Count)
                </MudText>
                <div style="display:flex; flex-wrap:wrap; gap:12px;">
                    @for (int i = 0; i < _pendingPreviews.Count; i++)
                    {
                        var idx = i;
                        var preview = _pendingPreviews[i];
                        var isPrimary = idx == _primaryPendingIndex;
                        var starColor = isPrimary ? "var(--ft-green-600)" : "var(--ft-gray-400)";
                        var starStyle = $"position:absolute; bottom:-8px; right:-8px; background:#fff; border-radius:50%; padding:0; min-width:0; width:22px; height:22px; color:{starColor};";
                        <div style="position:relative; width:84px; height:84px; flex-shrink:0;">
                            <img src="@preview.DataUrl"
                                 style="width:84px; height:84px; object-fit:cover; border-radius:8px;
                                        border:@(isPrimary ? "2.5px solid var(--ft-green-600)" : "1px solid var(--ft-line-border)");"
                                 alt="@preview.FileName" />
                            <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                           Size="Size.Small"
                                           Style="position:absolute; top:-8px; right:-8px; background:#fff; border-radius:50%; padding:0; min-width:0; width:22px; height:22px; color:var(--ft-gray-500);"
                                           OnClick="@(() => RemovePending(idx))" />
                            <MudTooltip Text="@(isPrimary ? "Primary photo" : "Set as primary")">
                                <MudIconButton Icon="@(isPrimary ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarOutline)"
                                               Size="Size.Small"
                                               Style="@starStyle"
                                               OnClick="@(() => _primaryPendingIndex = idx)" />
                            </MudTooltip>
                        </div>
                    }
                </div>
            }

            <!-- Upload button + error -->
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <InputFile id="photo-upload"
                           accept="image/*"
                           multiple
                           style="display:none;"
                           OnChange="OnPhotoFileSelected" />
                <MudButton HtmlTag="label"
                           for="photo-upload"
                           Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Outlined.AddPhotoAlternate"
                           Disabled="_uploading"
                           Style="color:var(--ft-gray-600); font-size:13px;">
                    @(_uploading ? "Uploading…" : "Add photos")
                </MudButton>
                @if (_uploading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true"
                                         Style="color:var(--ft-green-600);" />
                }
                @if (!string.IsNullOrEmpty(_uploadError))
                {
                    <MudText Typo="Typo.caption" Style="color:var(--mud-palette-error);">@_uploadError</MudText>
                }
            </MudStack>
        </MudStack>
    </MudPaper>

    <!-- Relationships Card -->
    <MudPaper Elevation="0" Class="pa-4" Style="background:var(--ft-surface-card);">
        <MudText Typo="Typo.h5" Class="mb-3">Relationships</MudText>

        <MudStack Spacing="3">

            <!-- Parents -->
            <MudStack>
                <MudText Typo="Typo.subtitle2" Style="color:var(--ft-gray-600);">Parents</MudText>

                <MudAutocomplete @ref="_parentAc"
                                 T="PersonDto"
                                 SearchFunc="SearchParents"
                                 ValueChanged="AddParent"
                                 ToStringFunc="@(p => p?.FullName ?? "")"
                                 Label="Search by name…"
                                 Variant="Variant.Outlined"
                                 Dense="true" />

                <MudChipSet T="string">
                    @foreach (var id in _parentIds)
                    {
                        var person = AllPeople.FirstOrDefault(p => p.Id == id);
                        if (person is not null)
                        {
                            <MudChip T="string" OnClose="@(() => RemoveParent(id))"
                                     Style="background:var(--ft-green-50); color:var(--ft-green-800);">
                                @person.FullName
                                @if (person.BirthDate.HasValue)
                                {
                                    <span style="opacity:0.6; margin-left:4px;">
                                        @person.BirthDate.Value.Year
                                    </span>
                                }
                            </MudChip>
                        }
                    }
                </MudChipSet>
            </MudStack>

            <!-- Spouses -->
            <MudStack>
                <MudText Typo="Typo.subtitle2" Style="color:var(--ft-gray-600);">Spouses / partners</MudText>

                <MudAutocomplete @ref="_spouseAc"
                                 T="PersonDto"
                                 SearchFunc="SearchSpouses"
                                 ValueChanged="AddSpouse"
                                 ToStringFunc="@(p => p?.FullName ?? "")"
                                 Label="Search by name…"
                                 Variant="Variant.Outlined"
                                 Dense="true" />

                <MudChipSet T="string">
                    @foreach (var id in _spouseIds)
                    {
                        var person = AllPeople.FirstOrDefault(p => p.Id == id);
                        if (person is not null)
                        {
                            <MudChip T="string" OnClose="@(() => RemoveSpouse(id))"
                                     Style="background:var(--ft-green-50); color:var(--ft-green-800);">
                                @person.FullName
                                @if (person.BirthDate.HasValue)
                                {
                                    <span style="opacity:0.6; margin-left:4px;">
                                        @person.BirthDate.Value.Year
                                    </span>
                                }
                            </MudChip>
                        }
                    }
                </MudChipSet>
            </MudStack>

            <!-- Siblings -->
            <MudStack>
                <MudText Typo="Typo.subtitle2" Style="color:var(--ft-gray-600);">Siblings</MudText>

                <MudAutocomplete @ref="_siblingAc"
                                 T="PersonDto"
                                 SearchFunc="SearchSiblings"
                                 ValueChanged="AddSibling"
                                 ToStringFunc="@(p => p?.FullName ?? "")"
                                 Label="Search by name…"
                                 Variant="Variant.Outlined"
                                 Dense="true" />

                <MudChipSet T="string">
                    @foreach (var id in _siblingIds)
                    {
                        var person = AllPeople.FirstOrDefault(p => p.Id == id);
                        if (person is not null)
                        {
                            <MudChip T="string" OnClose="@(() => RemoveSibling(id))"
                                     Style="background:var(--ft-green-50); color:var(--ft-green-800);">
                                @person.FullName
                                @if (person.BirthDate.HasValue)
                                {
                                    <span style="opacity:0.6; margin-left:4px;">
                                        @person.BirthDate.Value.Year
                                    </span>
                                }
                            </MudChip>
                        }
                    }
                </MudChipSet>
            </MudStack>

            <!-- Children -->
            <MudStack>
                <MudText Typo="Typo.subtitle2" Style="color:var(--ft-gray-600);">Children</MudText>

                <MudAutocomplete @ref="_childAc"
                                 T="PersonDto"
                                 SearchFunc="SearchChildren"
                                 ValueChanged="AddChild"
                                 ToStringFunc="@(p => p?.FullName ?? "")"
                                 Label="Search by name…"
                                 Variant="Variant.Outlined"
                                 Dense="true" />

                <MudChipSet T="string">
                    @foreach (var id in _childIds)
                    {
                        var person = AllPeople.FirstOrDefault(p => p.Id == id);
                        if (person is not null)
                        {
                            <MudChip T="string" OnClose="@(() => RemoveChild(id))"
                                     Style="background:var(--ft-green-50); color:var(--ft-green-800);">
                                @person.FullName
                                @if (person.BirthDate.HasValue)
                                {
                                    <span style="opacity:0.6; margin-left:4px;">
                                        @person.BirthDate.Value.Year
                                    </span>
                                }
                            </MudChip>
                        }
                    }
                </MudChipSet>
            </MudStack>

        </MudStack>
    </MudPaper>

    <!-- Notes Card -->
    <MudPaper Elevation="0" Class="pa-4" Style="background:var(--ft-surface-card);">
        <MudText Typo="Typo.h5" Class="mb-3">Notes</MudText>

        <MudTextField @bind-Value="_notes"
                      Label="Biography, stories, context…"
                      Lines="4"
                      AutoGrow="true"
                      Variant="Variant.Outlined" />
    </MudPaper>

    <!-- Actions -->
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center"
              Style="border-top:0.5px solid var(--ft-line-border); padding-top:8px;">
        <MudButton Variant="Variant.Text"
                   Style="color:var(--ft-gray-500);"
                   OnClick="() => OnCancel.InvokeAsync()">
            Cancel
        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Style="background:var(--ft-green-600); color:#fff; min-width:140px;"
                   OnClick="Submit">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            @SubmitLabel
        </MudButton>
    </MudStack>

</MudStack>

@code {
    [Parameter] public PersonUpsertDto? Initial { get; set; }
    [Parameter] public Guid? EditingId { get; set; }
    [Parameter] public List<PersonDto> AllPeople { get; set; } = [];
    [Parameter] public string SubmitLabel { get; set; } = "Save";
    [Parameter] public EventCallback<PersonUpsertDto> OnSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    // ── person fields ──────────────────────────────────────────────
    private bool _saving;
    private string _firstName = "";
    private string _lastName = "";
    private string _middleName = "";
    private string _maidenName = "";
    private string _notes = "";
    private string _photoUrl = "";
    private string _birthPlace = "";
    private string _deathPlace = "";
    private DateTime? _birthDate;
    private DateTime? _deathDate;
    private Gender? _gender;
    private HashSet<Guid> _parentIds = [];
    private HashSet<Guid> _spouseIds = [];
    private HashSet<Guid> _siblingIds = [];
    private HashSet<Guid> _childIds = [];

    // autocomplete refs — needed to reset after each selection
    private MudAutocomplete<PersonDto>? _parentAc;
    private MudAutocomplete<PersonDto>? _spouseAc;
    private MudAutocomplete<PersonDto>? _siblingAc;
    private MudAutocomplete<PersonDto>? _childAc;

    // ── photo state ────────────────────────────────────────────────
    private record PendingPhoto(string FileName, string MimeType, byte[] Data, string DataUrl);

    private List<MediumDto> _existingPhotos = [];
    private List<PendingPhoto> _pendingPreviews = [];
    private int _primaryPendingIndex = 0;
    private bool _uploading = false;
    private bool _photosLoaded = false;
    private string _uploadError = "";

    public bool HasPendingPhotos => _pendingPreviews.Count > 0;

    // ── lifecycle ──────────────────────────────────────────────────
    protected override void OnParametersSet()
    {
        if (Initial is null) return;

        _firstName = Initial.FirstName ?? "";
        _lastName = Initial.LastName ?? "";
        _middleName = Initial.MiddleName ?? "";
        _maidenName = Initial.MaidenName ?? "";
        _notes = Initial.BiographyNotes ?? "";
        _photoUrl = Initial.ProfilePhotoUrl ?? "";
        _birthDate = Initial.BirthDate?.ToDateTime(TimeOnly.MinValue);
        _deathDate = Initial.DeathDate?.ToDateTime(TimeOnly.MinValue);
        _birthPlace = Initial.BirthPlace ?? "";
        _deathPlace = Initial.DeathPlace ?? "";
        _gender = Initial.Gender;
        _parentIds = [..Initial.ParentIds];
        _spouseIds = [..Initial.SpouseIds];
        _siblingIds = [..Initial.SiblingIds];
        _childIds = [..Initial.ChildIds];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && EditingId.HasValue && !_photosLoaded)
        {
            _photosLoaded = true;
            var result = await MediumService.GetByPersonIdAsync(EditingId.Value);
            if (result.Success)
                _existingPhotos = result.Data!.Where(m => m.Type == "photo").ToList();
            StateHasChanged();
        }
    }

    // ── avatar ─────────────────────────────────────────────────────
    private string? AvatarSrc
    {
        get
        {
            if (EditingId.HasValue)
                return string.IsNullOrEmpty(_photoUrl) ? null : _photoUrl;
            return _pendingPreviews.Count > 0 ? _pendingPreviews[_primaryPendingIndex].DataUrl : null;
        }
    }

    // ── photo handlers ─────────────────────────────────────────────
    private async Task OnPhotoFileSelected(InputFileChangeEventArgs e)
    {
        _uploadError = "";
        _uploading = true;
        StateHasChanged();

        const long maxSize = 50L * 1024 * 1024;

        try
        {
            foreach (var file in e.GetMultipleFiles(10))
            {
                if (EditingId.HasValue)
                {
                    await using var stream = file.OpenReadStream(maxSize);
                    var dto = new MediumUpsertDto
                    {
                        PersonId = EditingId.Value,
                        FileName = file.Name,
                        MimeType = file.ContentType,
                        Type = "photo"
                    };
                    var result = await MediumService.CreateAsync(dto, stream);
                    if (result.Success)
                    {
                        _existingPhotos.Insert(0, result.Data!);
                        if (string.IsNullOrEmpty(_photoUrl))
                            _photoUrl = result.Data!.Url;
                    }
                    else
                    {
                        _uploadError = result.Message;
                    }
                }
                else
                {
                    using var ms = new MemoryStream();
                    await file.OpenReadStream(maxSize).CopyToAsync(ms);
                    var bytes = ms.ToArray();
                    var dataUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(bytes)}";
                    _pendingPreviews.Add(new PendingPhoto(file.Name, file.ContentType, bytes, dataUrl));
                }
            }
        }
        catch (Exception ex)
        {
            _uploadError = $"Upload failed: {ex.Message}";
        }
        finally
        {
            _uploading = false;
            StateHasChanged();
        }
    }

    private async Task DeletePhoto(MediumDto photo)
    {
        var result = await MediumService.DeleteAsync(photo.Id);
        if (result.Success)
        {
            _existingPhotos.Remove(photo);
            if (_photoUrl == photo.Url)
                _photoUrl = _existingPhotos.FirstOrDefault()?.Url ?? "";
        }
        else
        {
            _uploadError = result.Message;
        }
    }

    private void SetPrimary(string url) => _photoUrl = url;

    private void RemovePending(int idx)
    {
        _pendingPreviews.RemoveAt(idx);
        if (_primaryPendingIndex >= _pendingPreviews.Count)
            _primaryPendingIndex = Math.Max(0, _pendingPreviews.Count - 1);
    }

    // Called by PersonAdd after person creation to upload queued photos.
    // Returns the URL of the primary photo, or null if none.
    public async Task<string?> UploadPendingAsync(Guid personId)
    {
        string? primaryUrl = null;
        for (int i = 0; i < _pendingPreviews.Count; i++)
        {
            var p = _pendingPreviews[i];
            var dto = new MediumUpsertDto
            {
                PersonId = personId,
                FileName = p.FileName,
                MimeType = p.MimeType,
                Type = "photo"
            };
            using var stream = new MemoryStream(p.Data);
            var result = await MediumService.CreateAsync(dto, stream);
            if (result.Success && (i == _primaryPendingIndex || primaryUrl is null))
                primaryUrl = result.Data!.Url;
        }
        return primaryUrl;
    }

    // ── relationship search ────────────────────────────────────────
    private Task<IEnumerable<PersonDto>> SearchParents(string value, CancellationToken _) =>
        Task.FromResult(AllPeople
            .Where(p => p.Id != EditingId && !_parentIds.Contains(p.Id))
            .Where(p => string.IsNullOrWhiteSpace(value) ||
                        p.FullName.Contains(value, StringComparison.OrdinalIgnoreCase))
            .Take(8));

    private async Task AddParent(PersonDto? person)
    {
        if (person is null) return;
        _parentIds.Add(person.Id);
        if (_parentAc is not null) await _parentAc.ResetAsync();
    }

    private void RemoveParent(Guid id) => _parentIds.Remove(id);

    private Task<IEnumerable<PersonDto>> SearchSpouses(string value, CancellationToken _) =>
        Task.FromResult(AllPeople
            .Where(p => p.Id != EditingId && !_spouseIds.Contains(p.Id))
            .Where(p => string.IsNullOrWhiteSpace(value) ||
                        p.FullName.Contains(value, StringComparison.OrdinalIgnoreCase))
            .Take(8));

    private async Task AddSpouse(PersonDto? person)
    {
        if (person is null) return;
        _spouseIds.Add(person.Id);
        if (_spouseAc is not null) await _spouseAc.ResetAsync();
    }

    private void RemoveSpouse(Guid id) => _spouseIds.Remove(id);

    private Task<IEnumerable<PersonDto>> SearchSiblings(string value, CancellationToken _) =>
        Task.FromResult(AllPeople
            .Where(p => p.Id != EditingId && !_siblingIds.Contains(p.Id))
            .Where(p => string.IsNullOrWhiteSpace(value) ||
                        p.FullName.Contains(value, StringComparison.OrdinalIgnoreCase))
            .Take(8));

    private async Task AddSibling(PersonDto? person)
    {
        if (person is null) return;
        _siblingIds.Add(person.Id);
        if (_siblingAc is not null) await _siblingAc.ResetAsync();
    }

    private void RemoveSibling(Guid id) => _siblingIds.Remove(id);

    private Task<IEnumerable<PersonDto>> SearchChildren(string value, CancellationToken _) =>
        Task.FromResult(AllPeople
            .Where(p => p.Id != EditingId && !_childIds.Contains(p.Id))
            .Where(p => string.IsNullOrWhiteSpace(value) ||
                        p.FullName.Contains(value, StringComparison.OrdinalIgnoreCase))
            .Take(8));

    private async Task AddChild(PersonDto? person)
    {
        if (person is null) return;
        _childIds.Add(person.Id);
        if (_childAc is not null) await _childAc.ResetAsync();
    }

    private void RemoveChild(Guid id) => _childIds.Remove(id);

    // ── initials ───────────────────────────────────────────────────
    private string Initials =>
        $"{_firstName.FirstOrDefault()}{_lastName.FirstOrDefault()}".ToUpperInvariant().Trim();

    // ── submit ─────────────────────────────────────────────────────
    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_firstName) || string.IsNullOrWhiteSpace(_lastName))
        {
            StateHasChanged();
            return;
        }

        _saving = true;
        try
        {
            var dto = new PersonUpsertDto
            {
                FirstName = _firstName.Trim(),
                LastName = _lastName.Trim(),
                MiddleName = string.IsNullOrWhiteSpace(_middleName) ? null : _middleName.Trim(),
                MaidenName = string.IsNullOrWhiteSpace(_maidenName) ? null : _maidenName.Trim(),
                BirthDate = _birthDate.HasValue ? DateOnly.FromDateTime(_birthDate.Value) : null,
                DeathDate = _deathDate.HasValue ? DateOnly.FromDateTime(_deathDate.Value) : null,
                BirthPlace = string.IsNullOrWhiteSpace(_birthPlace) ? null : _birthPlace.Trim(),
                DeathPlace = string.IsNullOrWhiteSpace(_deathPlace) ? null : _deathPlace.Trim(),
                BiographyNotes = _notes.Trim(),
                ProfilePhotoUrl = string.IsNullOrWhiteSpace(_photoUrl) ? null : _photoUrl.Trim(),
                Gender = _gender,
                ParentIds = [.._parentIds],
                SpouseIds = [.._spouseIds],
                SiblingIds = [.._siblingIds],
                ChildIds = [.._childIds]
            };

            await OnSubmit.InvokeAsync(dto);
        }
        finally
        {
            _saving = false;
        }
    }
}
