    private Task<IEnumerable<PersonDto>> SearchParents(string value, CancellationToken _) =>
        Task.FromResult(AllPeople
            .Where(p => p.Id != EditingId && !_parentIds.Contains(p.Id))
            .Where(p => string.IsNullOrWhiteSpace(value) ||
                        p.FullName.Contains(value, StringComparison.OrdinalIgnoreCase))
            .Take(8));

    private async Task AddParent(PersonDto? person)
    {
        if (person is null) return;
        _parentIds.Add(person.Id);
        if (_parentAc is not null) await _parentAc.ResetAsync();
    }

    private void RemoveParent(Guid id) => _parentIds.Remove(id);

