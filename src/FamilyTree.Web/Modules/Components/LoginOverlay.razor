@inject NavigationManager Nav

<div class="intro-overlay">
    <div class="intro-glass auth-card">

        @* ── Branding ──────────────────────────────────────────────────────── *@
        <div style="display:flex; justify-content:center; margin-bottom:12px; user-select:none;">
            <img src="/images/arborkin-logo__transparent.png" alt="ArborKin"
                 style="width:80%; max-width:320px; height:auto;" />
        </div>
        <div class="intro-subtitle" style="margin-bottom:20px;">
            Discover and share your family story
        </div>

        @* ── Google ────────────────────────────────────────────────────────── *@
        <button class="auth-google-btn" @onclick="SignInWithGoogle">
            <svg viewBox="0 0 24 24" width="18" height="18" style="flex-shrink:0;">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
            </svg>
            Sign in with Google
        </button>

        <div class="auth-or-divider"><span>or</span></div>

        @* ── Server-side auth errors ────────────────────────────────────────── *@
        @if (ErrorMessage == "invalid")
        {
            <div class="auth-error">Incorrect email or password.</div>
        }
        else if (ErrorMessage == "missing")
        {
            <div class="auth-error">Please enter your email and password.</div>
        }
        else if (ErrorMessage == "locked")
        {
            <div class="auth-error">Account locked after too many failed attempts. Try again in 15 minutes.</div>
        }
        else if (ErrorMessage == "toomany")
        {
            <div class="auth-error">Too many sign-in attempts from this device. Try again in 15 minutes.</div>
        }
        else if (ErrorMessage == "noinvite")
        {
            <div class="auth-error">Registration is by invitation only. Contact the administrator for an invite link.</div>
        }
        else if (ErrorMessage == "closed")
        {
            <div class="auth-error">Registration is currently closed.</div>
        }
        else if (ErrorMessage == "google_error")
        {
            <div class="auth-error">Could not sign in with Google. Please try again.</div>
        }
        else if (ErrorMessage == "google_unavailable")
        {
            <div class="auth-error">Google sign-in is not configured yet. Use email and password.</div>
        }

        @* ── Email / password form — native POST, no JavaScript ────────────── *@
        @* Hidden inputs carry the Blazor-bound values into the POST body.
           Immediate="true" keeps them in sync on every keystroke. *@
        <form method="post" action="/auth/do-login">
            <input type="hidden" name="email"    value="@_email" />
            <input type="hidden" name="password" value="@_password" />

            <div class="ft-field-label">Email</div>
            <MudTextField @bind-Value="_email"
                          Placeholder="your@email.com"
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Class="mb-3" />

            <div class="ft-field-label">Password</div>
            <MudTextField @bind-Value="_password"
                          Placeholder="••••••••••"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Margin="Margin.Dense"
                          Immediate="true" />

            <div class="auth-forgot">
                <a href="/forgot-password">Forgot password?</a>
            </div>

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled" Color="Color.Primary"
                       FullWidth="true" Class="mt-2">
                Sign in
            </MudButton>
        </form>

        @* ── Register link ─────────────────────────────────────────────────── *@
        <div class="auth-register-link">
            New here? <a href="/register">Create an account</a>
        </div>

        @* ── Browse public ─────────────────────────────────────────────────── *@
        <div class="auth-browse">
            <button @onclick="BrowsePublic">Browse public trees without signing in →</button>
        </div>

    </div>
</div>

@code {
    [Parameter] public EventCallback OnGuest { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }

    private string _email    = "";
    private string _password = "";

    private void SignInWithGoogle() =>
        Nav.NavigateTo("/auth/google", forceLoad: true);

    private async Task BrowsePublic() => await OnGuest.InvokeAsync();
}
