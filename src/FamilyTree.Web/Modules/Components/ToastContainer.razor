@using FamilyTree.Web.Services
@implements IDisposable

@inject ToastService ToastSvc

<div class="ft-toast-container" role="status" aria-live="polite" aria-label="Notifications">
    @foreach (var at in _active)
    {
        <div @key="at.Message.Id"
             class="ft-toast ft-toast--@at.TypeClass @(at.IsLeaving ? "ft-toast--out" : "")"
             @onmouseenter="() => Pause(at)"
             @onmouseleave="() => Resume(at)">

            <span class="ft-toast-icon" aria-hidden="true">
                @if (at.Message.Type == ToastType.Success)
                {
                    <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="10" cy="10" r="8.25" stroke="currentColor" stroke-width="1.5"/>
                        <path d="m6.5 10 2.5 2.5 4.5-4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                }
                else if (at.Message.Type == ToastType.Error)
                {
                    <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="10" cy="10" r="8.25" stroke="currentColor" stroke-width="1.5"/>
                        <path d="m7 7 6 6M13 7l-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                }
                else if (at.Message.Type == ToastType.Warning)
                {
                    <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M8.57 3 1.9 15a1.67 1.67 0 0 0 1.43 2.5h13.34A1.67 1.67 0 0 0 18.1 15L11.43 3a1.67 1.67 0 0 0-2.86 0Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                        <path d="M10 8v3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        <circle cx="10" cy="14.25" r=".75" fill="currentColor"/>
                    </svg>
                }
                else
                {
                    <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="10" cy="10" r="8.25" stroke="currentColor" stroke-width="1.5"/>
                        <path d="M10 9v5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        <circle cx="10" cy="6.5" r=".75" fill="currentColor"/>
                    </svg>
                }
            </span>

            <div class="ft-toast-body">
                @if (at.Message.Title is not null)
                {
                    <div class="ft-toast-title">@at.Message.Title</div>
                }
                <div class="ft-toast-msg @(at.Message.Title is null ? "ft-toast-msg--solo" : "")">
                    @at.Message.Message
                </div>
            </div>

            <button class="ft-toast-x" @onclick="() => ManualDismiss(at)" aria-label="Dismiss">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                    <path d="M1 1l10 10M11 1L1 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
            </button>

            <div class="ft-toast-bar"
                 style="animation-duration:@(at.Message.Duration)ms;
                        animation-play-state:@(at.Paused ? "paused" : "running");">
            </div>
        </div>
    }
</div>

@code {
    private sealed class ActiveToast
    {
        public required ToastMessage Message { get; init; }
        public bool IsLeaving  { get; set; }
        public bool Paused     { get; set; }
        public DateTime StartedAt    { get; set; } = DateTime.UtcNow;
        public int RemainingMs { get; set; }
        public CancellationTokenSource Cts { get; set; } = new();

        public string TypeClass => Message.Type.ToString().ToLower();
    }

    private readonly List<ActiveToast> _active = [];

    protected override void OnInitialized()
    {
        ToastSvc.OnChanged += HandleChanged;
    }

    private void HandleChanged()
    {
        InvokeAsync(() =>
        {
            var activeIds = _active.Select(a => a.Message.Id).ToHashSet();

            foreach (var msg in ToastSvc.Toasts)
            {
                if (activeIds.Contains(msg.Id)) continue;
                if (_active.Count >= 4) break;

                var at = new ActiveToast { Message = msg, RemainingMs = msg.Duration };
                _active.Add(at);
                StartTimer(at);
            }

            StateHasChanged();
        });
    }

    private void StartTimer(ActiveToast at)
    {
        at.Cts = new CancellationTokenSource();
        var token = at.Cts.Token;
        at.StartedAt = DateTime.UtcNow;

        Task.Delay(at.RemainingMs, token).ContinueWith(
            t => { if (!t.IsCanceled) InvokeAsync(() => BeginLeave(at)); },
            TaskContinuationOptions.ExecuteSynchronously);
    }

    private async Task BeginLeave(ActiveToast at)
    {
        if (at.IsLeaving) return;
        at.IsLeaving = true;
        StateHasChanged();
        await Task.Delay(280);
        _active.Remove(at);
        ToastSvc.Remove(at.Message.Id);
        StateHasChanged();
    }

    private void Pause(ActiveToast at)
    {
        if (at.IsLeaving) return;
        at.Cts.Cancel();
        var elapsed = (int)(DateTime.UtcNow - at.StartedAt).TotalMilliseconds;
        at.RemainingMs = Math.Max(at.RemainingMs - elapsed, 300);
        at.Paused = true;
    }

    private void Resume(ActiveToast at)
    {
        if (at.IsLeaving) return;
        at.Paused = false;
        StartTimer(at);
    }

    private void ManualDismiss(ActiveToast at)
    {
        at.Cts.Cancel();
        _ = BeginLeave(at);
    }

    public void Dispose()
    {
        ToastSvc.OnChanged -= HandleChanged;
        foreach (var at in _active) at.Cts.Cancel();
    }
}
