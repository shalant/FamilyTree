@* ═══════════════════════════════════════════════════════════════════════════
   Mobile control panel — replaces the hero overlay + floating toolbar on
   mobile with one combined panel: focus-person info plus zoom/center/reset.
   Reachable via the AppBar identity tap (CustomAppBar) or the canvas mini-
   trigger (CustomToolbar's collapsed pill on mobile); both just flip
   TreeContext.MobilePanelOpen rather than each owning their own state.
   ═══════════════════════════════════════════════════════════════════════════ *@

@using FamilyTree.Web.Services
@inject TreeContextService TreeContext
@inject ThemeService Theme
@implements IDisposable

@if (_shown)
{
    <div class="@("ft-mobile-panel" + (_closing ? " ft-mobile-panel--closing" : ""))" @onclick:stopPropagation="true">
        @if (TreeContext.FocusPerson is { } panel)
        {
            <div class="ft-mobile-panel-name">@panel.FullName</div>
            @if (panel.BirthDate.HasValue || panel.DeathDate.HasValue)
            {
                <div class="ft-mobile-panel-dates">
                    @(panel.BirthDate?.Year.ToString() ?? "?")
                    @(panel.DeathDate.HasValue ? $" – {panel.DeathDate.Value.Year}" : (panel.IsDeceased ? "" : " – present"))
                    @if (!string.IsNullOrWhiteSpace(panel.BirthPlace))
                    {
                        <span> · @panel.BirthPlace</span>
                    }
                </div>
            }
            <div class="ft-mobile-panel-stats">
                <span>@TreeContext.PeopleCount people</span>
                <span class="ft-mobile-panel-dot">·</span>
                <span>@TreeContext.CoupleCount couples</span>
            </div>
        }

        <div class="ft-mobile-panel-actions">
            <button class="ft-mobile-panel-btn" @onclick="OnZoomOut" @onclick:stopPropagation="true">
                <MudIcon Icon="@Icons.Material.Filled.ZoomOut" Style="font-size:18px;" />
                Zoom out
            </button>
            <button class="ft-mobile-panel-btn" @onclick="OnZoomIn" @onclick:stopPropagation="true">
                <MudIcon Icon="@Icons.Material.Filled.ZoomIn" Style="font-size:18px;" />
                Zoom in
            </button>
            <button class="ft-mobile-panel-btn" @onclick="OnCenter" @onclick:stopPropagation="true">
                <MudIcon Icon="@Icons.Material.Outlined.CenterFocusStrong" Style="font-size:18px;" />
                Center
            </button>
            <button class="ft-mobile-panel-btn" @onclick="OnReset" @onclick:stopPropagation="true">
                <MudIcon Icon="@Icons.Material.Outlined.RestartAlt" Style="font-size:18px;" />
                Reset
            </button>
        </div>

        <button class="ft-mobile-panel-btn ft-mobile-panel-btn--wide" @onclick="ToggleTheme" @onclick:stopPropagation="true">
            <MudIcon Icon="@(_isDark ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)" Style="font-size:18px;" />
            @(_isDark ? "Light mode" : "Dark mode")
        </button>
    </div>
    <div class="@("ft-mobile-panel-backdrop" + (_closing ? " ft-mobile-panel-backdrop--closing" : ""))"
         @onclick="@(() => TreeContext.CloseMobilePanel())"></div>
}

@code {
    // Matches the ft-nav-close animation in app.css (and CustomAppBar's drawer).
    public const int CloseAnimationMs = 250;

    private bool _isDark;
    // Mounted, and mounted only to play the close animation. Closing used to just
    // unmount the panel the instant MobilePanelOpen went false, so it vanished with no
    // animation while opening dropped in (found on a real phone, 2026-10-12).
    private bool _shown;
    private bool _closing;
    private int _closeVersion;
    private bool _disposed;

    protected override void OnInitialized()
    {
        _isDark = Theme.IsDark;
        _shown = TreeContext.MobilePanelOpen;
        TreeContext.OnChange += HandleContextChanged;
        Theme.OnChange += HandleThemeChanged;
    }

    private void HandleContextChanged() => InvokeAsync(SyncWithContextAsync);

    private async Task SyncWithContextAsync()
    {
        if (TreeContext.MobilePanelOpen)
        {
            _closeVersion++; // reopened mid-close: cancel the pending unmount
            _shown = true;
            _closing = false;
            StateHasChanged();
            return;
        }
        if (!_shown || _closing)
        {
            StateHasChanged();
            return;
        }

        _closing = true;
        var version = ++_closeVersion;
        StateHasChanged();
        await Task.Delay(CloseAnimationMs);
        if (_disposed || version != _closeVersion) return;
        _shown = false;
        _closing = false;
        StateHasChanged();
    }

    private void HandleThemeChanged()
    {
        _isDark = Theme.IsDark;
        InvokeAsync(StateHasChanged);
    }

    private async Task ToggleTheme() => await Theme.ToggleAsync();

    // Zoom in/out keep the panel open (a user may tap either several times in
    // a row); Center/Reset are one-shot actions, so close afterward like the
    // panel's previous Center-tree-only incarnation did.
    private void OnZoomIn() => TreeContext.RequestZoomIn();
    private void OnZoomOut() => TreeContext.RequestZoomOut();

    private void OnCenter()
    {
        TreeContext.CloseMobilePanel();
        TreeContext.RequestCenterTree();
    }

    private void OnReset()
    {
        TreeContext.CloseMobilePanel();
        TreeContext.RequestResetView();
    }

    public void Dispose()
    {
        _disposed = true;
        TreeContext.OnChange -= HandleContextChanged;
        Theme.OnChange -= HandleThemeChanged;
    }
}
