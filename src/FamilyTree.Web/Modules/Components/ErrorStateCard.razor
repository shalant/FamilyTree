@* Shared "something's wrong" card — glass panel matching the auth pages'
   .intro-glass look, reused by the /Error page and the NotFound/NotAuthorized
   router fallbacks so every failure state in the app shares one visual language. *@

@using MudBlazor

<div class="intro-glass ft-error-card">
    @if (ShowLogo)
    {
        <div class="ft-error-card-logo">
            <img src="/images/arborkin-logo__transparent.png" alt="ArborKin" />
        </div>
    }

    <MudIcon Icon="@Icon" Class="ft-error-card-icon" />

    <div class="ft-error-card-title">@Title</div>
    <div class="ft-error-card-message">@Message</div>

    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Href="@ActionHref" Class="mt-3">
            @ActionLabel
        </MudButton>
    }
</div>

@code {
    [Parameter] public string Icon { get; set; } = Icons.Material.Outlined.ErrorOutline;
    [Parameter] public string Title { get; set; } = "Something went wrong";
    [Parameter] public string Message { get; set; } = "";
    [Parameter] public string ActionLabel { get; set; } = "Go home";
    [Parameter] public string ActionHref { get; set; } = "/";
    [Parameter] public bool ShowLogo { get; set; } = true;
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
