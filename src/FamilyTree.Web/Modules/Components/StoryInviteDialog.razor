@using FamilyTree.Core.Services
@using FamilyTree.Shared.DTOs.Person
@using FamilyTree.Shared.DTOs.StoryInvite
@using FamilyTree.Web.Services
@using Microsoft.JSInterop
@using MudBlazor

@inject IStoryInviteService StoryInviteService
@inject NavigationManager Nav
@inject ToastService Toast
@inject IJSRuntime JS

<MudDialog>
    <DialogContent>
        <div style="font-size:13px; color:var(--ft-gray-400); margin-bottom:16px;">
            We'll email them a link — no account required to write back.
        </div>

        @if (PersonId.HasValue && !_choosingOther)
        {
            <div class="ft-field-label">Who is the story about?</div>
            <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Dense="true" Class="mb-1">
                @PersonName
            </MudAlert>
            <button style="font-size:12px; color:var(--ft-green-600); border:none;
                background:transparent; cursor:pointer; padding:0 0 12px;
                font-family:var(--ft-font-body);"
                    @onclick="@(() => _choosingOther = true)">
                Not them? Invite about someone else
            </button>
        }
        else
        {
            <div class="ft-field-label">Who is the story about?</div>

            <MudAutocomplete @ref="_personAc"
                              T="PersonDto"
                              SearchFunc="SearchPeople"
                              ValueChanged="SelectPerson"
                              ToStringFunc="@(p => p?.FullName ?? "")"
                              Placeholder="Search by name…"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Dense="true"
                              Class="mb-1">
                <ItemTemplate Context="p">
                    @if (p.Id == Guid.Empty)
                    {
                        <div style="display:flex; align-items:center; gap:6px; color:var(--ft-green-600);">
                            <MudIcon Icon="@Icons.Material.Outlined.PersonAddAlt" Style="font-size:16px;" />
                            <span>Add someone new…</span>
                        </div>
                    }
                    else
                    {
                        @p.FullName
                    }
                </ItemTemplate>
            </MudAutocomplete>

            @if (_selectedPerson is null)
            {
                <div style="font-size:12px; color:var(--ft-gray-400); line-height:1.5; margin-bottom:12px;">
                    They need to be on the tree first — search above, or pick
                    "Add someone new…" to add them, then come back and search for them here.
                </div>
            }
            else
            {
                <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                    @_selectedPerson.FullName
                </MudAlert>
            }

            @if (PersonId.HasValue)
            {
                <button style="font-size:12px; color:var(--ft-green-600); border:none;
                    background:transparent; cursor:pointer; padding:0 0 12px;
                    font-family:var(--ft-font-body);"
                        @onclick="@(() => { _choosingOther = false; _selectedPerson = null; })">
                    Back to @PersonName
                </button>
            }
        }

        <div class="ft-field-label" style="margin-top:8px;">Their email address</div>
        <MudTextField @bind-Value="_email"
                      Placeholder="them@example.com"
                      InputType="InputType.Email"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Class="mb-3" />

        <div class="ft-field-label">Personal note <span style="opacity:0.6;">(optional)</span></div>
        <MudTextField @bind-Value="_note"
                      Placeholder="A line or two about why you're asking..."
                      Variant="Variant.Outlined"
                      Lines="3"
                      MaxLength="1000" />

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3" Dense="true">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Cancel</MudButton>
        <MudButton OnClick="Send"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="_sending">
            Send invite
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public Guid? PersonId { get; set; }
    [Parameter] public string? PersonName { get; set; }
    [Parameter] public List<PersonDto> AllPeople { get; set; } = [];

    private static readonly PersonDto _addNewPersonOption = new() { Id = Guid.Empty };

    private MudAutocomplete<PersonDto>? _personAc;
    private PersonDto? _selectedPerson;
    private string _lastSearchText = "";
    private string _email = "";
    private string _note = "";
    private string? _error;
    private bool _sending;
    private bool _choosingOther;

    private Task<IEnumerable<PersonDto>> SearchPeople(string value, CancellationToken _)
    {
        _lastSearchText = value;
        var matches = AllPeople
            .Where(p => string.IsNullOrWhiteSpace(value) ||
                        p.FullName.Contains(value, StringComparison.OrdinalIgnoreCase))
            .Take(8);
        return Task.FromResult<IEnumerable<PersonDto>>([_addNewPersonOption, .. matches]);
    }

    private async Task SelectPerson(PersonDto? person)
    {
        if (person is null) return;

        if (person.Id == Guid.Empty)
        {
            var url = $"/people/add?name={Uri.EscapeDataString(_lastSearchText)}";
            await JS.InvokeVoidAsync("open", url, "_blank");
            return;
        }

        _selectedPerson = person;
    }

    private async Task Send()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_email))
        {
            _error = "An email address is required.";
            StateHasChanged();
            return;
        }

        if (!IsValidEmailFormat(_email))
        {
            _error = "That doesn't look like a valid email address.";
            StateHasChanged();
            return;
        }

        var usingPresetPerson = PersonId.HasValue && !_choosingOther;
        var personId = usingPresetPerson ? PersonId : _selectedPerson?.Id;

        if (personId is null)
        {
            _error = "Please select who this story is about — if they're not listed, add them to the tree first via \"Add someone new…\".";
            Toast.Error("Add this person to the tree first, then search for them here.");
            StateHasChanged();
            return;
        }

        var dto = new StoryInviteCreateDto
        {
            PersonId = personId.Value,
            InvitedEmail = _email.Trim(),
            PersonalNote = string.IsNullOrWhiteSpace(_note) ? null : _note.Trim(),
        };

        _sending = true;
        StateHasChanged();
        var result = await StoryInviteService.CreateInviteAsync(dto, Nav.BaseUri);
        _sending = false;

        if (!result.Success)
        {
            _error = result.Message;
            StateHasChanged();
            return;
        }

        Toast.Success("Invite sent!");
        MudDialog.Close();
    }

    private void Cancel() => MudDialog.Cancel();

    private static bool IsValidEmailFormat(string email)
    {
        try
        {
            var addr = new System.Net.Mail.MailAddress(email.Trim());
            return addr.Host.Contains('.');
        }
        catch (FormatException)
        {
            return false;
        }
    }
}