@using FamilyTree.Shared.DTOs.Import
@using FamilyTree.Web.Services
@using FamilyTree.Web.Modules.Components

@inject NavigationManager Nav
@inject ToastService Toast
@inject IImportService ImportService
@inject IDialogService DialogService

@* ── Format tabs ──────────────────────────────────────────────────────────── *@
<div style="display:flex; border-bottom:1px solid var(--ft-line-border);
    margin-bottom:28px; gap:2px; overflow-x:auto;">
    @foreach (var tab in _tabs)
    {
        <button @onclick="@(() => _activeTab = tab.Key)"
                style="padding:9px 18px; border:none; background:transparent; cursor:pointer;
            font-size:13px; font-family:var(--ft-font-body); white-space:nowrap;
            color:@(_activeTab == tab.Key ? "var(--ft-green-700)" : "var(--ft-gray-400)");
            border-bottom:@(_activeTab == tab.Key ? "2px solid var(--ft-green-600)" : "2px solid transparent");
            margin-bottom:-1px; font-weight:@(_activeTab == tab.Key ? "600" : "400");">
            @tab.Value.Icon  @tab.Value.Label
        </button>
    }
</div>

@* ── GEDCOM tab ────────────────────────────────────────────────────────────── *@
@if (_activeTab == "gedcom")
{
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:24px; align-items:start;">
        <div>
            <div style="font-size:15px; font-weight:600; color:var(--ft-gray-700); margin-bottom:8px;">
                Upload a GEDCOM file
            </div>
            <div style="font-size:13px; color:var(--ft-gray-400); line-height:1.7; margin-bottom:20px;">
                GEDCOM (.ged) is the universal genealogy exchange format. Export from Ancestry,
                MyHeritage, FamilySearch, or any genealogy software and upload here.
            </div>
            <MediaUploadZone Accept=".ged,.gedcom"
                             Label="Drop your .ged file here"
                             Hint="or click to browse"
                             OnFilesSelected="OnGedcomSelected" />
            @if (_gedcomFile != null)
            {
                <MudAlert Severity="Severity.Info" Class="mt-3">
                    <strong>@_gedcomFile.Name</strong> selected (@FormatSize(_gedcomFile.Size))
                </MudAlert>
            }
        </div>
        <MudPaper Elevation="0" Class="pa-4" Style="background:var(--ft-green-50); border-radius:var(--ft-radius-card);">
            <div style="font-size:12px; font-weight:600; text-transform:uppercase;
                letter-spacing:0.07em; color:var(--ft-green-700); margin-bottom:10px;">
                What gets imported
            </div>
            @foreach (var item in new[]{ "All people with names, dates, and places",
                "Parent–child relationships", "Spouse/partner pairings",
                "Sibling relationships", "Biographical notes", "Profile photos (if embedded)" })
            {
                <div style="display:flex; gap:8px; margin-bottom:6px; font-size:13px; color:var(--ft-gray-600);">
                    <MudIcon Icon="@Icons.Material.Outlined.CheckCircleOutline"
                             Style="font-size:15px; color:var(--ft-green-600); flex-shrink:0; margin-top:1px;" />
                    @item
                </div>
            }
        </MudPaper>
    </div>
}

@* ── PDF / Document tab ────────────────────────────────────────────────────── *@
@if (_activeTab == "smart" && _flowState == DocImportState.Idle)
{
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:24px; align-items:start;">
        <div>
            <div style="display:flex; align-items:center; gap:8px; margin-bottom:8px;">
                <div style="font-size:15px; font-weight:600; color:var(--ft-gray-700);">
                    Upload a PDF or document
                </div>
                <div style="background:var(--ft-focus-fill); color:#fff; font-size:10px;
                    font-weight:600; padding:2px 7px; border-radius:10px; letter-spacing:0.04em;">
                    AI-powered
                </div>
            </div>
            <div style="font-size:13px; color:var(--ft-gray-400); line-height:1.7; margin-bottom:20px;">
                Upload a PDF or plain-text document containing family information.
                Our AI reads it and extracts names, dates, places, and relationships — even
                from handwritten-style or informal formats. (Word docs aren't supported yet —
                paste the text instead.)
            </div>
            @if (!ImportService.IsConfigured)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                    AI import requires an Anthropic API key. Set <code>AI__AnthropicApiKey</code> in App Service config or user secrets (<code>dotnet user-secrets set "AI:AnthropicApiKey" "sk-ant-..."</code>).
                </MudAlert>
            }
            <MediaUploadZone Accept=".pdf,.doc,.docx,.txt"
                             Label="Drop a file here"
                             Hint=".pdf or .txt — or paste text below"
                             OnFilesSelected="OnDocumentSelected" />

            <div style="display:flex; align-items:center; gap:10px; margin:14px 0 10px;">
                <div style="flex:1; height:1px; background:var(--ft-line-border);"></div>
                <span style="font-size:11px; color:var(--ft-gray-300); text-transform:uppercase; letter-spacing:0.06em;">or paste text</span>
                <div style="flex:1; height:1px; background:var(--ft-line-border);"></div>
            </div>

            <MudTextField @bind-Value="_pasteText"
                          Placeholder="Paste genealogy text, family history, letters…"
                          Lines="6"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Style="font-size:13px; font-family:monospace;" />
            <div style="font-size:11px; color:var(--ft-gray-300); margin-top:4px;">
                @_pasteText.Length / 50,000 characters
            </div>
            @if (_documentName != null)
            {
                <MudAlert Severity="Severity.Info" Class="mt-3">
                    <strong>@_documentName</strong>@(_documentPageCount > 0 ? $" · {_documentPageCount} page{(_documentPageCount == 1 ? "" : "s")}" : "") ready for extraction
                </MudAlert>
                @if (_documentPageCount > 1)
                {
                    <div style="display:flex; align-items:center; gap:10px; margin-top:12px; flex-wrap:wrap;">
                        <span style="font-size:13px; color:var(--ft-gray-500);">Extract pages</span>
                        <MudNumericField @bind-Value="_startPage" Min="1" Max="_documentPageCount"
                                         Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:88px;" />
                        <span style="font-size:13px; color:var(--ft-gray-500);">to</span>
                        <MudNumericField @bind-Value="_endPage" Min="1" Max="_documentPageCount"
                                         Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:88px;" />
                        <span style="font-size:12px; color:var(--ft-gray-300);">
                            of @_documentPageCount — leave the full range to import the whole document.
                            Smaller ranges are faster and cheaper.
                        </span>
                    </div>
                }
            }
            @if (!string.IsNullOrWhiteSpace(_extractError))
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">@_extractError</MudAlert>
            }
        </div>
        <div>
            <MudPaper Elevation="0" Class="pa-4" Style="background:var(--ft-focus-ring); border-radius:var(--ft-radius-card); margin-bottom:12px;">
                <div style="font-size:12px; font-weight:600; text-transform:uppercase;
                    letter-spacing:0.07em; color:var(--ft-focus-fill); margin-bottom:8px;">
                    How it works
                </div>
                @foreach (var (step, desc) in new (string,string)[]{
                    ("1. Upload", "Your document is sent to our AI extraction pipeline"),
                    ("2. Review", "We show you every person and relationship found"),
                    ("3. Confirm", "Check, edit, or exclude entries before committing"),
                    ("4. Import", "Accepted records are added to your tree")
                })
                {
                    <div style="display:flex; gap:10px; margin-bottom:8px;">
                        <div style="font-size:11px; font-weight:700; color:var(--ft-focus-fill);
                            min-width:16px; padding-top:1px;">@step.Split('.')[0]</div>
                        <div style="font-size:12px; color:var(--ft-gray-600); line-height:1.5;">
                            <strong>@step.Split('.')[1].Trim()</strong> — @desc
                        </div>
                    </div>
                }
            </MudPaper>
            <MudAlert Severity="Severity.Info" Dense="true">
                Nothing is saved until you review and confirm the extracted people on the next screen.
            </MudAlert>
        </div>
    </div>
}

@* ── Excel / CSV tab ──────────────────────────────────────────────────────── *@
@if (_activeTab == "excel")
{
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:24px; align-items:start;">
        <div>
            <div style="font-size:15px; font-weight:600; color:var(--ft-gray-700); margin-bottom:8px;">
                Upload a spreadsheet
            </div>
            <div style="font-size:13px; color:var(--ft-gray-400); line-height:1.7; margin-bottom:20px;">
                Upload an Excel (.xlsx) or CSV file. Use our template for the fastest import,
                or map your own columns in the next step.
            </div>
            <MediaUploadZone Accept=".xlsx,.xls,.csv"
                             Label="Drop your spreadsheet here"
                             Hint=".xlsx, .xls, .csv supported"
                             OnFilesSelected="OnSpreadsheetSelected" />
            @if (_spreadsheetFile != null)
            {
                <MudAlert Severity="Severity.Info" Class="mt-3">
                    <strong>@_spreadsheetFile.Name</strong> ready to map
                </MudAlert>
            }
            <div style="margin-top:16px;">
                <button style="font-size:13px; color:var(--ft-green-600); background:transparent;
                    border:none; cursor:pointer; padding:0; text-decoration:underline;
                    font-family:var(--ft-font-body);">
                    Download template (.xlsx)
                </button>
            </div>
        </div>
        <MudPaper Elevation="0" Class="pa-4" Style="background:var(--ft-green-50); border-radius:var(--ft-radius-card);">
            <div style="font-size:12px; font-weight:600; text-transform:uppercase;
                letter-spacing:0.07em; color:var(--ft-green-700); margin-bottom:10px;">
                Template columns
            </div>
            @foreach (var col in new[]{ "FirstName *", "LastName *", "MiddleName",
                "MaidenName", "BirthDate (MM/DD/YYYY)", "BirthPlace",
                "DeathDate (MM/DD/YYYY)", "DeathPlace", "Gender",
                "ParentFullName1", "ParentFullName2", "SpouseFullName", "Notes" })
            {
                <div style="font-size:12px; color:var(--ft-gray-600); padding:2px 0;
                    font-family:monospace;">
                    @col
                </div>
            }
        </MudPaper>
    </div>
}

@* ── Paste text tab ────────────────────────────────────────────────────────── *@
@if (_activeTab == "smart" && _flowState == DocImportState.Idle && _documentBytes == null)
{
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:24px; align-items:start;">
            <div>
                <div style="display:flex; align-items:center; gap:8px; margin-bottom:8px;">
                    <div style="font-size:15px; font-weight:600; color:var(--ft-gray-700);">
                        Paste free text
                    </div>
                    <div style="background:var(--ft-focus-fill); color:#fff; font-size:10px;
                        font-weight:600; padding:2px 7px; border-radius:10px; letter-spacing:0.04em;">
                        AI-powered
                    </div>
                </div>
                <div style="font-size:13px; color:var(--ft-gray-400); line-height:1.7; margin-bottom:16px;">
                    Paste any text containing family information — a family history document,
                    old letters, a Wikipedia article, anything. Claude AI will extract people and relationships.
                </div>
                @if (!ImportService.IsConfigured)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                        AI import requires an Anthropic API key. Set <code>AI__AnthropicApiKey</code> in App Service config or user secrets (<code>dotnet user-secrets set "AI:AnthropicApiKey" "sk-ant-..."</code>).
                    </MudAlert>
                }
                <div class="ft-field-label">Paste your text here</div>
                <MudTextField @bind-Value="_pasteText"
                              Placeholder="Paste genealogy data, family history text, or any structured content…"
                              Lines="12"
                              Variant="Variant.Outlined"
                              FullWidth="true"
                              Style="font-size:13px; font-family:monospace;" />
                <div style="font-size:11px; color:var(--ft-gray-300); margin-top:6px;">
                    @_pasteText.Length / 50,000 characters
                </div>
                @if (!string.IsNullOrWhiteSpace(_extractError))
                {
                    <MudAlert Severity="Severity.Error" Class="mt-3">@_extractError</MudAlert>
                }
            </div>
            <MudPaper Elevation="0" Class="pa-4" Style="background:var(--ft-focus-ring); border-radius:var(--ft-radius-card);">
                <div style="font-size:12px; font-weight:600; text-transform:uppercase;
                    letter-spacing:0.07em; color:var(--ft-focus-fill); margin-bottom:10px;">
                    Works great with
                </div>
                @foreach (var ex in new[]{ "Family history essays or memoirs",
                    "Old letters or diaries (transcribed)",
                    "Email threads about family history",
                    "Wikipedia / newspaper articles",
                    "Ancestry message board posts",
                    "Handwritten notes (typed out)" })
                {
                    <div style="display:flex; gap:8px; margin-bottom:7px; font-size:13px; color:var(--ft-gray-600);">
                        <MudIcon Icon="@Icons.Material.Outlined.TextSnippet"
                                 Style="font-size:14px; color:var(--ft-focus-fill); flex-shrink:0; margin-top:2px;" />
                        @ex
                    </div>
                }
            </MudPaper>
        </div>
}

@* ── Shared extract/preview/import workflow (text + pdf tabs) ───────────────── *@
@if (_activeTab == "smart" && _flowState != DocImportState.Idle)
{
    @if (_flowState == DocImportState.Extracting)
    {
        <div style="padding:48px 0 60px;">
            <MudProgressLinear Indeterminate="true" Color="Color.Primary"
                               Style="border-radius:4px; margin-bottom:20px;" />
            <div style="text-align:center; font-size:14px; color:var(--ft-gray-600); font-weight:500;">
                @_importProgress.Stage
            </div>
            @if (_importProgress.PeopleFoundSoFar > 0)
            {
                <div style="text-align:center; margin-top:10px; font-size:22px; font-weight:700;
                    color:var(--ft-green-700);">
                    @_importProgress.PeopleFoundSoFar
                    <span style="font-size:14px; font-weight:400; color:var(--ft-gray-400);">
                        people found so far…
                    </span>
                </div>
            }
            <div style="text-align:center; margin-top:10px; font-size:11px; color:var(--ft-gray-300);">
                Large documents can take a couple of minutes — please keep this tab open.
            </div>
        </div>
    }
    else if (_flowState == DocImportState.Preview && _preview != null)
    {
        <div style="margin-bottom:12px; display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
            <div style="font-size:15px; font-weight:600; color:var(--ft-gray-700);">
                @_preview.People.Count(p => p.Selected) of @_preview.People.Count people selected
            </div>
            <div style="font-size:12px; color:var(--ft-gray-400);">
                · @_preview.Relationships.Count relationships detected
            </div>
            @{ var linkCount = _preview.People.Count(p => p.MatchedExistingId != null); }
            @if (linkCount > 0)
            {
                <div style="font-size:12px; font-weight:600; color:var(--ft-green-700);">
                    · @linkCount linking to existing
                </div>
            }
            <MudButton Variant="Variant.Text" Size="Size.Small"
                       Style="color:var(--ft-green-600); margin-left:auto;"
                       OnClick="@(() => _preview.People.ForEach(p => p.Selected = true))">
                Select all
            </MudButton>
            <MudButton Variant="Variant.Text" Size="Size.Small"
                       Style="color:var(--ft-gray-400);"
                       OnClick="@(() => _preview.People.ForEach(p => p.Selected = !p.ReferenceOnly))">
                Skip reference-only
            </MudButton>
        </div>

        @if (!string.IsNullOrWhiteSpace(_extractError))
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@_extractError</MudAlert>
        }

        <div style="max-height:480px; overflow-y:auto; border:1px solid var(--ft-line-border);
            border-radius:8px; background:var(--ft-surface-card);">
            @foreach (var person in _preview.People)
            {
                <div style="display:flex; align-items:flex-start; gap:10px; padding:10px 14px;
                    border-bottom:.5px solid var(--ft-line-border);
                    opacity:@(person.Selected ? "1" : "0.45");">
                    <MudCheckBox @bind-Value="person.Selected"
                                 Size="Size.Small"
                                 Style="margin-top:1px; flex-shrink:0;" />
                    <div style="flex:1; min-width:0;">
                        <div style="display:flex; align-items:center; gap:6px; flex-wrap:wrap;">
                            <span style="font-size:13px; font-weight:600; color:var(--ft-gray-700);">
                                @person.FirstName @person.MiddleName @person.LastName
                            </span>
                            @if (!string.IsNullOrEmpty(person.MaidenName))
                            {
                                <span style="font-size:11px; color:var(--ft-gray-400);">(née @person.MaidenName)</span>
                            }
                            @if (person.ReferenceOnly)
                            {
                                <span style="font-size:10px; background:var(--ft-gray-100);
                                    color:var(--ft-gray-500); padding:1px 6px; border-radius:8px;">
                                    reference only
                                </span>
                            }
                            @if (person.IsDeceased)
                            {
                                <span style="font-size:11px; color:var(--ft-gray-300);">†</span>
                            }
                        </div>
                        <div style="font-size:11px; color:var(--ft-gray-400); margin-top:2px;">
                            @LifeSpan(person)
                            @if (person.Aliases?.Length > 0)
                            {
                                <span> · also @string.Join(", ", person.Aliases)</span>
                            }
                        </div>
                        @if (person.Candidates?.Count > 0)
                        {
                            var linked = person.MatchedExistingId is { } mid
                                ? person.Candidates.FirstOrDefault(c => c.PersonId == mid)
                                : null;
                            <div style="display:flex; align-items:center; gap:8px; margin-top:5px; flex-wrap:wrap;">
                                @if (linked != null)
                                {
                                    <span style="font-size:11px; font-weight:600; color:var(--ft-green-700);">
                                        ✓ Linking to @linked.DisplayName@(linked.BirthYear is int ly ? $" ({ly})" : "")@(person.MergeFieldNames is { Count: > 0 } mf ? $" · merging {mf.Count} field{(mf.Count == 1 ? "" : "s")}" : "")
                                    </span>
                                    <MudButton Variant="Variant.Text" Size="Size.Small"
                                               Style="color:var(--ft-green-700);"
                                               OnClick="@(() => OpenReconcileAsync(person))">
                                        Edit…
                                    </MudButton>
                                    <MudButton Variant="Variant.Text" Size="Size.Small" Style="color:var(--ft-gray-400);"
                                               OnClick="@(() => { person.MatchedExistingId = null; person.MergeFieldNames = null; })">
                                        Create new instead
                                    </MudButton>
                                }
                                else
                                {
                                    var top = person.Candidates[0];
                                    <span style="font-size:11px; font-weight:500; color:var(--ft-green-700);">
                                        ↔ Possible match: @top.DisplayName@(top.BirthYear is int ty ? $" ({ty})" : "")
                                    </span>
                                    <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                               Style="color:var(--ft-green-700); border-color:var(--ft-green-700);"
                                               OnClick="@(() => OpenReconcileAsync(person))">
                                        Review &amp; link…
                                    </MudButton>
                                    @if (person.Candidates.Count > 1)
                                    {
                                        <span style="font-size:10px; color:var(--ft-gray-300);">+@(person.Candidates.Count - 1) other possible</span>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else if (_flowState == DocImportState.Importing)
    {
        <div style="text-align:center; padding:60px 0;">
            <MudProgressCircular Indeterminate="true" Color="Color.Success" Size="Size.Large" />
            <div style="margin-top:20px; font-size:14px; color:var(--ft-gray-500);">
                Importing people into your tree…
            </div>
        </div>
    }
    else if (_flowState == DocImportState.Done && _importResult != null)
    {
        <div style="text-align:center; padding:48px 0;">
            <MudIcon Icon="@Icons.Material.Outlined.CheckCircleOutline"
                     Style="font-size:48px; color:var(--ft-green-600); display:block; margin:0 auto 16px;" />
            <div style="font-size:18px; font-weight:600; color:var(--ft-gray-700); margin-bottom:8px;">
                Import complete!
            </div>
            <div style="font-size:14px; color:var(--ft-gray-400);">
                @_importResult.PeopleCreated people added · @_importResult.RelationshipsCreated relationships created@(_importResult.LinkedToExisting > 0 ? $" · {_importResult.LinkedToExisting} linked to existing" : "")
            </div>
        </div>
    }
}

@* ── Action bar ────────────────────────────────────────────────────────────── *@
<div style="margin-top:32px; padding-top:20px; border-top:0.5px solid var(--ft-line-border);
    display:flex; justify-content:space-between; align-items:center;">

    @if (_activeTab == "smart" && _flowState == DocImportState.Preview)
    {
        <MudButton Variant="Variant.Text" Style="color:var(--ft-gray-400);"
                   OnClick="@(() => _flowState = DocImportState.Idle)">
            ← Back
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Disabled="@(_preview == null || !_preview.People.Any(p => p.Selected))"
                   Style="background:var(--ft-green-600); color:#fff; min-width:180px;"
                   StartIcon="@Icons.Material.Outlined.Download"
                   OnClick="CommitImportAsync">
            Import @(_preview?.People.Count(p => p.Selected) ?? 0) people
        </MudButton>
    }
    else if (_activeTab == "smart" && _flowState == DocImportState.Done)
    {
        <span />
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick='() => Nav.NavigateTo("/")'>
            Go to tree
        </MudButton>
    }
    else if (_activeTab == "smart" && _flowState is DocImportState.Extracting or DocImportState.Importing)
    {
        <span />
        <span />
    }
    else
    {
        @if (!string.IsNullOrEmpty(BackUrl))
        {
            <MudButton Variant="Variant.Text" Style="color:var(--ft-gray-400);"
                       OnClick="@(() => Nav.NavigateTo(BackUrl))">
                Cancel
            </MudButton>
        }
        else
        {
            <span />
        }
        <MudButton Variant="Variant.Filled"
                   Disabled="@(!CanProceed)"
                   Style="background:var(--ft-green-600); color:#fff; min-width:160px;"
                   StartIcon="@Icons.Material.Outlined.Visibility"
                   OnClick="ProceedAsync">
            @(_activeTab == "smart" ? "Extract people" : "Preview import")
        </MudButton>
    }
</div>

@code {
    [Parameter] public string? BackUrl { get; set; }

    private enum DocImportState { Idle, Extracting, Preview, Importing, Done }

    private string _activeTab = "gedcom";
    private string _pasteText = "";

    private IBrowserFile? _gedcomFile;
    private IBrowserFile? _spreadsheetFile;

    // Document bytes are read once at upload time and cached. The IBrowserFile
    // reference goes stale after the first OpenReadStream / a re-render, so we
    // never read it lazily at extract time — that broke retries with a
    // "_blazorFilesById" null error.
    private byte[]? _documentBytes;
    private string? _documentName;
    private int     _documentPageCount;   // 0 for non-PDF / unknown
    private int     _startPage = 1;
    private int     _endPage   = 1;

    private DocImportState _flowState     = DocImportState.Idle;
    private ImportPreview?  _preview;
    private ImportResult?   _importResult;
    private string?         _extractError;

    private const long MaxDocumentBytes = 20 * 1024 * 1024;

    private readonly Dictionary<string, (string Label, string Icon)> _tabs = new()
    {
        ["gedcom"] = ("GEDCOM",       "📋"),
        ["smart"]  = ("Import",       "✨"),
        ["excel"]  = ("Excel / CSV",  "📊"),
    };

    private bool CanProceed => _activeTab switch
    {
        "gedcom" => _gedcomFile != null,
        "smart"  => (_documentBytes != null || _pasteText.Trim().Length > 20) && ImportService.IsConfigured,
        "excel"  => _spreadsheetFile != null,
        _        => false
    };

    // Live progress during Claude extraction
    private ImportProgress _importProgress = new("Analyzing document with Claude AI…");

    private void OnGedcomSelected(IReadOnlyList<IBrowserFile> files)      => _gedcomFile      = files.FirstOrDefault();
    private void OnSpreadsheetSelected(IReadOnlyList<IBrowserFile> files) => _spreadsheetFile = files.FirstOrDefault();

    private async Task OnDocumentSelected(IReadOnlyList<IBrowserFile> files)
    {
        _extractError      = null;
        _documentBytes     = null;
        _documentName      = null;
        _documentPageCount = 0;
        _pasteText         = "";   // file takes precedence; clear paste text

        var file = files.FirstOrDefault();
        if (file == null) return;

        if (file.Size > MaxDocumentBytes)
        {
            _extractError = $"File is too large ({FormatSize(file.Size)}). Maximum is 20 MB.";
            return;
        }

        try
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(MaxDocumentBytes).CopyToAsync(ms);
            _documentBytes = ms.ToArray();
            _documentName  = file.Name;
        }
        catch (Exception ex)
        {
            _extractError = $"Couldn't read the file: {ex.Message}";
            return;
        }

        // For PDFs, read the page count up front so we can offer page-range selection.
        if (Path.GetExtension(_documentName).ToLowerInvariant() == ".pdf")
        {
            try
            {
                _documentPageCount = ImportService.GetPdfPageCount(_documentBytes);
                _startPage = 1;
                _endPage   = _documentPageCount;
            }
            catch (Exception ex)
            {
                _extractError  = $"Couldn't read the PDF: {ex.Message}";
                _documentBytes = null;
                _documentName  = null;
            }
        }
    }

    private async Task ProceedAsync()
    {
        if (_activeTab != "smart")
        {
            Toast.Info("File received — non-text import pipeline coming soon.");
            return;
        }

        _extractError    = null;
        _importProgress  = new ImportProgress("Starting…");
        _flowState       = DocImportState.Extracting;
        StateHasChanged();

        // Progress callback: fires on the streaming thread; must re-render on Blazor's
        // sync context via InvokeAsync.
        var progress = new Progress<ImportProgress>(p =>
        {
            _importProgress = p;
            _ = InvokeAsync(StateHasChanged);
        });

        try
        {
            _preview = _documentBytes != null
                ? await ExtractFromUploadedDocumentAsync(progress)
                : await ImportService.ExtractFromTextAsync(_pasteText, progress);
            _importProgress = new ImportProgress("Finding matches in your tree…");
            StateHasChanged();
            _preview = await ImportService.AnnotateMatchesAsync(_preview);
            _flowState = DocImportState.Preview;
        }
        catch (Exception ex)
        {
            _extractError = ex.Message;
            _flowState    = DocImportState.Idle;
        }
    }

    private async Task OpenReconcileAsync(ImportPersonDto person)
    {
        // Reconcile against the best candidate (the one shown in the badge).
        var top = person.MatchedExistingId is { } mid
            ? person.Candidates?.FirstOrDefault(c => c.PersonId == mid)
            : person.Candidates?.FirstOrDefault();
        if (top == null) return;

        var parameters = new DialogParameters
        {
            ["Imported"]      = person,
            ["CandidateId"]   = top.PersonId,
            ["CandidateName"] = top.DisplayName,
        };
        var dialog = await DialogService.ShowAsync<ReconcileDialog>("Reconcile", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        if (result.Data is ReconcileDialog.ReconcileResult rr)
        {
            person.MatchedExistingId = rr.CreateNew ? null : rr.LinkToId;
            person.MergeFieldNames   = rr.CreateNew ? null : rr.MergeFields;
            StateHasChanged();
        }
    }

    private async Task<ImportPreview> ExtractFromUploadedDocumentAsync(IProgress<ImportProgress>? progress = null)
    {
        if (_documentBytes == null || _documentName == null)
            throw new InvalidOperationException("No document selected.");

        int? start = null, end = null;
        if (_documentPageCount > 1)
        {
            start = Math.Min(_startPage, _endPage);
            end   = Math.Max(_startPage, _endPage);
        }

        return await ImportService.ExtractFromDocumentAsync(_documentBytes, _documentName, start, end, progress);
    }

    private async Task CommitImportAsync()
    {
        if (_preview == null) return;

        _flowState = DocImportState.Importing;
        StateHasChanged();

        try
        {
            _importResult = await ImportService.CommitAsync(_preview);
            _flowState    = DocImportState.Done;
        }
        catch (Exception ex)
        {
            _extractError = ex.Message;
            _flowState    = DocImportState.Preview;
        }
    }

    private static string LifeSpan(ImportPersonDto p)
    {
        var birth = p.BirthDate?[..4];
        var death = p.DeathDate?[..4];
        if (birth == null && death == null) return "";
        if (birth != null && death != null) return $"{birth}–{death}";
        if (birth != null) return $"b. {birth}";
        return $"d. {death}";
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024           => $"{bytes} B",
        < 1024 * 1024    => $"{bytes / 1024} KB",
        _                => $"{bytes / (1024 * 1024):F1} MB"
    };
}
