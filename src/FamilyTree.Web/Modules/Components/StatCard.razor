@namespace FamilyTree.Web.Modules.Components

<div class="stat-card" style="padding:16px; border-radius:8px; background:var(--ft-surface-card);">
    <div style="font-size:12px; color:var(--ft-gray-400);">@Label</div>
    <div style="font-size:22px; font-weight:600; color:var(--ft-green-800);">@Value</div>
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
}