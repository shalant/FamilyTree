@using FamilyTree.Shared.DTOs.Person

@if (Visible)
{
    <div id="ft-hero" class="hero-overlay" style="@_posStyle">
        <div class="hero-glass @(Expanded ? "expanded" : "")">

            <div class="hero-drag-handle" data-drag-handle title="Drag to move">
                <svg width="20" height="8" viewBox="0 0 20 8" fill="currentColor"
                     style="color:var(--ft-gray-300); display:block;">
                    <circle cx="4"  cy="2" r="1.5"/><circle cx="10" cy="2" r="1.5"/><circle cx="16" cy="2" r="1.5"/>
                    <circle cx="4"  cy="6" r="1.5"/><circle cx="10" cy="6" r="1.5"/><circle cx="16" cy="6" r="1.5"/>
                </svg>
            </div>

            <div class="hero-header">
                <div class="hero-title">@FocusPerson?.FirstName's Family Tree</div>

                @if (FocusPerson?.BirthDate is not null)
                {
                    <div class="hero-subtitle">
                        Born @FocusPerson.BirthDate.Value.Year
                    </div>
                }
            </div>

            <div class="hero-actions">
                <MudButton Variant="Variant.Outlined"
                Color="Color.Primary"
                StartIcon="@Icons.Material.Filled.Edit"
                Href="@($"/people/{FocusPerson?.Id}/edit")">
                    Edit Profile
                </MudButton>

                <MudButton Variant="Variant.Text" OnClick="ToggleExpand">
                    @(Expanded ? "Collapse" : "Expand")
                </MudButton>
            </div>

            @if (Expanded)
            {
                <div class="hero-expanded">
                    <div class="hero-stat">Members: @PeopleCount</div>
                    <div class="hero-stat">Relationships: @CoupleCount</div>

                    <div class="hero-quote">
                        “Roots and branches, bound by love.”
                    </div>

                    <div class="hero-expanded-actions">
                        <MudButton Variant="Variant.Text"
                        StartIcon="@Icons.Material.Filled.CenterFocusStrong"
                        OnClick="OnCenterTree">
                            Center Tree
                        </MudButton>

                        <MudButton Variant="Variant.Text"
                        StartIcon="@Icons.Material.Filled.Share"
                        OnClick="OnShare">
                            Share View
                        </MudButton>
                        <MudButton Variant="Variant.Text"
                                   StartIcon="@Icons.Material.Filled.List"
                                   Href="/people">
                            People List
                        </MudButton>

                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public PersonDto? FocusPerson { get; set; }
    [Parameter] public int PeopleCount { get; set; }
    [Parameter] public int CoupleCount { get; set; }
    [Parameter] public EventCallback OnCenterTree { get; set; }
    [Parameter] public EventCallback OnShare { get; set; }
    [Parameter] public bool Visible { get; set; }
    [Parameter] public double? DragLeft { get; set; }
    [Parameter] public double? DragTop  { get; set; }

    private string _posStyle => (DragLeft.HasValue && DragTop.HasValue)
        ? $"left:{(int)DragLeft}px; top:{(int)DragTop}px; right:auto; bottom:auto;"
        : "";

    private bool Expanded { get; set; }

    private void ToggleExpand() => Expanded = !Expanded;
}