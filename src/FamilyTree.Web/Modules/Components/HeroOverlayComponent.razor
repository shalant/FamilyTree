@using FamilyTree.Shared.DTOs.Person

@if (Visible)
{
    <div id="ft-hero" class="hero-overlay" style="@_posStyle">
        <div class="hero-glass @SizeClass">

            @if (_size == HeroSize.Mini)
            {
                <div class="hero-mini-bar">
                    <span data-drag-handle class="hero-mini-name" style="cursor:grab; user-select:none;">
                        @FocusPerson?.FirstName's Tree
                    </span>
                    <MudIconButton Icon="@Icons.Material.Outlined.ExpandMore"
                                   Size="Size.Small"
                                   title="Expand"
                                   Style="color:var(--ft-green-600); padding:2px; margin:-6px -4px -6px 0;"
                                   OnClick="() => SetSize(HeroSize.Normal)" />
                </div>
            }
            else
            {
                <div class="hero-drag-handle" data-drag-handle title="Drag to move">
                    <svg width="20" height="8" viewBox="0 0 20 8" fill="currentColor"
                         style="color:var(--ft-gray-300); display:block;">
                        <circle cx="4"  cy="2" r="1.5"/><circle cx="10" cy="2" r="1.5"/><circle cx="16" cy="2" r="1.5"/>
                        <circle cx="4"  cy="6" r="1.5"/><circle cx="10" cy="6" r="1.5"/><circle cx="16" cy="6" r="1.5"/>
                    </svg>
                </div>

                <div class="hero-header">
                    <div class="hero-title">@FocusPerson?.FirstName's Family Tree</div>

                    @if (FocusPerson?.BirthDate is not null)
                    {
                        <div class="hero-subtitle">
                            Born @FocusPerson.BirthDate.Value.Year
                        </div>
                    }
                </div>

                <div class="hero-actions">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.MailOutline"
                               OnClick="OnInviteStory">
                        Invite
                    </MudButton>

                    <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                   Size="Size.Small"
                                   title="Edit profile"
                                   Style="color:var(--ft-text-muted); padding:2px;"
                                   Href="@($"/people/{FocusPerson?.Id}/edit")" />

                    <MudIconButton Icon="@(_size == HeroSize.Normal ? Icons.Material.Outlined.ExpandMore : Icons.Material.Outlined.ExpandLess)"
                                   Size="Size.Small"
                                   title="@(_size == HeroSize.Normal ? "Expand" : "Collapse")"
                                   Style="color:var(--ft-text-muted); padding:2px;"
                                   OnClick="ToggleExpand" />

                    <MudIconButton Icon="@Icons.Material.Outlined.Remove"
                                   Size="Size.Small"
                                   title="Minimize"
                                   Style="color:var(--ft-text-muted); padding:2px; margin:-6px -6px -6px -2px;"
                                   OnClick="() => SetSize(HeroSize.Mini)" />
                </div>

                @if (_size == HeroSize.Expanded)
                {
                    <div class="hero-expanded">
                        <div class="hero-stat">Members: @PeopleCount</div>
                        <div class="hero-stat">Relationships: @CoupleCount</div>

                        <div class="hero-quote">
                            "Roots and branches, bound by love."
                        </div>

                        <div class="hero-expanded-actions">
                            <MudButton Variant="Variant.Text"
                                       StartIcon="@Icons.Material.Filled.Edit"
                                       Href="@($"/people/{FocusPerson?.Id}/edit")">
                                Edit Profile
                            </MudButton>

                            <MudButton Variant="Variant.Text"
                                       StartIcon="@Icons.Material.Filled.CenterFocusStrong"
                                       OnClick="OnCenterTree">
                                Center Tree
                            </MudButton>

                            <MudButton Variant="Variant.Text"
                                       StartIcon="@Icons.Material.Filled.Share"
                                       OnClick="OnShare">
                                Share View
                            </MudButton>

                            <MudButton Variant="Variant.Text"
                                       StartIcon="@Icons.Material.Filled.List"
                                       Href="/people">
                                People List
                            </MudButton>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
}

@code {
    [Parameter] public PersonDto? FocusPerson { get; set; }
    [Parameter] public int PeopleCount { get; set; }
    [Parameter] public int CoupleCount { get; set; }
    [Parameter] public EventCallback OnCenterTree { get; set; }
    [Parameter] public EventCallback OnShare { get; set; }
    [Parameter] public EventCallback OnInviteStory { get; set; }
    [Parameter] public bool Visible { get; set; }
    [Parameter] public double? DragLeft { get; set; }
    [Parameter] public double? DragTop  { get; set; }
    [Parameter] public EventCallback OnPositionReset { get; set; }

    private string _posStyle => (DragLeft.HasValue && DragTop.HasValue)
        ? $"left:{(int)DragLeft}px; top:{(int)DragTop}px; right:auto; bottom:auto;"
        : "";

    private enum HeroSize { Mini, Normal, Expanded }
    private HeroSize _size = HeroSize.Normal;

    private string SizeClass => _size switch {
        HeroSize.Mini     => "mini",
        HeroSize.Expanded => "expanded",
        _                 => ""
    };

    private async Task SetSize(HeroSize newSize)
    {
        _size = newSize;
        await OnPositionReset.InvokeAsync();
    }

    private void ToggleExpand() =>
        _size = _size == HeroSize.Normal ? HeroSize.Expanded : HeroSize.Normal;
}
