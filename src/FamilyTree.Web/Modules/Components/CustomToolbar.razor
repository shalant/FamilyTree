@inject NavigationManager Nav

<MudPaper Elevation="2"
          Class="pa-2"
          Style="display: flex;
    align-items: center;
    gap: 4px;
    background: rgba(245,245,245,0.3) !important;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.135);
    border-radius: 12px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.12);">

    @* Drag grip — grab this to reposition the toolbar *@
    <div class="ft-toolbar-grip" data-drag-handle title="Drag to reposition">
        <svg width="8" height="14" viewBox="0 0 8 14" fill="currentColor"
             style="color:var(--ft-gray-400);">
            <circle cx="2" cy="2"  r="1.3"/><circle cx="6" cy="2"  r="1.3"/>
            <circle cx="2" cy="7"  r="1.3"/><circle cx="6" cy="7"  r="1.3"/>
            <circle cx="2" cy="12" r="1.3"/><circle cx="6" cy="12" r="1.3"/>
        </svg>
    </div>

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.PersonAdd"
               Size="Size.Small"
               OnClick="@(() => Nav.NavigateTo("/people/add"))">
        Add Person
    </MudButton>

    <MudDivider Vertical="true" FlexItem="true" Style="height:28px; margin:0 4px;" />

    <MudTooltip Text="Zoom out">
        <MudIconButton Icon="@Icons.Material.Filled.ZoomOut"
                       Size="Size.Small"
                       OnClick="OnZoomOut" />
    </MudTooltip>

    <MudTooltip Text="Zoom in">
        <MudIconButton Icon="@Icons.Material.Filled.ZoomIn"
                       Size="Size.Small"
                       OnClick="OnZoomIn" />
    </MudTooltip>

    <MudTooltip Text="Center on focus person">
        <MudIconButton Icon="@Icons.Material.Filled.CenterFocusStrong"
                       Size="Size.Small"
                       OnClick="OnCenterTree" />
    </MudTooltip>

    <MudDivider Vertical="true" FlexItem="true" Style="height:28px; margin:0 4px;" />

    <MudTooltip Text="Reset view and widget positions">
        <MudIconButton Icon="@Icons.Material.Outlined.RestartAlt"
                       Size="Size.Small"
                       OnClick="OnReset" />
    </MudTooltip>

</MudPaper>

@code {
    [Parameter] public EventCallback OnZoomIn { get; set; }
    [Parameter] public EventCallback OnZoomOut { get; set; }
    [Parameter] public EventCallback OnCenterTree { get; set; }
    [Parameter] public EventCallback OnReset { get; set; }
}
