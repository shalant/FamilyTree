@inject NavigationManager Nav

@if (_collapsed)
{
    @* ── Collapsed: single pill with center + expand ──────────────────────── *@
    <div class="ft-toolbar-mini" title="Expand toolbar">
        <MudTooltip Text="Center on focus person" Placement="Placement.Top">
            <MudIconButton Icon="@Icons.Material.Filled.CenterFocusStrong"
                           Size="Size.Small"
                           Style="color:var(--ft-green-700);"
                           OnClick="OnCenterTree" />
        </MudTooltip>
        <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp"
                       Size="Size.Small"
                       Style="color:var(--ft-gray-400);"
                       OnClick="@(() => _collapsed = false)" />
    </div>
}
else
{
    @* ── Expanded: full toolbar ───────────────────────────────────────────── *@
    <MudPaper Elevation="2"
              Class="pa-2 ft-toolbar-full"
              Style="display:flex; align-items:center; gap:4px;
        background:rgba(245,245,245,0.3) !important;
        backdrop-filter:blur(12px); -webkit-backdrop-filter:blur(12px);
        border:1px solid rgba(255,255,255,0.135);
        border-radius:12px; box-shadow:0 8px 32px rgba(0,0,0,0.12);">

        @* Drag grip *@
        <div class="ft-toolbar-grip" data-drag-handle title="Drag to reposition">
            <svg width="8" height="14" viewBox="0 0 8 14" fill="currentColor"
                 style="color:var(--ft-gray-400);">
                <circle cx="2" cy="2"  r="1.3"/><circle cx="6" cy="2"  r="1.3"/>
                <circle cx="2" cy="7"  r="1.3"/><circle cx="6" cy="7"  r="1.3"/>
                <circle cx="2" cy="12" r="1.3"/><circle cx="6" cy="12" r="1.3"/>
            </svg>
        </div>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.PersonAdd"
                   Size="Size.Small"
                   OnClick="@(() => Nav.NavigateTo("/people/add"))">
            Add Person
        </MudButton>

        <MudDivider Vertical="true" FlexItem="true" Style="height:28px; margin:0 4px;" />

        <MudTooltip Text="Zoom out" Placement="Placement.Top">
            <MudIconButton Icon="@Icons.Material.Filled.ZoomOut" Size="Size.Small" OnClick="OnZoomOut" />
        </MudTooltip>
        <MudTooltip Text="Zoom in" Placement="Placement.Top">
            <MudIconButton Icon="@Icons.Material.Filled.ZoomIn" Size="Size.Small" OnClick="OnZoomIn" />
        </MudTooltip>
        <MudTooltip Text="Center on focus person" Placement="Placement.Top">
            <MudIconButton Icon="@Icons.Material.Filled.CenterFocusStrong" Size="Size.Small" OnClick="OnCenterTree" />
        </MudTooltip>

        <MudDivider Vertical="true" FlexItem="true" Style="height:28px; margin:0 4px;" />

        <MudTooltip Text="Reset view and widget positions" Placement="Placement.Top">
            <MudIconButton Icon="@Icons.Material.Outlined.RestartAlt" Size="Size.Small" OnClick="OnReset" />
        </MudTooltip>

        <MudDivider Vertical="true" FlexItem="true" Style="height:28px; margin:0 4px;" />

        @* Degrees-of-separation filter *@
        <MudTooltip Text="Show all people within N relationship hops of focus person" Placement="Placement.Top">
            <div style="display:flex; align-items:center; gap:2px;">
                @foreach (var deg in new[] { 0, 2, 3, 4 })
                {
                    var label = deg == 0 ? "All" : $"{deg}°";
                    var active = MaxDegrees == deg;
                    <button @onclick="@(() => OnDegreesChanged.InvokeAsync(deg))"
                            style="font-size:11px; font-weight:@(active ? "700" : "400");
                                   padding:2px 6px; border-radius:6px; border:none; cursor:pointer;
                                   background:@(active ? "var(--ft-green-600)" : "transparent");
                                   color:@(active ? "#fff" : "var(--ft-gray-600)");">
                        @label
                    </button>
                }
            </div>
        </MudTooltip>

        <MudDivider Vertical="true" FlexItem="true" Style="height:28px; margin:0 4px;" />

        <MudTooltip Text="Export family data" Placement="Placement.Top">
            <MudIconButton Icon="@Icons.Material.Outlined.FileDownload" Size="Size.Small" OnClick="OnExport" />
        </MudTooltip>

        <MudDivider Vertical="true" FlexItem="true" Style="height:28px; margin:0 4px;" />

        @* Collapse to mini *@
        <MudTooltip Text="Collapse toolbar" Placement="Placement.Top">
            <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown"
                           Size="Size.Small"
                           Style="color:var(--ft-gray-400);"
                           OnClick="@(() => _collapsed = true)" />
        </MudTooltip>

    </MudPaper>
}

@code {
    [Parameter] public EventCallback OnZoomIn { get; set; }
    [Parameter] public EventCallback OnZoomOut { get; set; }
    [Parameter] public EventCallback OnCenterTree { get; set; }
    [Parameter] public EventCallback OnReset { get; set; }
    [Parameter] public EventCallback OnExport { get; set; }
    [Parameter] public bool ForceCollapsed { get; set; }
    [Parameter] public int MaxDegrees { get; set; } = 0;
    [Parameter] public EventCallback<int> OnDegreesChanged { get; set; }

    private bool _collapsed = false;
    private bool? _lastForceCollapsed;

    // ForceCollapsed only sets the *default* — e.g. starting collapsed on a narrow
    // viewport — without permanently locking out manual expand/collapse. Re-applying
    // it on every render would fight the user's own toggle, so only re-sync when the
    // value itself actually changes (e.g. crossing the mobile breakpoint live).
    protected override void OnParametersSet()
    {
        if (_lastForceCollapsed != ForceCollapsed)
        {
            _collapsed = ForceCollapsed;
            _lastForceCollapsed = ForceCollapsed;
        }
    }
}
