@using FamilyTree.Shared.DTOs.Person
@using FamilyTree.Shared.DTOs
@using FamilyTree.Web.Services

@inject FamilyTreeLayoutEngine LayoutEngine

<div style="width:100%; background:var(--ft-surface);">

    @* ── Canvas header ───────────────────────────────────────────────────── *@
    <div style="text-align:center; padding:32px 0 28px;">
        <div style="font-size:22px; font-weight:500; font-style:italic;
            color:var(--ft-green-800); font-family:var(--ft-font-display);
            letter-spacing:0.01em; margin-bottom:10px;">
            Family tree
        </div>
        <div style="display:flex; align-items:center; gap:12px;
            max-width:220px; margin:0 auto 10px;">
            <div style="flex:1; height:0.5px; background:var(--ft-line-border);"></div>
            <div style="width:5px; height:5px; border-radius:50%;
            background:var(--ft-leaf-mid);"></div>
            <div style="flex:1; height:0.5px; background:var(--ft-line-border);"></div>
        </div>
        @if (FocusPerson is not null)
        {
            <div style="font-size:12px; color:var(--ft-text-muted);
                letter-spacing:0.06em; font-family:var(--ft-font-body);">
                centered on @FocusPerson.FirstName
                @if (FocusPerson.BirthDate.HasValue)
                {
                    <span style="color:var(--ft-gray-300);"> · @FocusPerson.BirthDate.Value.Year</span>
                }
            </div>
        }
    </div>

    @* ── Viewport container (clips to window, applies zoom) ─────────────────── *@
    <div style="width:100%; height:600px; overflow:hidden; position:relative; background:rgba(0,0,0,0.01);">

    @* ── Tree canvas (scrollable content, scaled for zoom) ──────────────────── *@
    <div style="position:absolute;
        width:@(_layout.CanvasWidth)px;
        height:@(_layout.CanvasHeight)px;
        left:@(_offsetX)px;
        top:@(_offsetY)px;
        background:rgba(0,0,0,0.02);
        transform:scale(@_zoom);
        transform-origin:0 0;
        border:1px solid #ccc;">

        @if (!_layout.Nodes.Any())
        {
            <div style="position:absolute;top:100px;left:50%;transform:translateX(-50%);color:var(--ft-text-muted);">
                No people to display
            </div>
        }

        @* Generation band backgrounds (time-based decade markers) *@
        @foreach (var band in _layout.Bands)
        {
            var opacity = GetBandOpacityByYear(band.Depth);
            <div style="position:absolute; left:0; top:@(band.Top)px;
                width:@(_layout.CanvasWidth)px; height:@(band.Height)px;
                background:rgba(74, 174, 109, @opacity);">
            </div>
        }

        @* Generation band labels (decade markers) *@
        @foreach (var band in _layout.Bands)
        {
            <div style="position:absolute; left:24px; top:@(band.Top + 12)px;
                font-size:11px; font-weight:600; color:var(--ft-green-700); letter-spacing:0.05em;
                font-family:var(--ft-font-body); pointer-events:none; opacity:0.7;">
                @band.Depth
            </div>
        }

        @* ── SVG connectors ──────────────────────────────────────────────── *@
        <svg style="position:absolute; top:0; left:0;
            width:@(_layout.CanvasWidth)px; height:@(_layout.CanvasHeight)px;
            pointer-events:none; overflow:visible;">
            @foreach (var family in _layout.Connectors)
            {
                @* Couple bracket: U-arc between two partners *@
                @if (family.Couple is { } arc)
                {
                    <path d="M @F(arc.PartnerAX) @F(arc.PartnerAY)
                    C @F(arc.PartnerAX) @F(arc.PeakY),
                    @F(arc.PartnerBX) @F(arc.PeakY),
                    @F(arc.PartnerBX) @F(arc.PartnerBY)"
                          fill="none"
                          stroke="var(--ft-line-couple)"
                          stroke-width="0.8"
                          stroke-linecap="round" />
                    <circle cx="@F(arc.MidX)" cy="@F(arc.HeartY)"
                            r="2.5" fill="var(--ft-line-couple)" />
                    <svg:text x="@F(arc.MidX - 4)" y="@F(arc.HeartY - 6)"
                              font-size="10" fill="var(--ft-green-600)">❤</svg:text>
                }

                @* Stem: vertical line from couple heart down to children's span level *@
                @if (family.Stem.TopY < family.Stem.BotY)
                {
                    <path d="M @F(family.Stem.X) @F(family.Stem.TopY)
                    C @F(family.Stem.X) @F(family.Stem.TopY + 28),
                    @F(family.Stem.X) @F(family.Stem.BotY - 28),
                    @F(family.Stem.X) @F(family.Stem.BotY)"
                          fill="none"
                          stroke="var(--ft-line-parent)"
                          stroke-width="1.2"
                          stroke-linecap="round" />
                }

                @* Sibling span: gentle bow across the top of all children *@
                @if (family.Span is { } span)
                {
                    var bowY = span.Y + 8.0;
                    <path d="M @F(span.LeftX)  @F(span.Y)
                    C @F(span.LeftX)  @F(bowY),
                    @F(span.RightX) @F(bowY),
                    @F(span.RightX) @F(span.Y)"
                          fill="none"
                          stroke="var(--ft-line-parent)"
                          stroke-width="1.2"
                          stroke-linecap="round" />
                }

                @* Child drops: one bezier per child from span down to node top *@
                @foreach (var drop in family.Drops)
                {
                    var lean = (drop.CenterX - family.Stem.X) * 0.18;
                    var fromY = family.Stem.BotY;
                    <path d="M @F(drop.CenterX)        @F(fromY)
                    C @F(drop.CenterX + lean) @F(fromY + 16),
                    @F(drop.CenterX - lean) @F(drop.BotY - 16),
                    @F(drop.CenterX)        @F(drop.BotY)"
                          fill="none"
                          stroke="var(--ft-line-parent)"
                          stroke-width="1.2"
                          stroke-linecap="round" />
                }
            }
        </svg>

        @* Scroll anchor — zero-size div at the focus node for JS scroll-to-focus *@
        @if (FocusPerson is not null && _layout.Nodes.FirstOrDefault(n => n.IsFocus) is { } focusNode)
        {
            <div id="node-@FocusPerson.Id"
                 style="position:absolute;
            left:@(focusNode.X)px; top:@(focusNode.Y)px;
            width:0; height:0; pointer-events:none;" />
        }

        @* Person nodes *@
        @foreach (var node in _layout.Nodes)
        {
            <PersonNode Person="@node.Person"
                        Left="@(node.X - node.Size / 2)"
                        Top="@(node.Y - node.Size / 2)"
                        Size="@node.Size"
                        RelativeDepth="@(node.Depth - _layout.FocusDepth)"
                        IsFocus="@node.IsFocus"
                        OnClick="OnPersonSelected" />
        }
    </div>
    </div>
</div>

@code {
    [Parameter] public List<PersonDto> People { get; set; } = [];
    [Parameter] public List<CoupleDto> Couples { get; set; } = [];
    [Parameter] public Guid? FocusId { get; set; }
    [Parameter] public int VisibleYearRange { get; set; } = 100;  // years to display (±50 from focus)
    [Parameter] public EventCallback<PersonDto> OnPersonSelected { get; set; }
    [Parameter] public EventCallback<int> OnVisibleYearRangeChanged { get; set; }

    // ── Computed layout (from FamilyTreeLayoutEngine) ──────────────────────
    private FamilyTreeLayout _layout = FamilyTreeLayout.Empty;

    private PersonDto? FocusPerson =>
        People.FirstOrDefault(p => p.Id == FocusId);

    // Zoom & pan state
    private double _zoom = 1.0;
    private double _offsetX = 0;
    private double _offsetY = 0;

    /// <summary>
    /// Invoked when component parameters change. Recomputes layout via FamilyTreeLayoutEngine.
    /// The engine handles all positioning logic: depth computation, birth year timelines,
    /// connected component identification, and node positioning.
    /// </summary>
    protected override void OnParametersSet()
    {
        _layout = LayoutEngine.ComputeLayout(People, Couples, FocusId);

        // On first load or data change, reset to show full year range
        if (!_initialized)
        {
            var birthYears = People
                .Select(p => p.BirthDate?.Year ?? DateTime.Now.Year)
                .Distinct()
                .ToList();
            if (birthYears.Any())
            {
                var minYear = birthYears.Min();
                var maxYear = birthYears.Max();
                VisibleYearRange = Math.Max(50, maxYear - minYear + 20);  // Full range + 20yr padding
            }
            _initialized = true;
        }

        CalculateZoomAndCenter();
    }

    private bool _initialized = false;

    /// <summary>
    /// Calculates zoom level to fit the VisibleYearRange in viewport, then centers on focus.
    /// With transform-origin: center center, scale happens around canvas center.
    /// </summary>
    private void CalculateZoomAndCenter()
    {
        var focusNode = _layout.Nodes.FirstOrDefault(n => n.IsFocus);
        if (focusNode == null)
        {
            _zoom = 1.0;
            _offsetX = 0;
            _offsetY = 0;
            return;
        }

        // Calculate zoom to fit VisibleYearRange in viewport
        const double pxPerYear = 45.0;
        const double viewportHeight = 600.0;
        var contentHeightForRange = VisibleYearRange * pxPerYear;
        _zoom = viewportHeight / contentHeightForRange;

        // Position canvas so focus node is centered in viewport
        // With transform-origin: 0 0 (top-left), offset directly positions the canvas
        _offsetX = (viewportHeight / 2.0) - (focusNode.X * _zoom);
        _offsetY = (viewportHeight / 2.0) - (focusNode.Y * _zoom);
    }

    public void SetVisibleYearRange(int years)
    {
        if (VisibleYearRange != years)
        {
            VisibleYearRange = years;
            CalculateZoomAndCenter();
            OnVisibleYearRangeChanged.InvokeAsync(years);
            StateHasChanged();
        }
    }

    // ── Zoom & Pan ────────────────────────────────────────────────────────

    public void ZoomIn()
    {
        SetVisibleYearRange(Math.Max(20, (int)(VisibleYearRange * 0.85)));  // show fewer years = zoom in
    }

    private static string F(double v) => v.ToString("F1");

    public void ZoomOut()
    {
        SetVisibleYearRange(Math.Min(500, (int)(VisibleYearRange * 1.15)));  // show more years = zoom out
    }

    /// <summary>
    /// Calculates band opacity based on birth year for time-gradient visualization.
    /// Older years (ancestors) appear darker; newer years (descendants) appear lighter.
    /// </summary>
    private double GetBandOpacityByYear(int year)
    {
        var allYears = _layout.Nodes.Select(n => n.Person.BirthDate?.Year ?? DateTime.Now.Year).Distinct().ToList();
        if (!allYears.Any()) return 0.08;
        var minY = allYears.Min();
        var maxY = allYears.Max();
        var normalized = maxY == minY ? 0.5 : (double)(year - minY) / (maxY - minY);
        return 0.15 - (normalized * 0.12);  // 0.15 (dark) to 0.03 (light)
    }

}