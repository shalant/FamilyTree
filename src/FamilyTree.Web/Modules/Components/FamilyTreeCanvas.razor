@using FamilyTree.Shared.DTOs
@using FamilyTree.Shared.DTOs.Person
@using FamilyTree.Web.Services
@using Microsoft.JSInterop
@implements IAsyncDisposable

@inject FamilyTreeLayoutEngine LayoutEngine
@inject IJSRuntime JS

@* Full-screen fixed viewport — covers 100vw × 100vh behind the floating UI *@
<div id="ft-viewport" class="ft-viewport">

    @* JS-only transform wrapper — Blazor never touches this element's style *@
    <div id="ft-transform">

        @* Content div — Blazor manages width/height here *@
        <div style="position:relative;
                    width:@(_layout.CanvasWidth)px;
                    height:@(_layout.CanvasHeight)px;">

            @if (!_layout.Nodes.Any())
            {
                <div class="ft-empty-message">No people to display</div>
            }

            @* Generation band backgrounds *@
            @{ int _bandIdx = 0; }
            @foreach (var band in _layout.Bands)
            {
                var opacity = _bandIdx++ % 2 == 0 ? "0.06" : "0.13";
                <div class="ft-band"
                     style="top:@(band.Top)px; height:@(band.Height)px; opacity:@opacity;">
                </div>
            }

            @* SVG connectors *@
            <svg class="ft-svg"
                 style="width:@(_layout.CanvasWidth)px; height:@(_layout.CanvasHeight)px;">

                @* Subtle boundary between genuinely disconnected (unrelated) components —
                   drawn first so connector lines/nodes always render on top of it *@
                @foreach (var divider in _layout.ComponentDividers)
                {
                    <path d="M @F(divider.X) @(divider.TopY) L @F(divider.X) @(divider.BotY)"
                          fill="none"
                          stroke="var(--ft-gray-400)"
                          stroke-width="1"
                          stroke-dasharray="2 6"
                          opacity="0.5" />
                }

                @foreach (var family in _layout.Connectors)
                {
                    @* Horizontal couple connector *@
                    @if (family.Couple is { } arc)
                    {
                        @if (arc.IsFormer)
                        {
                            <g>
                                <title>Former spouse</title>
                                <path d="M @F(arc.PartnerAX) @F(arc.PartnerAY) L @F(arc.PartnerBX) @F(arc.PartnerBY)"
                                      fill="none"
                                      stroke="var(--ft-gray-400)"
                                      stroke-width="1.2"
                                      stroke-dasharray="4 3" />
                            </g>
                        }
                        else
                        {
                            <path d="M @F(arc.PartnerAX) @F(arc.PartnerAY) L @F(arc.PartnerBX) @F(arc.PartnerBY)"
                                  fill="none"
                                  stroke="var(--ft-line-couple)"
                                  stroke-width="1.2" />
                            <svg:text x="@F(arc.MidX)" y="@F(arc.HeartY - 4)"
                                      font-size="9" fill="var(--ft-line-couple)"
                                      text-anchor="middle">❤</svg:text>
                        }
                    }

                    @* Vertical stem from couple/parent down to T‑bar *@
                    @if (family.Stem.TopY < family.Stem.BotY)
                    {
                        <path d="M @F(family.Stem.X) @F(family.Stem.TopY) L @F(family.Stem.X) @F(family.Stem.BotY)"
                              fill="none"
                              stroke="var(--ft-line-parent)"
                              stroke-width="1.2" />
                    }

                    @* Horizontal T‑bar across children *@
                    @if (family.Span is { } span)
                    {
                        <path d="M @F(span.LeftX) @F(span.Y) L @F(span.RightX) @F(span.Y)"
                              fill="none"
                              stroke="var(--ft-line-parent)"
                              stroke-width="1.2" />
                    }

                    @* Vertical drops from T‑bar to each child *@
                    @foreach (var drop in family.Drops)
                    {
                        <path d="M @F(drop.CenterX) @F(family.Stem.BotY) L @F(drop.CenterX) @F(drop.BotY)"
                              fill="none"
                              stroke="var(--ft-line-parent)"
                              stroke-width="1.2" />
                    }
                }

                @* Sibling-only connectors — no shared parent on the tree yet *@
                @foreach (var link in _layout.SiblingLinks)
                {
                    <path d="M @F(link.AX) @F(link.AY) L @F(link.BX) @F(link.BY)"
                          fill="none"
                          stroke="var(--ft-gray-400)"
                          stroke-width="1.2"
                          stroke-dasharray="4 3" />
                }
            </svg>

            @* Person nodes *@
            @foreach (var node in _layout.Nodes)
            {
                <PersonNode Person="@node.Person"
                            Left="@(node.X - node.Size / 2)"
                            Top="@(node.Y - node.Size / 2)"
                            Size="@node.Size"
                            RelativeDepth="@(node.Depth - _layout.FocusDepth)"
                            IsFocus="@node.IsFocus"
                            OnClick="OnPersonSelected" />
            }
        </div>
    </div>

    @* Timeline overlay — outside the pan/zoom transform so labels stay locked to the left *@
    <div id="ft-timeline">
        @foreach (var band in _layout.Bands)
        {
            <div class="ft-band-label" data-canvas-y="@(band.Top + 12)">
                @band.Depth
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public List<PersonDto> People { get; set; } = [];
    [Parameter] public List<CoupleDto> Couples { get; set; } = [];
    [Parameter] public Guid? FocusId { get; set; }
    [Parameter] public Guid? AnchorPersonId { get; set; }
    [Parameter] public EventCallback<PersonDto> OnPersonSelected { get; set; }

    private FamilyTreeLayout _layout = FamilyTreeLayout.Empty;
    private IJSObjectReference? _jsModule;
    private Guid? _prevFocusId;

    protected override void OnParametersSet()
    {
        _layout = LayoutEngine.ComputeLayout(People, Couples, FocusId, AnchorPersonId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _jsModule = await JS.InvokeAsync<IJSObjectReference>(
                "import", "/js/canvas-interaction.js?v=1");

            var (fx, fy, genTopY, genBotY) = ComputeDefaultView();
            await _jsModule.InvokeVoidAsync("init", "ft-viewport", "ft-transform", fx, fy, genTopY, genBotY);
            _prevFocusId = FocusId;
        }
        else if (FocusId != _prevFocusId && _jsModule != null)
        {
            var focusNode = _layout.Nodes.FirstOrDefault(n => n.IsFocus);
            if (focusNode != null)
                await _jsModule.InvokeVoidAsync("centerOn", focusNode.X, focusNode.Y);
            _prevFocusId = FocusId;
        }
    }

    // Shared by the first-render init (fit ±1 generation around the focus person)
    // and ResetView (which needs to recompute the same default zoom/pan, not just
    // re-pan at whatever zoom the user is currently at).
    private (double Fx, double Fy, double? GenTopY, double? GenBotY) ComputeDefaultView()
    {
        var focusNode = _layout.Nodes.FirstOrDefault(n => n.IsFocus);
        var fx = focusNode?.X ?? _layout.CanvasWidth / 2.0;
        var fy = focusNode?.Y ?? _layout.CanvasHeight / 2.0;

        var fd = _layout.FocusDepth;
        var parentNodes = _layout.Nodes.Where(n => n.Depth == fd + 1).ToList();
        var childNodes  = _layout.Nodes.Where(n => n.Depth == fd - 1).ToList();

        double? genTopY = null;
        double? genBotY = null;
        if (parentNodes.Count > 0)
            genTopY = parentNodes.Min(n => (double)n.Y - n.Size / 2.0) - 30;
        else if (focusNode != null)
            genTopY = focusNode.Y - focusNode.Size / 2.0 - 30;

        if (childNodes.Count > 0)
            genBotY = childNodes.Max(n => (double)n.Y + n.Size / 2.0) + 30;
        else if (focusNode != null)
            genBotY = focusNode.Y + focusNode.Size / 2.0 + 30;

        return (fx, fy, genTopY, genBotY);
    }

    public async Task ZoomIn()
    {
        if (_jsModule != null) await _jsModule.InvokeVoidAsync("zoomIn");
    }

    public async Task ZoomOut()
    {
        if (_jsModule != null) await _jsModule.InvokeVoidAsync("zoomOut");
    }

    public async Task CenterTree()
    {
        if (_jsModule == null) return;
        var focusNode = _layout.Nodes.FirstOrDefault(n => n.IsFocus);
        var fx = focusNode?.X ?? _layout.CanvasWidth / 2.0;
        var fy = focusNode?.Y ?? _layout.CanvasHeight / 2.0;
        await _jsModule.InvokeVoidAsync("centerOn", fx, fy);
    }

    // Unlike CenterTree (re-pan only, keeps current zoom), this restores the
    // original fit-to-generation zoom too — what "Reset view" should actually do.
    public async Task ResetView()
    {
        if (_jsModule == null) return;
        var (fx, fy, genTopY, genBotY) = ComputeDefaultView();
        await _jsModule.InvokeVoidAsync("resetView", fx, fy, genTopY, genBotY);
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsModule is null) return;

        try
        {
            await _jsModule.InvokeVoidAsync("dispose");
            await _jsModule.DisposeAsync();
        }
        catch (TaskCanceledException)
        {
            // Expected when circuit shuts down — safe to ignore
        }
        catch (JSDisconnectedException)
        {
            // Circuit already disposed — ignore
        }
        catch (JSException)
        {
            // JS runtime unavailable — ignore
        }
    }

    private static string F(double v) => v.ToString("F1");
}
