@page "/"
@layout TreeLayout
@rendermode InteractiveServer
@implements IAsyncDisposable

@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Identity
@using FamilyTree.Core.Models
@using FamilyTree.Core.Services
@using FamilyTree.Shared.DTOs.Person
@using FamilyTree.Shared.DTOs
@using FamilyTree.Web.Modules.Components
@using FamilyTree.Web.Modules.Dialogs
@using FamilyTree.Web.Services
@using MudBlazor

@inject IPersonService PersonService
@inject IAuthService AuthService
@inject IStoryService StoryService
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject ToastService Toast
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject TreeContextService TreeContext
@inject UserManager<AppUser> UserManager

<PageTitle>ArborKin</PageTitle>

@* Open Graph / Twitter card meta tags — populated from focus person for link previews *@
@if (_focusPerson != null && _ready)
{
    <HeadContent>
        <meta property="og:title"            content="@($"{_focusPerson.FirstName}'s Family Tree")" />
        <meta property="og:description"      content="@($"Explore {_people.Count} family members across generations on ArborKin.")" />
        <meta property="og:url"              content="@Nav.ToAbsoluteUri($"/?focus={_focusPerson.Id}")" />
        <meta property="og:type"             content="website" />
        <meta name="twitter:card"            content="summary" />
        <meta name="twitter:title"           content="@($"{_focusPerson.FirstName}'s Family Tree")" />
        <meta name="twitter:description"     content="@($"Explore {_people.Count} family members on ArborKin.")" />
    </HeadContent>
}

<AuthorizeView>
    <NotAuthorized>
        @if (_showIntro)
        {
            <LoginOverlay OnGuest="HideIntro" ErrorMessage="@LoginError" PrefillEmail="@Email" />
        }
    </NotAuthorized>
</AuthorizeView>

@if (_loading || !_ready)
{
    <div style="position:fixed; inset:0; display:flex; align-items:center; justify-content:center; z-index:10;">
        <MudProgressCircular Indeterminate="true" Color="Color.Success" />
    </div>
}
else if (!_people.Any())
{
    <div style="position:fixed; inset:0; display:flex; flex-direction:column;
        align-items:center; justify-content:center; text-align:center; padding:0 24px; z-index:10;">
        <div style="font-size:28px; font-weight:500; font-style:italic;
            font-family:Georgia,serif; color:var(--ft-green-800); margin-bottom:12px;">
            Your family tree
        </div>
        <div style="font-size:14px; color:var(--ft-gray-400);
            max-width:360px; line-height:1.7; margin-bottom:28px;">
            Add your first family member to begin.
        </div>
        <MudButton Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.PersonAdd"
                   Href="/people/add"
                   Style="background:var(--ft-green-700); color:#fff;">
            Add first person
        </MudButton>
    </div>
}
else if (_currentUserIsUnlinked && _focusPerson == null)
{
    <div style="position:fixed; inset:0; display:flex; flex-direction:column;
        align-items:center; justify-content:center; text-align:center; padding:0 24px; z-index:10;">
        <div style="font-size:28px; font-weight:500; font-style:italic;
            font-family:Georgia,serif; color:var(--ft-green-800); margin-bottom:12px;">
            Let's get you linked to the tree
        </div>
        <div style="font-size:14px; color:var(--ft-gray-400);
            max-width:360px; line-height:1.7; margin-bottom:28px;">
            A few quick questions and you'll be able to see where you fit in.
        </div>

        <MudButton Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.AccountTree"
                   OnClick="ResumeLinkingAsync"
                   Style="background:var(--ft-green-700); color:#fff;">
            Complete your profile →
        </MudButton>
    </div>
}
else if (_focusPerson == null && _people.Any())
{
    <div style="position:fixed; inset:0; display:flex; flex-direction:column;
        align-items:center; justify-content:center; text-align:center; padding:0 24px; z-index:10;">
        <div style="font-size:28px; font-weight:500; font-style:italic;
            font-family:Georgia,serif; color:var(--ft-green-800); margin-bottom:12px;">
            Choose your starting point
        </div>
        <div style="font-size:14px; color:var(--ft-gray-400);
            max-width:360px; line-height:1.7; margin-bottom:28px;">
            Select a person to center your tree. You can change this anytime.
        </div>

        <MudButton Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.CenterFocusStrong"
                   Href="/people"
                   Style="background:var(--ft-green-700); color:#fff;">
            Set focus person →
        </MudButton>
    </div>
}
else
{
    <FamilyTreeCanvas @ref="_canvas"
                      People="_people"
                      Couples="_couples"
                      FocusId="_focusPerson?.Id"
                      AnchorPersonId="_anchorPersonId"
                      OnPersonSelected="HandlePersonSelected" />

    <FamilyFactsBanner People="_people" />

    <div id="ft-toolbar" style="@_toolbarStyle">
        <CustomToolbar OnZoomIn="@(async () => { if (_canvas != null) await _canvas.ZoomIn(); })"
                       OnZoomOut="@(async () => { if (_canvas != null) await _canvas.ZoomOut(); })"
                       OnCenterTree="@(async () => { if (_canvas != null) await _canvas.CenterTree(); })"
                       OnReset="HandleReset"
                       OnRefresh="RefreshDataAsync"
                       OnExport="HandleExport"
                       ForceCollapsed="_isNarrowViewport" />
    </div>

    <HeroOverlayComponent FocusPerson="_focusPerson"
                          PeopleCount="_people.Count"
                          CoupleCount="_couples.Count"
                          OnCenterTree="CenterTree"
                          OnShare="ShareView"
                          OnInviteStory="OpenInviteStoryDialog"
                          Visible="(_detailPerson == null)"
                          DragLeft="_heroPos?.Left"
                          DragTop="_heroPos?.Top"
                          OnPositionReset="() => _heroPos = null" />
}

<PersonDetailDrawer Person="_detailPerson"
                    AllPeople="_people"
                    OnClose="() => _detailPerson = null"
                    OnEdit="@(p => Nav.NavigateTo($"/people/{p.Id}/edit"))"
                    OnFocusPerson="SetFocus"
                    OnDelete="PromptDelete" />

@code {
    private bool _showIntro = true;

    private void HideIntro() => _showIntro = false;

    [SupplyParameterFromQuery] public Guid? Focus { get; set; }
    [SupplyParameterFromQuery] public Guid? View  { get; set; }
    [SupplyParameterFromQuery] public string? LoginError { get; set; }
    [SupplyParameterFromQuery] public string? Email { get; set; }

    private List<PersonDto> _people = [];
    private List<CoupleDto> _couples = [];
    private PersonDto? _focusPerson;
    private PersonDto? _detailPerson;
    private bool _loading = true;
    private bool _ready   = false;  // true once JS-dependent focus init is done
    private FamilyTreeCanvas? _canvas;
    private Guid? _lastHandledFocus;  // prevents re-processing the same Focus on re-renders
    private Guid? _lastHandledView;   // prevents re-processing the same View on re-renders
    private Guid? _currentUserId;
    private bool _currentUserIsUnlinked;
    private Guid? _anchorPersonId; // the logged-in user's own linked Person — drives lineage-side ordering
    private bool _noFocusToastShown;

    // ── Drag state ────────────────────────────────────────────────────────────
    private IJSObjectReference? _dragModule;
    private DotNetObjectReference<Home>? _dotNetRef;
    private (double Left, double Top)? _toolbarPos;
    private (double Left, double Top)? _heroPos;
    private bool _isNarrowViewport;
    private bool _showTreeHint = false;
    private bool _linkingModalChecked = false;

    // Mobile/tablet always anchors bottom-left, ignoring any saved drag position from
    // a wider session — a position dragged-to on desktop may not even be on-screen here.
    private string _toolbarStyle => _toolbarPos.HasValue && !_isNarrowViewport
        ? $"position:fixed; left:{(int)_toolbarPos.Value.Left}px; top:{(int)_toolbarPos.Value.Top}px; z-index:1200;"
        : "position:fixed; bottom:24px; left:24px; z-index:1200;";

    protected override async Task OnInitializedAsync()
    {
        TreeContext.OnCenterTreeRequested += OnCenterTreeFromAppBar;

        // Capture auth user ID for DB focus persistence
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (Guid.TryParse(userIdClaim, out var uid)) _currentUserId = uid;

        Guid? claimedPersonId = null;
        if (_currentUserId.HasValue)
        {
            var currentAppUser = await UserManager.FindByIdAsync(_currentUserId.Value.ToString());
            claimedPersonId = currentAppUser?.PersonId;
            _anchorPersonId = claimedPersonId;
        }

        var result = await PersonService.GetAllAsync();
        if (result.Success)
        {
            _people = result.Data!;
            _couples = CoupleHelper.Derive(_people);

            // An authenticated user with no resolvable linked Person has no "their tree"
            // to show — either they never linked (claimedPersonId is null), or their
            // AppUser.PersonId still points at a Person that's since been soft-deleted.
            // See LinkedPersonResolver for why HasValue alone isn't enough. Guests (no
            // _currentUserId) are unaffected.
            _currentUserIsUnlinked = _currentUserId.HasValue
                && !LinkedPersonResolver.IsResolved(claimedPersonId, _people);

            if (!_people.Any())
            {
                _ready = true;
            }
            else if (Focus.HasValue)
            {
                // Explicit URL focus param (shared link, login redirect)
                _lastHandledFocus = Focus.Value;
                _focusPerson = _people.FirstOrDefault(p => p.Id == Focus.Value)
                            ?? (_currentUserIsUnlinked ? null : _people.FirstOrDefault());
                TreeContext.SetContext(_focusPerson, _people.Count, _couples.Count);
                await PersistFocusAsync(_focusPerson?.Id);
                _ready = true;
            }
            else if (_currentUserIsUnlinked)
            {
                // No focus param and not yet linked — leave _focusPerson null so the
                // existing "Choose your starting point" empty state renders instead of
                // an arbitrary stranger's tree, while CheckAndShowLinkingModalIfNeededAsync
                // (OnAfterRenderAsync) re-prompts them to finish linking.
                _ready = true;
            }
            // else: _ready stays false — OnAfterRenderAsync reads DB/localStorage
        }
        else
        {
            Toast.Error(result.Message);
            _ready = true;
        }
        _loading = false;

        if (_currentUserId.HasValue && !_people.Any())
        {
            Toast.Info("Welcome! Start by adding your first family member.");
        }
    }

    // Bound to the "Complete your profile →" button in the unlinked-user empty state —
    // re-opens the same modal CheckAndShowLinkingModalIfNeededAsync shows automatically,
    // for when the user skipped it (or dismissed it) the first time around.
    private async Task ResumeLinkingAsync() => await CheckAndShowLinkingModalIfNeededAsync();

    private async Task CheckAndShowLinkingModalIfNeededAsync()
    {
        if (!_currentUserId.HasValue) return;

        try
        {
            var user = await UserManager.FindByIdAsync(_currentUserId.Value.ToString());

            // Not just "never linked" (PersonId null) — see LinkedPersonResolver.
            var isResolved = LinkedPersonResolver.IsResolved(user?.PersonId, _people);
            if (user != null && !isResolved && _people.Any())
            {
                await ShowLinkingModalAsync(user, isRecovery: true);

                // After modal completes, reload user to get updated PersonId and refresh focus
                user = await UserManager.FindByIdAsync(_currentUserId.Value.ToString());

                // Re-fetch _people — the modal may have just created a brand-new Person
                // (the user's own record, e.g. "linked as a new sibling of Douglas"),
                // which the _people list loaded before they existed can't contain. Without
                // this refresh, the lookup below always misses for a newly-created person,
                // silently skipping PersistFocusAsync and leaving FocusPersonId null forever
                // — found 2026-07-06 when a fresh page load then fell back to an arbitrary
                // "first person alphabetically" instead of the user's own new person.
                var refreshed = await PersonService.GetAllAsync();
                if (refreshed.Success)
                {
                    _people = refreshed.Data!;
                    _couples = CoupleHelper.Derive(_people);
                }

                var linkedPerson = user?.PersonId != null
                    ? _people.FirstOrDefault(p => p.Id == user.PersonId)
                    : null;
                if (linkedPerson != null)
                {
                    _currentUserIsUnlinked = false;
                    _anchorPersonId = user!.PersonId;
                    _focusPerson = linkedPerson;
                    TreeContext.SetContext(_focusPerson, _people.Count, _couples.Count);
                    await PersistFocusAsync(_focusPerson.Id);
                    StateHasChanged();
                }
                // else: dismissed without resolving to a valid person — stay in the
                // unlinked state so the recovery prompt remains available next time.
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Error checking profile link: {ex.Message}");
        }
    }

    private async Task ShowLinkingModalAsync(AppUser user, bool isRecovery = false)
    {
        var names = user.DisplayName?.Split(' ') ?? new[] { "", "" };
        var firstName = names.Length > 0 ? names[0] : "";
        var lastName = names.Length > 1 ? string.Join(" ", names.Skip(1)) : "";

        string? storySubjectName = null;
        Guid? storyId = null;
        if (!string.IsNullOrWhiteSpace(user.Email))
        {
            var storiesResult = await StoryService.GetPendingLinkingSubjectAsync(user.Email);
            if (storiesResult.Success && storiesResult.Data is { } pending)
            {
                storySubjectName = pending.UnlinkedPersonName;
                storyId = pending.Id;
            }
        }

        var parameters = new DialogParameters<LinkToTreeModal>
        {
            { x => x.UserId, user.Id },
            { x => x.UserFirstName, firstName },
            { x => x.UserLastName, lastName },
            { x => x.IsRecovery, isRecovery },
            { x => x.StorySubjectName, storySubjectName },
            { x => x.StoryId, storyId },
        };

        var dialog = await DialogService.ShowAsync<LinkToTreeModal>(
            isRecovery ? "Complete your profile" : "Link to your family tree",
            parameters);
        await dialog.Result;
    }

    // Handles same-page navigation (query param changes without full reload).
    protected override async Task OnParametersSetAsync()
    {
        if (!_ready || _people.Count == 0) return;

        // ?focus= re-centers the tree only (shared links, login redirect) — no drawer
        if (Focus.HasValue && Focus.Value != _lastHandledFocus)
        {
            _lastHandledFocus = Focus.Value;
            var person = _people.FirstOrDefault(p => p.Id == Focus.Value);
            if (person != null)
            {
                _focusPerson  = person;
                await PersistFocusAsync(person.Id);
            }
        }

        // ?view= opens the drawer only — no tree re-centering
        if (View.HasValue && View.Value != _lastHandledView)
        {
            _lastHandledView = View.Value;
            var person = _people.FirstOrDefault(p => p.Id == View.Value);
            if (person != null)
                _detailPerson = person;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_linkingModalChecked && _currentUserId.HasValue && _people.Any())
        {
            _linkingModalChecked = true;
            await CheckAndShowLinkingModalIfNeededAsync();
        }

        // Resolve focus once JS is available (only when not set by URL param)
        if (!_ready && _people.Count > 0)
        {
            _focusPerson = await ResolveFocusAsync();
            TreeContext.SetContext(_focusPerson, _people.Count, _couples.Count);
            _ready = true;
            StateHasChanged();
        }

        // Guarded by _noFocusToastShown — without it this fires on every re-render (drag
        // init, drawer open/close, etc.) since _focusPerson stays null indefinitely until
        // the user actually picks someone. Also skipped for unlinked users — that empty
        // state already has its own "let's get you linked" messaging.
        if (_ready && _people.Any() && _focusPerson == null && !_currentUserIsUnlinked && !_noFocusToastShown)
        {
            _noFocusToastShown = true;
            Toast.Info("Choose a person to center your tree.");
        }

        // Load the drag module once; call init on every render so that
        // elements appearing after initial load (toolbar/hero) get wired up.
        if (_dragModule == null)
        {
            _dragModule = await JS.InvokeAsync<IJSObjectReference>("import", "/js/ftDrag.js?v=1");
            _dotNetRef  = DotNetObjectReference.Create(this);

            var tb = await _dragModule.InvokeAsync<double[]?>("loadPos", "toolbar", "ft-toolbar", 0);
            var h  = await _dragModule.InvokeAsync<double[]?>("loadPos", "hero", "ft-hero", 68);
            if (tb != null) _toolbarPos = (tb[0], tb[1]);
            if (h  != null) _heroPos    = (h[0],  h[1]);

            if (tb != null || h != null)
            {
                StateHasChanged(); // re-render with restored positions; init runs on next cycle
                return;
            }
        }

        await _dragModule.InvokeVoidAsync("init", _dotNetRef);

        if (_ready && _people.Any() && _focusPerson != null && !_showTreeHint)
        {
            try
            {
                var seen = await JS.InvokeAsync<string?>("localStorage.getItem", "ft-treehint");
                if (seen != "1")
                {
                    _showTreeHint = true;
                    Toast.Info("Tip: Drag to explore the tree. Scroll to zoom.");
                    await JS.InvokeVoidAsync("localStorage.setItem", "ft-treehint", "1");
                }
            }
            catch { }
        }
    }

    [JSInvokable]
    public void OnDragEnd(string key, double left, double top)
    {
        if (key == "toolbar") _toolbarPos = (left, top);
        if (key == "hero")    _heroPos    = (left, top);
        StateHasChanged(); // Blazor re-renders with new position — no more JS/Blazor conflict
    }

    [JSInvokable]
    public void OnViewportWidthChanged(double width)
    {
        var isNarrow = width <= 768;
        if (isNarrow == _isNarrowViewport) return;
        _isNarrowViewport = isNarrow;
        StateHasChanged();
    }

    private void OnCenterTreeFromAppBar() => InvokeAsync(CenterTree);

    public async ValueTask DisposeAsync()
    {
        TreeContext.OnCenterTreeRequested -= OnCenterTreeFromAppBar;
        try
        {
            if (_dragModule != null) await _dragModule.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        _dotNetRef?.Dispose();
    }


    private void HandlePersonSelected(PersonDto person) =>
        _detailPerson = person;

    private async Task SetFocus(PersonDto person)
    {
        _focusPerson  = person;
        _detailPerson = null;
        TreeContext.SetContext(person, _people.Count, _couples.Count);
        await PersistFocusAsync(person.Id);
    }

    // Saves focus to DB (if authenticated) and localStorage.
    private async Task PersistFocusAsync(Guid? personId)
    {
        if (_currentUserId.HasValue)
        {
            // Authenticated users are persisted to the DB only — "ft-focus" in
            // localStorage is a single key shared by every account that has ever used
            // this browser (a real problem on a shared/dev machine testing multiple
            // accounts), so an authenticated user must never read OR write it; DB is
            // their sole source of truth. Reserved for anonymous guest browsing below.
            if (personId.HasValue)
            {
                try { await AuthService.SaveFocusPersonAsync(_currentUserId.Value, personId.Value); }
                catch { }
            }
            return;
        }

        try { await JS.InvokeVoidAsync("localStorage.setItem", "ft-focus", personId?.ToString() ?? ""); }
        catch { }
    }

    // Resolves initial focus: DB (authenticated) → localStorage (guest only) → first person.
    private async Task<PersonDto?> ResolveFocusAsync()
    {
        if (_currentUserId.HasValue)
        {
            try
            {
                var dbId = await AuthService.GetFocusPersonIdAsync(_currentUserId.Value);
                if (dbId.HasValue)
                {
                    var dbPerson = _people.FirstOrDefault(p => p.Id == dbId.Value);
                    if (dbPerson != null) return dbPerson;
                }
            }
            catch { }

            // No DB focus yet (e.g. registered but not yet linked) — never fall back to
            // the shared localStorage key here; it may hold a completely different
            // account's last-viewed person. Fall straight through to the generic default.
            return _people.FirstOrDefault();
        }

        try
        {
            var saved = await JS.InvokeAsync<string?>("localStorage.getItem", "ft-focus");
            if (Guid.TryParse(saved, out var savedId))
            {
                var lsPerson = _people.FirstOrDefault(p => p.Id == savedId);
                if (lsPerson != null) return lsPerson;
            }
        }
        catch { }

        return _people.FirstOrDefault();
    }

    private async Task CenterTree()
    {
        if (_canvas != null)
            await _canvas.CenterTree();
    }

    private async Task HandleReset()
    {
        _toolbarPos = null;
        _heroPos = null;
        try
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", "ftdrag:toolbar");
            await JS.InvokeVoidAsync("localStorage.removeItem", "ftdrag:hero");
        }
        catch { }
        if (_canvas != null) await _canvas.ResetView();
        StateHasChanged();
    }

    // A Blazor Server circuit loads _people once and keeps it in memory — edits made
    // elsewhere (another tab, the Admin panel, another user) never show up until this
    // is re-fetched. This re-pulls people + relationships from the server without a
    // full page reload, so a stale in-tab view (e.g. a person deleted in another tab)
    // can't be mistaken for a rendering bug.
    private async Task RefreshDataAsync()
    {
        var result = await PersonService.GetAllAsync();
        if (!result.Success)
        {
            Toast.Error(result.Message);
            return;
        }

        _people = result.Data!;
        _couples = CoupleHelper.Derive(_people);

        _focusPerson = _focusPerson != null
            ? _people.FirstOrDefault(p => p.Id == _focusPerson.Id) ?? _people.FirstOrDefault()
            : _people.FirstOrDefault();

        TreeContext.SetContext(_focusPerson, _people.Count, _couples.Count);
        StateHasChanged();
        Toast.Success("Tree refreshed.");
    }

    private async Task HandleExport()
    {
        var parameters = new DialogParameters<ExportDialog>
        {
            { d => d.People,         _people },
            { d => d.FocusPerson,    _focusPerson },
            { d => d.AnchorPersonId, _anchorPersonId }
        };

        await DialogService.ShowAsync<ExportDialog>(
            "Export", parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
    }

    private async Task ShareView()
    {
        var url = Nav.ToAbsoluteUri($"/?focus={_focusPerson?.Id}").ToString();

        var parameters = new DialogParameters<ShareDialog>
        {
            { d => d.ShareUrl,   url },
            { d => d.FocusName,  _focusPerson?.FirstName ?? "Family" }
        };

        await DialogService.ShowAsync<ShareDialog>(
            "Share", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
    }

    private async Task OpenInviteStoryDialog()
    {
        if (_focusPerson is null) return;

        var parameters = new DialogParameters<StoryInviteDialog>
        {
            { d => d.PersonId,   _focusPerson.Id },
            { d => d.PersonName, _focusPerson.FullName },
            { d => d.AllPeople,  _people },
        };

        await DialogService.ShowAsync<StoryInviteDialog>(
            "Invite someone to share a memory", 
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
    }

    private async Task PromptDelete(PersonDto person)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Message,      $"Delete {person.FullName}? This cannot be undone." },
            { x => x.ConfirmLabel, "Delete" }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete person", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            var response = await PersonService.DeleteAsync(person.Id);
            Toast.ShowResult(response, $"{person.FullName} deleted.");

            if (response.Success)
            {
                var refresh = await PersonService.GetAllAsync();
                if (refresh.Success)
                {
                    _people = refresh.Data!;
                    _couples = CoupleHelper.Derive(_people);
                }
                _detailPerson = null;
            }
        }
    }
}