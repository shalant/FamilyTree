@page "/register"
@rendermode InteractiveServer

@using FamilyTree.Core.Models
@using FamilyTree.Core.Services
@using FamilyTree.Web.Services
@using FamilyTree.Web.Modules.Components
@using MudBlazor
@inject IAuthService AuthService
@inject IStoryService StoryService
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ToastService ToastService

<PageTitle>Create account — Arborkin</PageTitle>

<div class="ft-auth-page">
    <div class="intro-glass auth-card" style="max-width:420px;">

        @* ── Branding ──────────────────────────────────────────────────────── *@
        <div style="display:flex; justify-content:center; margin-bottom:4px; user-select:none;">
            <img src="/images/arborkin-logo__transparent.png" alt="ArborKin"
                 style="width:80%; max-width:320px; height:auto;" />
        </div>

        @if (_mode == "Closed")
        {
            <div style="font-size:20px; font-weight:600; color:var(--ft-text-primary); margin-bottom:8px;">
                Registration closed
            </div>
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
                New registrations are currently closed. Contact the administrator to request access.
            </MudAlert>
            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Outlined.ArrowBack"
                       OnClick='() => Nav.NavigateTo("/")'>
                Back to sign in
            </MudButton>
        }
        else if (_mode == "InviteOnly" && !InviteId.HasValue)
        {
            <div style="font-size:20px; font-weight:600; color:var(--ft-text-primary); margin-bottom:8px;">
                Invitation required
            </div>
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
                Registration is by invitation only. Contact the administrator and ask them to send you an invite link.
            </MudAlert>
            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Outlined.ArrowBack"
                       OnClick='() => Nav.NavigateTo("/")'>
                Back to sign in
            </MudButton>
        }
        else
        {
            <div style="font-size:20px; font-weight:600; color:var(--ft-text-primary); margin-bottom:4px;">
                Create your account
            </div>
            <div class="intro-subtitle" style="margin-bottom:20px;">
                Join to build and explore your family tree
            </div>

            @* ── Invite banner ──────────────────────────────────────────────── *@
            @if (_invite != null)
            {
                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-3" Dense="true">
                    You've been invited — your email is pre-filled below.
                </MudAlert>
            }

            @* ── Google sign-up ────────────────────────────────────────────── *@
            @if (_mode != "InviteOnly")
            {
                <button class="auth-google-btn" @onclick="SignUpWithGoogle" disabled="@_loading">
                    <svg viewBox="0 0 24 24" width="18" height="18" style="flex-shrink:0;">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" />
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
                    </svg>
                    Continue with Google
                </button>
                <div class="auth-or-divider"><span>or</span></div>
            }

            @* ── Error / success ──────────────────────────────────────────── *@
            @if (_error is not null)
            {
                <div class="auth-error">@_error</div>
            }

            @* ── Name row ──────────────────────────────────────────────────── *@
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
                <div>
                    <div class="ft-field-label">First name</div>
                    <MudTextField @bind-Value="_firstName"
                                  Placeholder="e.g. Jane"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Disabled="_loading"
                                  Error="@(!string.IsNullOrEmpty(_firstNameError))"
                                  ErrorText="@_firstNameError" />
                </div>
                <div>
                    <div class="ft-field-label">Last name</div>
                    <MudTextField @bind-Value="_lastName"
                                  Placeholder="e.g. Smith"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Disabled="_loading"
                                  Error="@(!string.IsNullOrEmpty(_lastNameError))"
                                  ErrorText="@_lastNameError" />
                </div>
            </div>

            @* ── Email ─────────────────────────────────────────────────────── *@
            <div class="ft-field-label" style="margin-top:12px;">Email address</div>
            <MudTextField @bind-Value="_email"
                          Placeholder="you@example.com"
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          Margin="Margin.Dense"
                          Disabled="@(_loading || _invite != null)"
                          Error="@(!string.IsNullOrEmpty(_emailError))"
                          ErrorText="@_emailError" />

            @* ── Password ──────────────────────────────────────────────────── *@
            <div class="ft-field-label" style="margin-top:12px;">Password</div>
            <MudTextField @bind-Value="_password"
                          Placeholder="Minimum 10 characters"
                          Variant="Variant.Outlined"
                          InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                          Margin="Margin.Dense"
                          Disabled="_loading"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showPassword? Icons.Material.Outlined.VisibilityOff
                                                                                     : Icons.Material.Outlined.Visibility)"
                          OnAdornmentClick="() => _showPassword = !_showPassword"
                          Error="@(!string.IsNullOrEmpty(_passwordError))"
                          ErrorText="@_passwordError" />

            @* ── Confirm password ──────────────────────────────────────────── *@
            <div class="ft-field-label" style="margin-top:12px;">Confirm password</div>
            <MudTextField @bind-Value="_confirmPassword"
                          Placeholder="Re-enter your password"
                          Variant="Variant.Outlined"
                          InputType="@(_showConfirm ? InputType.Text : InputType.Password)"
                          Margin="Margin.Dense"
                          Disabled="_loading"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showConfirm? Icons.Material.Outlined.VisibilityOff
                                                                                    : Icons.Material.Outlined.Visibility)"
                          OnAdornmentClick="() => _showConfirm = !_showConfirm"
                          Error="@(!string.IsNullOrEmpty(_confirmError))"
                          ErrorText="@_confirmError" />

            @if (_registered)
            {
                <div style="text-align:center; padding:24px 0;">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                             Style="font-size:48px; color:var(--ft-green-600); margin-bottom:12px;" />

                    <div style="font-size:20px; font-weight:600; color:var(--ft-text-primary); margin-bottom:8px;">
                        You're all set!
                    </div>

                    <p style="font-size:14px; color:var(--ft-text-muted); margin-bottom:24px; line-height:1.6;">
                        Welcome, @_firstName — your ArborKin account is ready. Let's link you to your family tree.
                    </p>

                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                               OnClick="ShowLinkModal">
                        Link to your tree →
                    </MudButton>
                </div>
            }

            else
            {
                @* ── Submit ──────────────────────────────────────────────────── *@
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           FullWidth="true" Class="mt-4"
                           OnClick="Submit"
                           Disabled="_loading">
                    @if (_loading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true"
                                             Style="color:#fff; margin-right:8px;" />
                    }
                    Create account
                </MudButton>

                <div class="auth-terms">
                    By registering you agree to our
                    <a href="/about#privacy">privacy policy</a>.
                    Your data is never sold or shared.
                </div>

                <div class="auth-browse" style="margin-top:16px;">
                    <button @onclick='() => Nav.NavigateTo("/")'>
                        Already have an account? Sign in →
                    </button>
                </div>
            }
        }

    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "invite")]
    public Guid? InviteId { get; set; }

    private Guid? _inviteId; // saved from query param before URL strip
    private string _mode = "Open";
    private UserInvite? _invite;

    private string _firstName = "";
    private string _lastName = "";
    private string _email = "";
    private string _password = "";
    private string _confirmPassword = "";

    private bool _showPassword;
    private bool _showConfirm;
    private bool _loading;
    private bool _registered;
    private bool _welcomeToastShown;
    private Guid? _registeredUserId;

    private string? _error;
    private string _firstNameError = "";
    private string _lastNameError = "";
    private string _emailError = "";
    private string _passwordError = "";
    private string _confirmError = "";

    private string? _storySubjectName;
    private Guid? _storyId;

    protected override async Task OnInitializedAsync()
    {
        _mode = AuthService.GetRegistrationMode();

        if (InviteId.HasValue)
        {
            _inviteId = InviteId;
            _invite = await AuthService.ValidateInviteAsync(InviteId.Value);
            if (_invite != null)
            {
                _email = _invite.Email;
                await LoadPendingStorySubjectAsync(_invite.Email);
            }
        }
    }

    // Finds the story this invite is following up on (if any) so the linking modal can
    // walk the user through adding the story's subject to the tree first. Only an
    // anonymous invite-response story (AuthorId == null) qualifies — a self-authored
    // story (someone already signed in, writing about themselves under a free-text
    // name) must never drive the subject-first flow, or the modal ends up asking
    // "is Tom related to anyone?" about Tom while Tom is the one answering.
    private async Task LoadPendingStorySubjectAsync(string email)
    {
        var result = await StoryService.GetByAuthorEmailAsync(email);
        var pending = result.Success
            ? result.Data?.Where(s => s.PersonId == null && s.AuthorId == null &&
                                       !string.IsNullOrWhiteSpace(s.UnlinkedPersonName))
                          .OrderByDescending(s => s.CreatedAt)
                          .FirstOrDefault()
            : null;

        if (pending != null)
        {
            _storySubjectName = pending.UnlinkedPersonName;
            _storyId = pending.Id;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _inviteId.HasValue && _invite != null && !_welcomeToastShown)
        {
            _welcomeToastShown = true;
            ToastService.Success("Welcome! Your memory has been saved — now create your free ArborKin account.");
        }
        if (firstRender && _inviteId.HasValue)
            await JS.InvokeVoidAsync("history.replaceState", null, "", "/register");
    }

    private void SignUpWithGoogle() =>
        Nav.NavigateTo("/auth/google", forceLoad: true);

    private async Task Submit()
    {
        _error = null;
        _firstNameError = _lastNameError = _emailError = _passwordError = _confirmError = "";

        var valid = true;

        if (string.IsNullOrWhiteSpace(_firstName))
        { _firstNameError = "Required"; valid = false; }

        if (string.IsNullOrWhiteSpace(_lastName))
        { _lastNameError = "Required"; valid = false; }

        if (string.IsNullOrWhiteSpace(_email))
        { _emailError = "Required"; valid = false; }
        else if (!_email.Contains('@') || !_email.Contains('.'))
        { _emailError = "Enter a valid email address"; valid = false; }

        if (string.IsNullOrWhiteSpace(_password))
        { _passwordError = "Required"; valid = false; }
        else if (_password.Length < 10)
        { _passwordError = "Minimum 10 characters"; valid = false; }

        if (string.IsNullOrWhiteSpace(_confirmPassword))
        { _confirmError = "Required"; valid = false; }
        else if (_confirmPassword != _password)
        { _confirmError = "Passwords do not match"; valid = false; }

        if (!valid) return;

        _loading = true;
        var result = await AuthService.RegisterAsync(_firstName, _lastName, _email, _password, _inviteId);
        _loading = false;

        if (!result.Success)
        {
            _error = result.Error;
        }
        else
        {
            _registeredUserId = result.UserId;
            _registered = true;
            ToastService.Success("Account created — let's link you to your tree!");
        }
    }

    private async Task ShowLinkModal()
    {
        if (!_registeredUserId.HasValue)
            return;

        var parameters = new DialogParameters<LinkToTreeModal>
        {
            { x => x.UserId, _registeredUserId.Value },
            { x => x.UserFirstName, _firstName },
            { x => x.UserLastName, _lastName },
            { x => x.StorySubjectName, _storySubjectName },
            { x => x.StoryId, _storyId },
        };

        var dialog = await DialogService.ShowAsync<LinkToTreeModal>(
            "Link to your family tree", parameters);
        var result = await dialog.Result;

        // Explicitly persist FocusPersonId rather than relying on /auth/do-login's
        // FocusPersonId ?? PersonId fallback — that fallback depends on the linking
        // write being visible to a separate request, and if it comes up empty,
        // ResolveFocusAsync falls through to the browser's shared "ft-focus"
        // localStorage key, which could still hold whoever was previously signed in
        // on this device (e.g. the developer's own account during testing).
        if (!result.Canceled && result.Data is Guid linkedPersonId)
            await AuthService.SaveFocusPersonAsync(_registeredUserId.Value, linkedPersonId);

        // Registering only creates the account — it doesn't authenticate this browser.
        // Submit a real POST to /auth/do-login (native form, sets the auth cookie) so the
        // new user actually lands on their own home page instead of whoever was previously
        // signed in on this device.
        await JS.InvokeVoidAsync("ftSubmitLogin", _email, _password);
    }
}