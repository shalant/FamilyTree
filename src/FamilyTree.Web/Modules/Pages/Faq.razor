@page "/faq"
@attribute [AllowAnonymous]
@rendermode InteractiveServer

@using MudBlazor

@inject NavigationManager Nav

<PageTitle>FAQ & Security — ArborKin</PageTitle>

<div style="max-width:760px; margin:0 auto; padding:40px 24px 80px;
    font-family:var(--ft-font-body);">

    @* ── Header ───────────────────────────────────────────────────────────── *@
    <div style="margin-bottom:36px;">
        <div style="font-size:28px; font-weight:700; font-style:italic;
            font-family:var(--ft-font-display); color:var(--ft-green-800);
            line-height:1.2; margin-bottom:6px;">
            Frequently asked questions
        </div>
        <div style="font-size:14px; color:var(--ft-gray-400); margin-bottom:20px;">
            Questions about using ArborKin, your data, and how we keep it safe.
        </div>
        <MudTextField @bind-Value="_search"
                      Placeholder="Search questions…"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined"
                      Immediate="true"
                      Style="max-width:400px;" />
    </div>

    @* ── Sections ─────────────────────────────────────────────────────────── *@
    @foreach (var section in FilteredSections)
    {
        if (!section.Items.Any()) continue;

        <div style="margin-bottom:36px;">
            <div style="display:flex; align-items:center; gap:8px; margin-bottom:12px;
                padding-bottom:8px; border-bottom:1px solid var(--ft-line-border);">
                <MudIcon Icon="@section.Icon"
                         Style="font-size:18px; color:var(--ft-green-600);" />
                <span style="font-size:13px; font-weight:700; text-transform:uppercase;
                    letter-spacing:0.08em; color:var(--ft-gray-500);">
                    @section.Title
                </span>
            </div>

            <MudExpansionPanels Elevation="0">
                @foreach (var item in section.Items)
                {
                    <MudExpansionPanel Style="background:var(--ft-surface-card); margin-bottom:4px;
                        border-radius:var(--ft-radius-sm); border:0.5px solid var(--ft-line-border);">
                        <TitleContent>
                            <div style="font-size:14px; font-weight:500; color:var(--ft-gray-700);">
                                @item.Q
                            </div>
                        </TitleContent>
                        <ChildContent>
                            <div style="font-size:13px; color:var(--ft-gray-500); line-height:1.75;
                                padding:4px 0 8px;">
                                @((MarkupString)item.A)
                            </div>
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        </div>
    }

    @* ── Still have questions ─────────────────────────────────────────────── *@
    <MudPaper Elevation="0" Class="pa-5"
              Style="background:var(--ft-green-50); border-radius:var(--ft-radius-card);
        border:1px solid var(--ft-green-100); text-align:center;">
        <MudIcon Icon="@Icons.Material.Outlined.ChatBubbleOutline"
                 Style="font-size:28px; color:var(--ft-green-600); margin-bottom:8px; display:block;" />
        <div style="font-size:15px; font-weight:600; color:var(--ft-green-800); margin-bottom:6px;">
            Still have a question?
        </div>
        <div style="font-size:13px; color:var(--ft-gray-500); margin-bottom:16px;">
            Use the feature request form — it doubles as a help channel.
        </div>
        <MudButton Color="Color.Primary" Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Outlined.Send"
                   Href="/dashboard">
            Go to dashboard
        </MudButton>
    </MudPaper>

</div>

@code {
    private string _search = "";

    private record FaqItem(string Q, string A);
    private record FaqSection(string Title, string Icon, List<FaqItem> Items);

    private readonly List<FaqSection> _sections =
    [
        new("Getting started", Icons.Material.Outlined.Rocket, [
            new("What is ArborKin?",
                "ArborKin is a private web app for building and browsing your family tree. You can add people, connect relationships, share stories, upload photos and documents, and see several generations on an interactive canvas."),
            new("Do I need an account?",
                "Yes. ArborKin is invite-only. Someone already on the tree sends you an invitation, and you create an account from the link in it. If your invite link has expired or was already used, ask whoever invited you for a new one."),
            new("Is this the same as Ancestry or MyHeritage?",
                "No. Those are commercial platforms that own your data and require subscriptions. ArborKin is independent, ad-free, and keeps your family's data private. We don't sell or share anything."),
            new("Can I import data from Ancestry or another app?",
                "Not at the moment. Importing from GEDCOM files is switched off for now. To add people, use Add person, or ask the family admin."),
        ]),

        new("Privacy & security", Icons.Material.Outlined.Security, [
            new("Who can see my family tree?",
                "Only people who have been invited to your family's tree and have signed in. Each family's tree is separate: someone in another family can't see yours. The family admin and the site owner can see everything in a tree."),
            new("Is my data encrypted?",
                "Yes. Data is encrypted at rest by Azure SQL Transparent Data Encryption and in transit by HTTPS (TLS 1.2 or newer). Profile photos and uploaded documents are kept in private Azure Blob Storage and are only shown to signed-in members of the person's own family."),
            new("Do you share my data with third parties?",
                "No. We do not sell, share, license, or analyze your family data for any commercial purpose. Your family history belongs to you."),
            new("Do you use tracking or analytics?",
                "There are no advertising trackers or analytics scripts on the site. The app keeps an audit log of changes made to the tree (who changed what, and when) that only the site owner can read, and server logs for error and uptime monitoring."),
            new("Where is my data stored?",
                "Your data is stored on Microsoft Azure infrastructure. The database keeps backups for 7 days."),
            new("What happens if the site goes down?",
                "The database is backed up automatically, and you can download a copy of your tree at any time from the Dashboard (GEDCOM export). This is a family project, not a commercial service, so there is no guarantee against data loss. We recommend downloading a copy now and then."),
        ]),

        new("Your data", Icons.Material.Outlined.Storage, [
            new("How do I delete my account?",
                "There is no self-service account deletion yet. Send a message to the admin from the Dashboard (Contact the admin) and they will take care of it."),
            new("Can I export my family tree?",
                "Yes. The Dashboard has a GEDCOM (.ged) download, the standard format that other genealogy apps can read. Excel, CSV, and PDF exports are not available yet."),
            new("What file formats can I upload for photos?",
                "JPEG, PNG, WebP, and GIF are supported, up to 50 MB per file."),
            new("Can I upload documents like birth certificates or old letters?",
                "Yes — the Photos & Records section on each person's profile accepts PDFs and images. You can categorize them (birth certificate, marriage record, military service, etc.) and add captions."),
            new("Is there a limit on how many people I can add?",
                "There is no hard limit in the current version. Very large trees (thousands of people) may affect tree rendering performance — we're working on improvements for that."),
        ]),

        new("Technical questions", Icons.Material.Outlined.Code, [
            new("What technology powers ArborKin?",
                "ArborKin is built on .NET 10 with Blazor Server (C#), MudBlazor for UI components, Entity Framework Core for data access, and SQL Server / Azure SQL for storage. The tree visualization is rendered entirely in C# with SVG — no JavaScript layout library."),
            new("Is this open source?",
                "The source code is public on GitHub (shalant/FamilyTree)."),
            new("Why does the tree take a moment to load?",
                "ArborKin uses Blazor Server, which runs logic on the server and streams UI updates over a WebSocket. The first load establishes that connection. Subsequent interactions are fast."),
            new("Does it work on mobile?",
                "Yes. The tree canvas works with touch (drag to pan, pinch to zoom), and the menus and forms are laid out for a phone screen."),
        ]),
    ];

    private IEnumerable<FaqSection> FilteredSections
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_search)) return _sections;
            var q = _search.Trim();
            return _sections.Select(s => s with
            {
                Items = s.Items.Where(i =>
                    i.Q.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    i.A.Contains(q, StringComparison.OrdinalIgnoreCase)).ToList()
            });
        }
    }
}
