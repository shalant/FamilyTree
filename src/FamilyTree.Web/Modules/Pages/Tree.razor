@page "/tree"
@rendermode InteractiveServer

@using FamilyTree.Api.Services
@using FamilyTree.Shared.DTOs
@using FamilyTree.Shared.DTOs.Person
@using FamilyTree.Web.Modules.Components
@using FamilyTree.Web.Services
@using MudBlazor

@inject IPersonService PersonService
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Family tree</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Success" />
}
else if (!_people.Any())
{
    <MudAlert Severity="Severity.Info" Class="ma-4">
        No people added yet.
        <MudLink Href="/people/add">Add the first family member.</MudLink>
    </MudAlert>
}
else
{
    <!-- Page header floating on top with glass effect -->
    <div style="position:fixed; top:20px; right:20px; z-index:5000; pointer-events:auto;">
        <div style="background:rgba(255,255,255,0.7); backdrop-filter:blur(10px); padding:16px 24px; border-radius:12px; border:1px solid rgba(255,255,255,0.3); box-shadow:0 8px 32px rgba(0,0,0,0.1);">
            <div style="font-size:14px; font-weight:500; color:var(--ft-text-primary);">
                @if (FocusPerson is not null)
                {
                    <span>@FocusPerson.FirstName's family tree</span>
                    @if (FocusPerson.BirthDate.HasValue)
                    {
                        <span style="color:var(--ft-text-muted); font-size:12px;"> · @FocusPerson.BirthDate.Value.Year</span>
                    }
                }
            </div>
        </div>
    </div>

    <div id="tree-viewport" class="tree-viewport">
         @* style="position:fixed; top:0; left:0; width:100%; height:100%; background:var(--ft-surface); overflow:hidden; z-index:1;"> *@

        <!-- Canvas fills entire viewport -->
        <FamilyTreeCanvas @ref="_canvas"
                          People="_people"
                          Couples="_couples"
                          FocusId="_focusId"
                          VisibleYearRange="_visibleYearRange"
                          OnPersonSelected="OpenDetail"
                          OnVisibleYearRangeChanged="@(y => _visibleYearRange = y)" />

        <!-- Toolbar floats on top as overlay -->
        <div style="position:fixed; top:20px; left:20px; z-index:10000; pointer-events:auto;">
            <CustomToolbar YearRange="_visibleYearRange"
                           OnYearRangeChanged="@(y => _canvas?.SetVisibleYearRange(y))" />
        </div>
    </div>
}

<PersonDetailDrawer Person="_detailPerson"
                    AllPeople="_people"
                    OnClose="() => _detailPerson = null"
                    OnEdit="@(p => Nav.NavigateTo($"/people/{p.Id}/edit"))"
                    OnFocusPerson="@(p => HandleFocusPerson(p))"
                    OnDelete="PromptDelete" />

@code {
    private List<PersonDto> _people = [];
    private List<CoupleDto> _couples = [];
    private PersonDto? _detailPerson;
    private bool _loading = true;
    private Guid? _focusId;
    private int _visibleYearRange = 100;
    private FamilyTreeCanvas? _canvas;

    private PersonDto? FocusPerson =>
        _people.FirstOrDefault(p => p.Id == _focusId);

    protected override async Task OnInitializedAsync()
    {
        var result = await PersonService.GetAllAsync();
        if (result.Success)
        {
            _people = result.Data!;
            _couples = DeriveCouples(_people);   // move to CoupleHelper once auth lands
        }
        else
        {
            Snackbar.Add(result.Message, Severity.Error);
        }

        // TODO: replace with authenticated user's saved focus id
        // Try to focus on Ava first, then fall back to youngest person
        var ava = _people.FirstOrDefault(p => p.FirstName == "Ava");
        if (ava != null)
            _focusId = ava.Id;
        else
            _focusId = _people.OrderByDescending(p => p.BirthDate).FirstOrDefault()?.Id;

        _loading = false;
    }

    // Derives spouse pairs that share at least one child.
    // Identical to People.razor — consolidate into CoupleHelper when auth is added.
    private static List<CoupleDto> DeriveCouples(List<PersonDto> people)
    {
        var coupleMap = new Dictionary<(Guid, Guid), List<Guid>>();

        foreach (var person in people)
        {
            if (person.ParentIds is null || person.ParentIds.Count < 2) continue;

            for (int i = 0; i < person.ParentIds.Count - 1; i++)
            {
                for (int j = i + 1; j < person.ParentIds.Count; j++)
                {
                    var a = person.ParentIds[i];
                    var b = person.ParentIds[j];
                    var key = a.CompareTo(b) < 0 ? (a, b) : (b, a);

                    if (!coupleMap.ContainsKey(key))
                        coupleMap[key] = [];

                    coupleMap[key].Add(person.Id);
                }
            }
        }

        return coupleMap.Select(kvp => new CoupleDto
        {
            PersonAId = kvp.Key.Item1,
            PersonBId = kvp.Key.Item2,
            ChildIds = kvp.Value
        }).ToList();
    }

    private void OpenDetail(PersonDto? person)
    {
        if (person is null) return;
        _detailPerson = person;
    }

    private void HandleFocusPerson(PersonDto person)
    {
        _focusId = person.Id;
        _detailPerson = null;
    }

    private async Task PromptDelete(PersonDto person)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Message,      $"Delete {person.FullName}? This cannot be undone." },
            { x => x.ConfirmLabel, "Delete" }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete person", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            var response = await PersonService.DeleteAsync(person.Id);
            Snackbar.ShowResult(response, $"{person.FullName} deleted.");

            if (response.Success)
            {
                var refresh = await PersonService.GetAllAsync();
                if (refresh.Success)
                {
                    _people = refresh.Data!;
                    _couples = DeriveCouples(_people);
                }
                _detailPerson = null;
            }
        }
    }
}
