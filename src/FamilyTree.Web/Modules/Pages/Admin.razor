    private sealed class DeletedPersonRow(PersonDto dto)
    {
        public Guid      Id        { get; } = dto.Id;
        public string    FullName  { get; } = dto.FullName;
        public DateTime? DeletedAt { get; } = dto.DeletedAt;
        public DateOnly? BirthDate { get; } = dto.BirthDate;
    }
