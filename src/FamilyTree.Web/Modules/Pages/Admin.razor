@page "/admin"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin,SuperUser")]

@using FamilyTree.Core.Data
@using FamilyTree.Core.Models
@using FamilyTree.Core.Services
@using FamilyTree.Shared.DTOs.Person
@using FamilyTree.Shared.DTOs.Story
@using FamilyTree.Web.Modules.Components
@using FamilyTree.Web.Services
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using MudBlazor

@inject IPersonService PersonService
@inject IAuthService AuthService
@inject IImportService ImportService
@inject IUserMessageService MessageService
@inject IStoryService StoryService
@inject IDbContextFactory<AppDbContext> DbFactory
@inject UserManager<AppUser> UserManager
@inject ToastService Toast
@inject NavigationManager NavManager
@inject IJSRuntime JS
@inject IDialogService DialogService

<PageTitle>Admin</PageTitle>

<style>
    .ft-admin-stat { transition: box-shadow 0.15s; cursor: default; }
    .ft-admin-stat:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.08) !important; }
    .ft-admin-nav-row { transition: background 0.1s; border-radius: 8px; cursor: pointer; }
    .ft-admin-nav-row:hover { background: var(--ft-green-50) !important; }
</style>

<div style="padding:24px; max-width:1100px; margin:auto;">

    <div style="margin-bottom:24px;">
        <div style="font-size:22px; font-weight:600; font-style:italic;
            font-family:var(--ft-font-display); color:var(--ft-green-800); line-height:1.2;">
            Admin
        </div>
        <div style="font-size:13px; color:var(--ft-gray-400); margin-top:2px;">
            Arborkin system management
        </div>
    </div>

    <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true"
             @bind-ActivePanelIndex="_activeTab">

        @* ═══════════════════════════════════════════════════════════════════
            TAB 0 — DASHBOARD
           ═══════════════════════════════════════════════════════════════════ *@
        <MudTabPanel Text="Dashboard" Icon="@Icons.Material.Outlined.SpaceDashboard">

            @if (_loading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Success" Class="mb-4" />
            }
            else
            {
                @* ── Stat cards ────────────────────────────────────────────── *@
                <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:28px;">

                    <div class="ft-admin-stat" style="padding:18px 20px; border-radius:10px;
                        background:var(--ft-surface-card);" @onclick='() => GoToTab(1)'>
                        <div style="display:flex; align-items:center; gap:8px; margin-bottom:6px;">
                            <MudIcon Icon="@Icons.Material.Outlined.People"
                                     Style="font-size:18px; color:var(--ft-green-600);" />
                            <span style="font-size:11px; color:var(--ft-gray-400); text-transform:uppercase; letter-spacing:.06em;">
                                People
                            </span>
                        </div>
                        <div style="font-size:28px; font-weight:700; color:var(--ft-green-800); line-height:1;">
                            @_totalPeople
                        </div>
                        @if (_deletedCount > 0)
                        {
                            <div style="font-size:11px; color:var(--mud-palette-warning); margin-top:4px;">
                                @_deletedCount deleted
                            </div>
                        }
                        else
                        {
                            <div style="font-size:11px; color:var(--ft-gray-300); margin-top:4px;">
                                none deleted
                            </div>
                        }
                    </div>

                    <div class="ft-admin-stat" style="padding:18px 20px; border-radius:10px;
                        background:var(--ft-surface-card);" @onclick='() => GoToTab(3)'>
                        <div style="display:flex; align-items:center; gap:8px; margin-bottom:6px;">
                            <MudIcon Icon="@Icons.Material.Outlined.History"
                                     Style="font-size:18px; color:var(--ft-green-600);" />
                            <span style="font-size:11px; color:var(--ft-gray-400); text-transform:uppercase; letter-spacing:.06em;">
                                Audit entries
                            </span>
                        </div>
                        <div style="font-size:28px; font-weight:700; color:var(--ft-green-800); line-height:1;">
                            @_totalAuditEntries
                        </div>
                        <div style="font-size:11px; color:var(--ft-gray-300); margin-top:4px;">
                            @_auditEntriesToday today
                        </div>
                    </div>

                    <div class="ft-admin-stat" style="padding:18px 20px; border-radius:10px;
                        background:var(--ft-surface-card);" @onclick='() => GoToTab(2)'>
                        <div style="display:flex; align-items:center; gap:8px; margin-bottom:6px;">
                            <MudIcon Icon="@Icons.Material.Outlined.Group"
                                     Style="font-size:18px; color:var(--ft-green-600);" />
                            <span style="font-size:11px; color:var(--ft-gray-400); text-transform:uppercase; letter-spacing:.06em;">
                                Users
                            </span>
                        </div>
                        <div style="font-size:28px; font-weight:700; color:var(--ft-green-800); line-height:1;">
                            @_userCount
                        </div>
                        <div style="font-size:11px; color:var(--ft-gray-300); margin-top:4px;">
                            @_pendingInvites pending invite@(_pendingInvites == 1 ? "" : "s")
                        </div>
                    </div>

                    <div class="ft-admin-stat" style="padding:18px 20px; border-radius:10px;
                        background:var(--ft-surface-card);">
                        <div style="display:flex; align-items:center; gap:8px; margin-bottom:6px;">
                            <MudIcon Icon="@Icons.Material.Outlined.FamilyRestroom"
                                     Style="font-size:18px; color:var(--ft-green-600);" />
                            <span style="font-size:11px; color:var(--ft-gray-400); text-transform:uppercase; letter-spacing:.06em;">
                                Families
                            </span>
                        </div>
                        <div style="font-size:28px; font-weight:700; color:var(--ft-green-800); line-height:1;">
                            @_familyCount
                        </div>
                        <div style="font-size:11px; color:var(--ft-gray-300); margin-top:4px;">
                            @_totalRelationships relationships
                        </div>
                    </div>

                </div>

                @* ── Two-column body ───────────────────────────────────────── *@
                <div style="display:grid; grid-template-columns:2fr 1fr; gap:20px;">

                    @* Recent activity *@
                    <MudPaper Elevation="0" Class="pa-4"
                              Style="background:var(--ft-surface-card); border-radius:var(--ft-radius-card);">
                        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:16px;">
                            <div style="font-size:11px; font-weight:700; text-transform:uppercase;
                                letter-spacing:.1em; color:var(--ft-green-600);">
                                Recent activity
                            </div>
                            <MudButton Variant="Variant.Text" Size="Size.Small"
                                       Style="color:var(--ft-green-600); font-size:12px;"
                                       OnClick='() => GoToTab(3)'>
                                View all
                            </MudButton>
                        </div>

                        @if (_recentAudit.Count == 0)
                        {
                            <div style="text-align:center; padding:24px 0;
                                font-size:13px; color:var(--ft-gray-300);">
                                No activity yet.
                            </div>
                        }
                        else
                        {
                            @foreach (var entry in _recentAudit)
                            {
                                <div style="display:flex; align-items:center; gap:10px;
                                    padding:8px 0; border-bottom:.5px solid var(--ft-line-border);">
                                    <div style="width:28px; height:28px; border-radius:50%; flex-shrink:0;
                                        background:@AuditChipBg(entry.Action);
                                        display:flex; align-items:center; justify-content:center;">
                                        <MudIcon Icon="@AuditIcon(entry.Action)"
                                                 Style="@($"font-size:14px; color:{AuditIconColor(entry.Action)};")" />
                                    </div>
                                    <div style="flex:1; min-width:0;">
                                        <div style="font-size:13px; color:var(--ft-gray-700);">
                                            <strong>@entry.Action</strong>
                                            <span style="color:var(--ft-gray-400);"> · </span>
                                            @entry.EntityType
                                        </div>
                                        <div style="font-size:11px; color:var(--ft-gray-300);">
                                            @entry.Timestamp.ToLocalTime().ToString("MMM d, h:mm tt")
                                        </div>
                                    </div>
                                    <div style="font-size:11px; font-family:monospace; color:var(--ft-gray-300);">
                                        @(entry.EntityId.HasValue ? entry.EntityId.Value.ToString()[..6] : "—")
                                    </div>
                                </div>
                            }
                        }
                    </MudPaper>

                    @* Quick navigation *@
                    <MudPaper Elevation="0" Class="pa-4"
                              Style="background:var(--ft-surface-card); border-radius:var(--ft-radius-card);">
                        <div style="font-size:11px; font-weight:700; text-transform:uppercase;
                            letter-spacing:.1em; color:var(--ft-green-600); margin-bottom:16px;">
                            Manage
                        </div>

                        <div class="ft-admin-nav-row" style="display:flex; align-items:center; gap:10px;
                            padding:10px 8px;" @onclick='() => GoToTab(1)'>
                            <MudIcon Icon="@Icons.Material.Outlined.DeleteSweep"
                                     Style="font-size:20px; color:var(--ft-gray-400);" />
                            <div>
                                <div style="font-size:13px; color:var(--ft-gray-700);">Deleted people</div>
                                <div style="font-size:11px; color:var(--ft-gray-300);">
                                    @(_deletedCount > 0 ? $"{_deletedCount} awaiting review" : "Nothing deleted")
                                </div>
                            </div>
                            @if (_deletedCount > 0)
                            {
                                <MudBadge Content="@_deletedCount" Color="Color.Warning"
                                          Style="margin-left:auto;" />
                            }
                        </div>

                        <div class="ft-admin-nav-row" style="display:flex; align-items:center; gap:10px;
                            padding:10px 8px;" @onclick='() => GoToTab(2)'>
                            <MudIcon Icon="@Icons.Material.Outlined.Group"
                                     Style="font-size:20px; color:var(--ft-gray-400);" />
                            <div>
                                <div style="font-size:13px; color:var(--ft-gray-700);">Users</div>
                                <div style="font-size:11px; color:var(--ft-gray-300);">
                                    @(_userCount == 0 ? "Ready for auth" : $"{_userCount} registered")
                                </div>
                            </div>
                        </div>

                        <div class="ft-admin-nav-row" style="display:flex; align-items:center; gap:10px;
                            padding:10px 8px;" @onclick='() => GoToTab(3)'>
                            <MudIcon Icon="@Icons.Material.Outlined.History"
                                     Style="font-size:20px; color:var(--ft-gray-400);" />
                            <div>
                                <div style="font-size:13px; color:var(--ft-gray-700);">Audit log</div>
                                <div style="font-size:11px; color:var(--ft-gray-300);">
                                    @_totalAuditEntries entries total
                                </div>
                            </div>
                        </div>

                        <div class="ft-admin-nav-row" style="display:flex; align-items:center; gap:10px;
                            padding:10px 8px;" @onclick='() => GoToTab(4)'>
                            <MudIcon Icon="@Icons.Material.Outlined.BarChart"
                                     Style="font-size:20px; color:var(--ft-gray-400);" />
                            <div>
                                <div style="font-size:13px; color:var(--ft-gray-700);">Activity</div>
                                <div style="font-size:11px; color:var(--ft-gray-300);">Daily action counts</div>
                            </div>
                        </div>

                        <div style="margin-top:20px; padding-top:16px;
                            border-top:.5px solid var(--ft-line-border);">
                            <div style="font-size:11px; font-weight:700; text-transform:uppercase;
                                letter-spacing:.1em; color:var(--ft-green-600); margin-bottom:12px;">
                                Navigate
                            </div>
                            <div class="ft-admin-nav-row" style="display:flex; align-items:center; gap:10px;
                                padding:10px 8px;" @onclick='() => NavManager.NavigateTo("/")'>
                                <MudIcon Icon="@Icons.Material.Outlined.AccountTree"
                                         Style="font-size:20px; color:var(--ft-gray-400);" />
                                <div style="font-size:13px; color:var(--ft-gray-700);">Back to tree</div>
                            </div>
                            <div class="ft-admin-nav-row" style="display:flex; align-items:center; gap:10px;
                                padding:10px 8px;" @onclick='() => NavManager.NavigateTo("/dashboard")'>
                                <MudIcon Icon="@Icons.Material.Outlined.SpaceDashboard"
                                         Style="font-size:20px; color:var(--ft-gray-400);" />
                                <div style="font-size:13px; color:var(--ft-gray-700);">Family dashboard</div>
                            </div>
                        </div>
                    </MudPaper>

                </div>
            }
        </MudTabPanel>

        @* ═══════════════════════════════════════════════════════════════════
            TAB 1 — DELETED PEOPLE
           ═══════════════════════════════════════════════════════════════════ *@
        <MudTabPanel Text="Deleted" Icon="@Icons.Material.Outlined.DeleteSweep"
                     BadgeData="@(_deletedCount > 0 ? _deletedCount : null)"
                     BadgeColor="Color.Warning">

            @if (_loadingDeleted)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (_deleted.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    No deleted people. Soft-deleted records will appear here for review and restore.
                </MudAlert>
            }
            else
            {
                <MudTable Items="_deleted" Hover="true" Dense="true"
                          Style="background:var(--ft-surface-card);">
                    <HeaderContent>
                        <MudTh>Name</MudTh>
                        <MudTh>Deleted</MudTh>
                        <MudTh>Born</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.FullName</MudTd>
                        <MudTd>
                            <MudText Typo="Typo.caption" Style="color:var(--ft-text-muted);">
                                @context.DeletedAt?.ToString("MMM d, yyyy h:mm tt")
                            </MudText>
                        </MudTd>
                        <MudTd>
                            <MudText Typo="Typo.caption">
                                @(context.BirthDate?.ToString("yyyy") ?? "—")
                            </MudText>
                        </MudTd>
                        <MudTd Style="text-align:right;">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Outlined.RestoreFromTrash"
                                       OnClick="@(() => RestorePersonAsync(context))">
                                Restore
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudTabPanel>

        @* ═══════════════════════════════════════════════════════════════════
            TAB 2 — USERS
           ═══════════════════════════════════════════════════════════════════ *@
        <MudTabPanel Text="Users" Icon="@Icons.Material.Outlined.Group">

            @* ── Invite section ──────────────────────────────────────────── *@
            <MudPaper Elevation="0" Class="pa-4 mb-4"
                      Style="background:var(--ft-surface-card); border-radius:var(--ft-radius-card);">
                <div style="font-size:11px; font-weight:700; text-transform:uppercase;
                    letter-spacing:.1em; color:var(--ft-green-600); margin-bottom:14px;">
                    Invite someone
                </div>

                <div style="max-width:520px;">
                    <div style="font-size:12px; color:var(--ft-text-muted); margin-bottom:6px;">
                        Email address
                    </div>
                    <div style="display:flex; gap:10px; align-items:stretch;">
                        <MudTextField @bind-Value="_inviteEmail"
                                      Placeholder="user@example.com"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.None"
                                      InputType="InputType.Email"
                                      Style="flex:1;"
                                      Disabled="_creatingInvite" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Outlined.Send"
                                   Style="flex-shrink:0;"
                                   OnClick="CreateInviteAsync"
                                   Disabled="@(_creatingInvite || string.IsNullOrWhiteSpace(_inviteEmail))">
                            Generate link
                        </MudButton>
                    </div>
                </div>

                @if (_inviteError is not null)
                {
                    <div style="font-size:13px; color:var(--mud-palette-error); margin-top:8px;">
                        @_inviteError
                    </div>
                }

                @if (_inviteLink is not null)
                {
                    <div style="margin-top:12px; padding:12px; border-radius:8px;
                        background:rgba(76,175,80,0.08); border:1px solid rgba(76,175,80,0.25);">
                        <div style="font-size:11px; color:var(--ft-gray-400); margin-bottom:6px;">
                            Send this link to @_inviteEmail — expires in @_config_ttl days
                        </div>
                        <div style="display:flex; gap:8px; align-items:center;">
                            <code style="font-size:12px; color:var(--ft-green-800); word-break:break-all; flex:1;">
                                @_inviteLink
                            </code>
                            <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy"
                                           Size="Size.Small"
                                           OnClick="CopyInviteLink"
                                           Style="flex-shrink:0;" />
                        </div>
                    </div>
                }
            </MudPaper>

            @* ── Pending invites ──────────────────────────────────────────── *@
            @if (_pendingInvitesList.Count > 0)
            {
                <MudPaper Elevation="0" Class="pa-4 mb-4"
                          Style="background:var(--ft-surface-card); border-radius:var(--ft-radius-card);">
                    <div style="font-size:11px; font-weight:700; text-transform:uppercase;
                        letter-spacing:.1em; color:var(--ft-green-600); margin-bottom:14px;">
                        Pending invites
                    </div>
                    @foreach (var inv in _pendingInvitesList)
                    {
                        <div style="display:flex; align-items:center; gap:8px; padding:8px 0;
                            border-bottom:.5px solid var(--ft-line-border); max-width:520px;">
                            <div style="min-width:0; flex:1;">
                                <div style="font-size:13px; color:var(--ft-gray-700); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@inv.Email</div>
                                <div style="font-size:11px; color:var(--ft-gray-300);">
                                    Expires @inv.ExpiresAt.ToLocalTime().ToString("MMM d, yyyy")
                                </div>
                            </div>
                            <MudTooltip Text="Copy invite link">
                                <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy"
                                               Size="Size.Small"
                                               OnClick="@(() => CopyInviteLinkFor(inv.Id))" />
                            </MudTooltip>
                            <MudTooltip Text="Cancel invite">
                                <MudIconButton Icon="@Icons.Material.Outlined.Cancel"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               OnClick="@(() => CancelInviteAsync(inv.Id))" />
                            </MudTooltip>
                        </div>
                    }
                </MudPaper>
            }

            @* ── Pending password resets ──────────────────────────────────── *@
            @if (_pendingResets.Count > 0)
            {
                <MudPaper Elevation="0" Class="pa-4 mb-4"
                          Style="background:var(--ft-surface-card); border-radius:var(--ft-radius-card);">
                    <div style="font-size:11px; font-weight:700; text-transform:uppercase;
                        letter-spacing:.1em; color:var(--mud-palette-warning-text); margin-bottom:14px;">
                        Pending password resets
                    </div>
                    @foreach (var req in _pendingResets)
                    {
                        <div style="display:flex; align-items:center; gap:8px; padding:8px 0;
                            border-bottom:.5px solid var(--ft-line-border); max-width:520px;">
                            <div style="min-width:0; flex:1;">
                                <div style="font-size:13px; color:var(--ft-gray-700);">@req.Email</div>
                                <div style="font-size:11px; color:var(--ft-gray-300);">
                                    Requested @req.CreatedAt.ToLocalTime().ToString("MMM d, h:mm tt") · expires @req.ExpiresAt.ToLocalTime().ToString("h:mm tt")
                                </div>
                            </div>
                            <MudTooltip Text="Copy reset link">
                                <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy"
                                               Size="Size.Small"
                                               OnClick="@(() => CopyResetLink(req))" />
                            </MudTooltip>
                            <MudTooltip Text="Dismiss">
                                <MudIconButton Icon="@Icons.Material.Outlined.Close"
                                               Size="Size.Small"
                                               OnClick="@(() => DismissResetAsync(req.Id))" />
                            </MudTooltip>
                        </div>
                    }
                </MudPaper>
            }

            @* ── Registered users ─────────────────────────────────────────── *@
            @if (_loadingUsers)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (_users.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    No users yet. User accounts will appear here once authentication is enabled.
                </MudAlert>
            }
            else
            {
                <MudPaper Elevation="0" Style="background:var(--ft-surface-card); border-radius:var(--ft-radius-card);">
                    <MudTable Items="_users" Hover="true" Dense="true"
                              Style="background:transparent;">
                        <HeaderContent>
                            <MudTh>Email</MudTh>
                            <MudTh>Display name</MudTh>
                            <MudTh>Role</MudTh>
                            <MudTh>Linked person</MudTh>
                            <MudTh>Last login</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.Email</MudTd>
                            <MudTd Style="min-width:200px;">
                                @if (_editingUserId == context.Id)
                                {
                                    <div style="display:flex; align-items:center; gap:4px;">
                                        <MudTextField @bind-Value="_editingDisplayName"
                                                      Variant="Variant.Text"
                                                      Margin="Margin.Dense"
                                                      Style="font-size:13px;"
                                                      @onkeydown="@(async e => { if (e.Key == "Enter") await SaveDisplayNameAsync(context.Id); if (e.Key == "Escape") _editingUserId = null; })" />
                                        <MudIconButton Icon="@Icons.Material.Outlined.Check"
                                                       Size="Size.Small" Color="Color.Success"
                                                       OnClick="@(() => SaveDisplayNameAsync(context.Id))" />
                                        <MudIconButton Icon="@Icons.Material.Outlined.Close"
                                                       Size="Size.Small"
                                                       OnClick="@(() => _editingUserId = null)" />
                                    </div>
                                }
                                else
                                {
                                    <div style="display:flex; align-items:center; gap:4px; cursor:default;">
                                        <span>@(context.DisplayName ?? "—")</span>
                                        <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                                       Size="Size.Small"
                                                       Style="opacity:0.4;"
                                                       OnClick="@(() => { _editingUserId = context.Id; _editingDisplayName = context.DisplayName ?? ""; })" />
                                    </div>
                                }
                            </MudTd>
                            <MudTd>
                                @if (context.IsSuperUser)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Error">Super-user</MudChip>
                                }
                                else
                                {
                                    <MudSelect T="string"
                                               Value="@GetPrimaryRole(context)"
                                               ValueChanged="@(v => SetRoleAsync(context, v))"
                                               Dense="true"
                                               Margin="Margin.Dense"
                                               Variant="Variant.Text"
                                               Style="font-size:13px; min-width:90px;">
                                        <MudSelectItem Value="@("Member")">Member</MudSelectItem>
                                        <MudSelectItem Value="@("Admin")">Admin</MudSelectItem>
                                    </MudSelect>
                                }
                            </MudTd>
                            <MudTd Style="min-width:200px;">
                                <MudSelect T="Guid?"
                                           Value="_personLinks.GetValueOrDefault(context.Id)"
                                           ValueChanged="@(v => SetPersonLink(context.Id, v))"
                                           Dense="true"
                                           Margin="Margin.Dense"
                                           Variant="Variant.Text"
                                           Placeholder="— Unlinked —"
                                           Style="font-size:13px;">
                                    <MudSelectItem T="Guid?" Value="@((Guid?)null)">— Unlinked —</MudSelectItem>
                                    @foreach (var p in _people.OrderBy(p => p.FullName))
                                    {
                                        <MudSelectItem T="Guid?" Value="@((Guid?)p.Id)">@p.FullName</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudTd>
                            <MudTd>
                                <MudText Typo="Typo.caption" Style="color:var(--ft-text-muted);">
                                    @(context.LastLoginAt?.ToString("MMM d, yyyy") ?? "—")
                                </MudText>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            }
        </MudTabPanel>

        @* ═══════════════════════════════════════════════════════════════════
            TAB 3 — AUDIT LOG
           ═══════════════════════════════════════════════════════════════════ *@
        <MudTabPanel Text="Audit log" Icon="@Icons.Material.Outlined.History">

            @if (_loadingAudit)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (_auditLogs.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    No audit log entries yet. Create, update, and delete actions will be recorded here.
                </MudAlert>
            }
            else
            {
                <div style="display:flex; gap:12px; margin-bottom:12px; flex-wrap:wrap; align-items:center;">
                    <MudSelect T="string" Label="Action" @bind-Value="_auditActionFilter"
                               Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense"
                               Style="max-width:160px;" Clearable="true">
                        <MudSelectItem Value="@("Create")">Create</MudSelectItem>
                        <MudSelectItem Value="@("Update")">Update</MudSelectItem>
                        <MudSelectItem Value="@("Delete")">Delete</MudSelectItem>
                        <MudSelectItem Value="@("Restore")">Restore</MudSelectItem>
                        <MudSelectItem Value="@("Login")">Login</MudSelectItem>
                        <MudSelectItem Value="@("RoleChange")">Role change</MudSelectItem>
                    </MudSelect>
                    <MudSelect T="string" Label="Entity" @bind-Value="_auditEntityFilter"
                               Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense"
                               Style="max-width:160px;" Clearable="true">
                        <MudSelectItem Value="@("Person")">Person</MudSelectItem>
                        <MudSelectItem Value="@("Relationship")">Relationship</MudSelectItem>
                        <MudSelectItem Value="@("Medium")">Medium</MudSelectItem>
                        <MudSelectItem Value="@("User")">User</MudSelectItem>
                    </MudSelect>
                    <MudText Typo="Typo.caption" Style="color:var(--ft-text-muted); margin-left:auto;">
                        @FilteredAuditLogs.Count of @_auditLogs.Count entries
                    </MudText>
                </div>

                <MudTable Items="FilteredAuditLogs" Hover="true" Dense="true"
                          Style="background:var(--ft-surface-card);">
                    <HeaderContent>
                        <MudTh>Timestamp</MudTh>
                        <MudTh>Action</MudTh>
                        <MudTh>Entity</MudTh>
                        <MudTh>Entity ID</MudTh>
                        <MudTh>User</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <MudText Typo="Typo.caption">
                                @context.Timestamp.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                            </MudText>
                        </MudTd>
                        <MudTd>
                            <MudChip T="string" Size="Size.Small" Color="@AuditChipColor(context.Action)">
                                @context.Action
                            </MudChip>
                        </MudTd>
                        <MudTd>@context.EntityType</MudTd>
                        <MudTd>
                            <MudText Typo="Typo.caption" Style="font-family:monospace;">
                                @(context.EntityId.HasValue ? context.EntityId.Value.ToString()[..8] + "…" : "—")
                            </MudText>
                        </MudTd>
                        <MudTd>
                            <MudText Typo="Typo.caption" Style="color:var(--ft-text-muted);">
                                @(context.UserId.HasValue ? context.UserId.Value.ToString()[..8] + "…" : "—")
                            </MudText>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudTabPanel>

        @* ═══════════════════════════════════════════════════════════════════
            TAB 4 — ACTIVITY
           ═══════════════════════════════════════════════════════════════════ *@
        <MudTabPanel Text="Activity" Icon="@Icons.Material.Outlined.BarChart">

            @if (_loadingActivity)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (_activity.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    No activity recorded yet. Daily action counts per user will appear here once users are active.
                </MudAlert>
            }
            else
            {
                <MudTable Items="_activity" Hover="true" Dense="true"
                          Style="background:var(--ft-surface-card);">
                    <HeaderContent>
                        <MudTh>Date</MudTh>
                        <MudTh>User</MudTh>
                        <MudTh>Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Date.ToString("MMM d, yyyy")</MudTd>
                        <MudTd>
                            <MudText Typo="Typo.caption" Style="color:var(--ft-text-muted);">
                                @(context.UserId.HasValue ? context.UserId.Value.ToString()[..8] + "…" : "—")
                            </MudText>
                        </MudTd>
                        <MudTd>@context.ActionCount</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudTabPanel>

        @* ═══════════════════════════════════════════════════════════════════
            TAB 5 — IMPORTS
           ═══════════════════════════════════════════════════════════════════ *@
        <MudTabPanel Text="Imports" Icon="@Icons.Material.Outlined.Upload">

            <ImportFormPanel />

            @* ── Import history ──────────────────────────────────────────────── *@
            @if (_importBatches.Count > 0)
            {
                <div style="margin-top:40px; padding-top:24px; border-top:1px solid var(--ft-line-border);">
                    <div style="font-size:11px; font-weight:700; text-transform:uppercase;
                        letter-spacing:.1em; color:var(--ft-green-600); margin-bottom:14px;">
                        Import history
                    </div>
                    <MudPaper Elevation="0" Style="background:var(--ft-surface-card); border-radius:var(--ft-radius-card);">
                        <MudTable Items="_importBatches" Hover="true" Dense="true"
                                  Style="background:transparent;">
                            <HeaderContent>
                                <MudTh>Date</MudTh>
                                <MudTh>People</MudTh>
                                <MudTh>Relationships</MudTh>
                                <MudTh>Status</MudTh>
                                <MudTh></MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</MudTd>
                                <MudTd>@context.PersonCount</MudTd>
                                <MudTd>@context.RelationshipCount</MudTd>
                                <MudTd>
                                    @if (context.RolledBackAt.HasValue)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default">
                                            Rolled back @context.RolledBackAt.Value.ToLocalTime().ToString("MMM d")
                                        </MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success">Active</MudChip>
                                    }
                                </MudTd>
                                <MudTd>
                                    @if (!context.RolledBackAt.HasValue)
                                    {
                                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                                   Color="Color.Error"
                                                   StartIcon="@Icons.Material.Outlined.Undo"
                                                   OnClick="@(() => ConfirmRollbackAsync(context))">
                                            Roll back
                                        </MudButton>
                                    }
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudPaper>
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                        Rolling back removes all people and relationships from that import. People are soft-deleted and can be restored individually from the Deleted tab.
                    </MudAlert>
                </div>
            }
        </MudTabPanel>

        @* ═══════════════════════════════════════════════════════════════════
            TAB — STORIES
           ═══════════════════════════════════════════════════════════════════ *@
        <MudTabPanel Text="Stories" Icon="@Icons.Material.Outlined.AutoStories">

            @if (_loadingStories)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else
            {
                <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color:var(--ft-gray-400);">
                    Manage stories
                </MudText>
                @if (_allStories.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4" Dense="true">
                        No stories yet.
                    </MudAlert>
                }
                else
                {
                    <MudPaper Elevation="0" Class="mb-4" Style="background:var(--ft-surface-card); border-radius:var(--ft-radius-card);">
                        <MudTable Items="_allStories" Hover="true" Dense="true" Style="background:transparent;">
                            <HeaderContent>
                                <MudTh Style="width:60px;">Order</MudTh>
                                <MudTh>About</MudTh>
                                <MudTh>Title</MudTh>
                                <MudTh>Memory</MudTh>
                                <MudTh>Submitted by</MudTh>
                                <MudTh>Status</MudTh>
                                <MudTh>Date</MudTh>
                                <MudTh></MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>
                                    <div style="display:flex; flex-direction:column;">
                                        <MudIconButton Icon="@Icons.Material.Outlined.KeyboardArrowUp"
                                                       Size="Size.Small"
                                                       Style="padding:0; min-width:24px; height:20px;"
                                                       OnClick="@(() => MoveStoryAsync(context.Id, -1))" />
                                        <MudIconButton Icon="@Icons.Material.Outlined.KeyboardArrowDown"
                                                       Size="Size.Small"
                                                       Style="padding:0; min-width:24px; height:20px;"
                                                       OnClick="@(() => MoveStoryAsync(context.Id, 1))" />
                                    </div>
                                </MudTd>
                                <MudTd Style="font-size:13px;">
                                    @(context.PersonId.HasValue
                                        ? _people.FirstOrDefault(p => p.Id == context.PersonId)?.FullName ?? "—"
                                        : context.UnlinkedPersonName)
                                </MudTd>
                                <MudTd Style="font-size:13px; font-weight:500;">@context.Title</MudTd>
                                <MudTd Style="font-size:12px; color:var(--ft-gray-400); max-width:280px;
                                    white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                    @context.Body
                                </MudTd>
                                <MudTd Style="font-size:12px; color:var(--ft-gray-400);">
                                    @(context.AuthorDisplayName ?? context.AuthorName ?? "Unknown")
                                </MudTd>
                                <MudTd>
                                    @if (!context.IsApproved)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">Pending</MudChip>
                                    }
                                    else if (context.IsHidden)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">Hidden</MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">Published</MudChip>
                                    }
                                </MudTd>
                                <MudTd Style="font-size:11px; color:var(--ft-gray-300);">
                                    @context.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")
                                </MudTd>
                                <MudTd>
                                    <div style="display:flex; align-items:center;">
                                        @if (!context.IsApproved)
                                        {
                                            <MudTooltip Text="Approve">
                                                <MudIconButton Icon="@Icons.Material.Outlined.CheckCircleOutline"
                                                               Color="Color.Success"
                                                               Size="Size.Small"
                                                               OnClick="@(() => ApproveStoryAsync(context.Id))" />
                                            </MudTooltip>
                                        }
                                        else
                                        {
                                            <MudTooltip Text="@(context.IsHidden ? "Show" : "Hide")">
                                                <MudIconButton Icon="@(context.IsHidden ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)"
                                                               Size="Size.Small"
                                                               OnClick="@(() => ToggleHiddenAsync(context.Id, !context.IsHidden))" />
                                            </MudTooltip>
                                        }
                                        <MudTooltip Text="Edit">
                                            <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                                           Size="Size.Small"
                                                           OnClick="@(() => EditStoryAsync(context))" />
                                        </MudTooltip>
                                        <MudTooltip Text="Delete">
                                            <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline"
                                                           Color="Color.Error"
                                                           Size="Size.Small"
                                                           OnClick="@(() => DeleteStoryAsync(context.Id))" />
                                        </MudTooltip>
                                    </div>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudPaper>
                }

                <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color:var(--ft-gray-400);">
                    Unlinked stories
                </MudText>
                @if (_unlinkedStories.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                        No unlinked stories.
                    </MudAlert>
                }
                else
                {
                    <MudPaper Elevation="0" Style="background:var(--ft-surface-card); border-radius:var(--ft-radius-card);">
                        <MudTable Items="_unlinkedStories" Hover="true" Dense="true" Style="background:transparent;">
                            <HeaderContent>
                                <MudTh>Typed name</MudTh>
                                <MudTh>Title</MudTh>
                                <MudTh>Link to person</MudTh>
                                <MudTh></MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd Style="font-size:13px;">@context.UnlinkedPersonName</MudTd>
                                <MudTd Style="font-size:13px; font-weight:500;">@context.Title</MudTd>
                                <MudTd>
                                    <MudAutocomplete T="PersonDto"
                                                      SearchFunc="SearchPeopleForLinking"
                                                      ValueChanged="@(p => HandleLinkSelection(context.Id, context.UnlinkedPersonName, p))"
                                                      ToStringFunc="@(p => p?.FullName ?? "")"
                                                      Placeholder="Search by name…"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      Dense="true">
                                        <ItemTemplate Context="p">
                                            @if (p.Id == Guid.Empty)
                                            {
                                                <div style="display:flex; align-items:center; gap:6px; color:var(--ft-green-600);">
                                                    <MudIcon Icon="@Icons.Material.Outlined.PersonAddAlt" Style="font-size:16px;" />
                                                    <span>Add someone new…</span>
                                                </div>
                                            }
                                            else
                                            {
                                                @p.FullName
                                            }
                                        </ItemTemplate>
                                    </MudAutocomplete>
                                </MudTd>
                                <MudTd>
                                    <MudTooltip Text="Link">
                                        <MudIconButton Icon="@Icons.Material.Outlined.Link"
                                                       Size="Size.Small"
                                                       Disabled="@(!_linkSelections.ContainsKey(context.Id))"
                                                       OnClick="@(() => LinkStoryAsync(context.Id))" />
                                    </MudTooltip>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudPaper>
                }
            }
        </MudTabPanel>

        <MudTabPanel Text="Messages" Icon="@Icons.Material.Outlined.MailOutline">

            @if (_loadingMessages)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (_messages.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    No messages yet.
                </MudAlert>
            }
            else
            {
                <MudPaper Elevation="0" Style="background:var(--ft-surface-card); border-radius:var(--ft-radius-card);">
                    <MudTable Items="_messages" Hover="true" Dense="true"
                              Style="background:transparent;">
                        <HeaderContent>
                            <MudTh>Type</MudTh>
                            <MudTh>From</MudTh>
                            <MudTh>Subject</MudTh>
                            <MudTh>Category</MudTh>
                            <MudTh>Priority</MudTh>
                            <MudTh>Date</MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <MudChip T="string" Size="Size.Small"
                                         Color="@(context.Type == "FeatureRequest" ? Color.Primary : Color.Default)">
                                    @(context.Type == "FeatureRequest" ? "Feature" : "Message")
                                </MudChip>
                            </MudTd>
                            <MudTd Style="font-size:12px; color:var(--ft-gray-400);">
                                @(string.IsNullOrWhiteSpace(context.SenderEmail) ? "—" : context.SenderEmail)
                            </MudTd>
                            <MudTd>
                                <div style="font-size:13px; font-weight:@(context.ReadAt == null ? "600" : "400");
                                    color:var(--ft-gray-700);">
                                    @context.Title
                                </div>
                                @if (!string.IsNullOrWhiteSpace(context.Body))
                                {
                                    <div style="font-size:11px; color:var(--ft-gray-300); margin-top:2px;
                                        white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:300px;">
                                        @context.Body
                                    </div>
                                }
                            </MudTd>
                            <MudTd Style="font-size:12px; color:var(--ft-gray-400);">
                                @(context.Category ?? "—")
                            </MudTd>
                            <MudTd Style="font-size:12px; color:var(--ft-gray-400);">
                                @(context.Priority ?? "—")
                            </MudTd>
                            <MudTd Style="font-size:11px; color:var(--ft-gray-300);">
                                @context.CreatedAt.ToLocalTime().ToString("MMM d, h:mm tt")
                            </MudTd>
                            <MudTd>
                                @if (context.ReadAt == null)
                                {
                                    <MudTooltip Text="Mark as read">
                                        <MudIconButton Icon="@Icons.Material.Outlined.MarkEmailRead"
                                                       Size="Size.Small"
                                                       OnClick="@(() => MarkMessageReadAsync(context.Id))" />
                                    </MudTooltip>
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Outlined.DoneAll"
                                             Style="font-size:16px; color:var(--ft-gray-200);" />
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            }
        </MudTabPanel>

    </MudTabs>
</div>

@code {
    // ── Tab state ────────────────────────────────────────────────────────────
    private int _activeTab;

    private void GoToTab(int index) => _activeTab = index;

    // ── Loading flags ────────────────────────────────────────────────────────
    private bool _loading          = true;
    private bool _loadingDeleted   = true;
    private bool _loadingAudit     = true;
    private bool _loadingUsers     = true;
    private bool _loadingActivity  = true;
    private bool _loadingMessages  = true;

    // ── Dashboard stats ──────────────────────────────────────────────────────
    private int _totalPeople;
    private int _deletedCount;
    private int _totalRelationships;
    private int _familyCount;
    private int _userCount;
    private int _pendingInvites;
    private int _totalAuditEntries;
    private int _auditEntriesToday;
    private List<AuditLog> _recentAudit = [];

    // ── Tab data ─────────────────────────────────────────────────────────────
    private List<DeletedPersonRow>         _deleted           = [];
    private List<AuditLog>                 _auditLogs         = [];
    private List<AppUser>                  _users             = [];
    private List<UserActivity>             _activity          = [];
    private List<PersonDto>                _people            = [];
    private Dictionary<Guid, Guid?>        _personLinks       = new();
    private List<UserInvite>               _pendingInvitesList = [];
    private Dictionary<Guid, List<string>> _userRoles         = new();
    private List<PasswordResetRequest>     _pendingResets     = [];
    private List<ImportBatch>              _importBatches     = [];
    private List<UserMessage>              _messages          = [];

    // ── Stories ──────────────────────────────────────────────────────────────
    private bool _loadingStories = true;
    private List<StoryDto> _allStories = [];
    private List<StoryDto> _unlinkedStories = [];
    private readonly Dictionary<Guid, PersonDto> _linkSelections = [];

    // ── Invite creation ──────────────────────────────────────────────────────
    private string  _inviteEmail    = "";
    private string? _inviteLink;
    private string? _inviteError;
    private bool    _creatingInvite;
    private int     _config_ttl     = 7;

    // ── Inline user display name edit ────────────────────────────────────────
    private Guid?  _editingUserId;
    private string _editingDisplayName = "";

    private async Task SaveDisplayNameAsync(Guid userId)
    {
        var user = await UserManager.FindByIdAsync(userId.ToString());
        if (user == null) return;

        user.DisplayName = _editingDisplayName.Trim();
        var result = await UserManager.UpdateAsync(user);

        if (result.Succeeded)
        {
            var row = _users.FirstOrDefault(u => u.Id == userId);
            if (row != null) row.DisplayName = user.DisplayName;
            Toast.Success("Display name updated.");
        }
        else
        {
            Toast.Error("Failed to update display name.");
        }
        _editingUserId = null;
    }

    // ── Audit filter ─────────────────────────────────────────────────────────
    private string? _auditActionFilter;
    private string? _auditEntityFilter;

    private List<AuditLog> FilteredAuditLogs => _auditLogs
        .Where(a => string.IsNullOrEmpty(_auditActionFilter) || a.Action == _auditActionFilter)
        .Where(a => string.IsNullOrEmpty(_auditEntityFilter) || a.EntityType == _auditEntityFilter)
        .ToList();

    // ── Lifecycle ────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(
            LoadDashboardAsync(),
            LoadDeletedAsync(),
            LoadAuditAsync(),
            LoadUsersAsync(),
            LoadActivityAsync(),
            LoadPeopleAsync(),
            LoadPendingInvitesAsync(),
            LoadPendingResetsAsync(),
            LoadImportBatchesAsync(),
            LoadMessagesAsync(),
            LoadStoriesAsync());
    }

    private async Task LoadDashboardAsync()
    {
        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var today = DateTime.UtcNow.Date;

            _totalPeople        = await ctx.People.CountAsync();
            _deletedCount       = await ctx.People.IgnoreQueryFilters().CountAsync(p => p.DeletedAt != null);
            _totalRelationships = await ctx.Relationships.CountAsync();
            _familyCount        = await ctx.Families.CountAsync();
            _userCount          = await ctx.AppUsers.CountAsync();
            _pendingInvites     = await ctx.UserInvites
                .CountAsync(i => i.AcceptedAt == null && i.CancelledAt == null && i.ExpiresAt > DateTime.UtcNow);
            _totalAuditEntries  = await ctx.AuditLogs.CountAsync();
            _auditEntriesToday  = await ctx.AuditLogs.CountAsync(a => a.Timestamp >= today);

            _recentAudit = await ctx.AuditLogs
                .AsNoTracking()
                .OrderByDescending(a => a.Timestamp)
                .Take(10)
                .ToListAsync();
        }
        catch { }
        _loading = false;
    }

    private async Task LoadDeletedAsync()
    {
        var result = await PersonService.GetDeletedAsync();
        if (result.Success)
            _deleted = result.Data!.Select(d => new DeletedPersonRow(d)).ToList();
        _loadingDeleted = false;
    }

    private async Task LoadAuditAsync()
    {
        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            _auditLogs = await ctx.AuditLogs
                .AsNoTracking()
                .OrderByDescending(a => a.Timestamp)
                .Take(500)
                .ToListAsync();
        }
        catch { }
        _loadingAudit = false;
    }

    private async Task LoadUsersAsync()
    {
        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            _users = await ctx.AppUsers
                .AsNoTracking()
                .OrderBy(u => u.Email)
                .ToListAsync();
            _personLinks = _users.ToDictionary(u => u.Id, u => u.PersonId);

            var roleData = await ctx.UserRoles
                .Join(ctx.Roles, ur => ur.RoleId, r => r.Id, (ur, r) => new { ur.UserId, r.Name })
                .ToListAsync();
            _userRoles = roleData
                .GroupBy(x => x.UserId)
                .ToDictionary(g => g.Key, g => g.Select(x => x.Name ?? "").ToList());
        }
        catch { }
        _loadingUsers = false;
    }

    private string GetPrimaryRole(AppUser user)
    {
        if (user.IsSuperUser) return "SuperUser";
        var roles = _userRoles.GetValueOrDefault(user.Id) ?? [];
        return roles.Contains("Admin") ? "Admin" : "Member";
    }

    private async Task SetRoleAsync(AppUser user, string newRole)
    {
        if (user.IsSuperUser) return;
        var current = await UserManager.GetRolesAsync(user);
        if (current.Count > 0)
            await UserManager.RemoveFromRolesAsync(user, current);
        var result = await UserManager.AddToRoleAsync(user, newRole);
        if (result.Succeeded)
        {
            _userRoles[user.Id] = [newRole];
            Toast.Success($"Role set to {newRole}.");
        }
        else
        {
            Toast.Error("Failed to update role.");
        }
    }

    private async Task LoadPeopleAsync()
    {
        var result = await PersonService.GetAllAsync();
        if (result.Success)
            _people = result.Data ?? [];
    }

    private async Task LoadPendingInvitesAsync()
    {
        _pendingInvitesList = await AuthService.GetPendingInvitesAsync();
    }

    private async Task LoadPendingResetsAsync()
    {
        _pendingResets = await AuthService.GetPendingResetRequestsAsync();
    }

    private async Task CopyResetLink(PasswordResetRequest req)
    {
        var baseUri = NavManager.BaseUri.TrimEnd('/');
        var link = $"{baseUri}/reset-password?id={req.Id}";
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", link);
        Toast.Success("Reset link copied.");
    }

    private async Task DismissResetAsync(Guid id)
    {
        await AuthService.DismissResetRequestAsync(id);
        _pendingResets.RemoveAll(r => r.Id == id);
    }

    private async Task LoadImportBatchesAsync()
    {
        _importBatches = await ImportService.GetImportBatchesAsync();
    }

    private async Task LoadMessagesAsync()
    {
        var result = await MessageService.GetAllAsync();
        if (result.Success) _messages = result.Data!;
        _loadingMessages = false;
    }

    private async Task MarkMessageReadAsync(Guid id)
    {
        await MessageService.MarkReadAsync(id);
        var msg = _messages.FirstOrDefault(m => m.Id == id);
        if (msg != null) msg.ReadAt = DateTime.UtcNow;
    }

    private async Task LoadStoriesAsync()
    {
        var all = await StoryService.GetAllAsync();
        if (all.Success) _allStories = all.Data!;

        var unlinked = await StoryService.GetUnlinkedAsync();
        if (unlinked.Success) _unlinkedStories = unlinked.Data!;

        _loadingStories = false;
    }

    private static readonly PersonDto _addNewPersonOption = new() { Id = Guid.Empty };

    private Task<IEnumerable<PersonDto>> SearchPeopleForLinking(string value, CancellationToken _)
    {
        var matches = _people
            .Where(p => string.IsNullOrWhiteSpace(value) ||
                        p.FullName.Contains(value, StringComparison.OrdinalIgnoreCase))
            .Take(8);

        return Task.FromResult<IEnumerable<PersonDto>>([_addNewPersonOption, .. matches]);
    }

    private async Task HandleLinkSelection(Guid storyId, string? unlinkedName, PersonDto? person)
    {
        if (person is null) return;

        if (person.Id == Guid.Empty)
        {
            var url = $"/people/add?name={Uri.EscapeDataString(unlinkedName ?? "")}";
            await JS.InvokeVoidAsync("open", url, "_blank");
            return;
        }

        _linkSelections[storyId] = person;
    }

    private async Task ApproveStoryAsync(Guid storyId)
    {
        var result = await StoryService.ApproveAsync(storyId);
        if (result.Success)
        {
            var story = _allStories.FirstOrDefault(s => s.Id == storyId);
            if (story is not null) story.IsApproved = true;
            Toast.Success("Story approved");
        }
        else
        {
            Toast.Error(result.Message);
        }
    }

    private async Task ToggleHiddenAsync(Guid storyId, bool hidden)
    {
        var result = await StoryService.SetHiddenAsync(storyId, hidden);
        if (result.Success)
        {
            var story = _allStories.FirstOrDefault(s => s.Id == storyId);
            if (story is not null) story.IsHidden = hidden;
            Toast.Success(hidden ? "Story hidden" : "Story published");
        }
        else
        {
            Toast.Error(result.Message);
        }
    }

    private async Task EditStoryAsync(StoryDto story)
    {
        var parameters = new DialogParameters<AdminStoryEditDialog>
        {
            { d => d.StoryId,      story.Id },
            { d => d.InitialTitle, story.Title },
            { d => d.InitialBody,  story.Body },
        };

        var dialog = await DialogService.ShowAsync<AdminStoryEditDialog>(
            "Edit story", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: StoryDto updated })
        {
            story.Title = updated.Title;
            story.Body = updated.Body;
            Toast.Success("Story updated");
        }
    }

    private async Task DeleteStoryAsync(Guid storyId)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { d => d.Message, "Delete this story? This cannot be undone." }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete story", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        var deleteResult = await StoryService.DeleteAsync(storyId);
        if (deleteResult.Success)
        {
            _allStories.RemoveAll(s => s.Id == storyId);
            _unlinkedStories.RemoveAll(s => s.Id == storyId);
            Toast.Success("Story deleted");
        }
        else
        {
            Toast.Error(deleteResult.Message);
        }
    }

    private async Task MoveStoryAsync(Guid storyId, int direction)
    {
        var result = await StoryService.MoveAsync(storyId, direction);
        if (!result.Success)
        {
            Toast.Error(result.Message);
            return;
        }

        var refreshed = await StoryService.GetAllAsync();
        if (refreshed.Success) _allStories = refreshed.Data!;
    }

    private async Task LinkStoryAsync(Guid storyId)
    {
        if (!_linkSelections.TryGetValue(storyId, out var person)) return;

        var result = await StoryService.LinkToPersonAsync(storyId, person.Id);
        if (result.Success)
        {
            _unlinkedStories.RemoveAll(s => s.Id == storyId);
            _linkSelections.Remove(storyId);
            Toast.Success($"Linked to {person.FullName}");
        }
        else
        {
            Toast.Error(result.Message);
        }
    }

    private async Task ConfirmRollbackAsync(ImportBatch batch)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Roll back the import from {batch.CreatedAt.ToLocalTime():MMM d, yyyy}? " +
            $"This will soft-delete {batch.PersonCount} people and their relationships.");
        if (!confirmed) return;

        try
        {
            await ImportService.RollbackBatchAsync(batch.Id);
            batch.RolledBackAt = DateTime.UtcNow;
            Toast.Success($"Import rolled back — {batch.PersonCount} people removed.");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Toast.Error($"Rollback failed: {ex.Message}");
        }
    }

    private async Task CreateInviteAsync()
    {
        _inviteError = null;
        _inviteLink  = null;
        _creatingInvite = true;

        var result = await AuthService.CreateInviteAsync(_inviteEmail.Trim());
        _creatingInvite = false;

        if (!result.Success && result.Id is null)
        {
            _inviteError = result.Error;
            return;
        }

        var baseUri = NavManager.BaseUri.TrimEnd('/');
        _inviteLink = $"{baseUri}/register?invite={result.Id}";
        _inviteEmail = "";

        await LoadPendingInvitesAsync();
        _pendingInvites = _pendingInvitesList.Count;
    }

    private async Task CancelInviteAsync(Guid inviteId)
    {
        var result = await AuthService.CancelInviteAsync(inviteId);
        if (result.Success)
        {
            Toast.Success("Invite cancelled.");
            await LoadPendingInvitesAsync();
            _pendingInvites = _pendingInvitesList.Count;
            if (_inviteLink?.Contains(inviteId.ToString()) == true)
                _inviteLink = null;
        }
        else
        {
            Toast.Error(result.Error ?? "Failed to cancel invite.");
        }
    }

    private async Task CopyInviteLink()
    {
        if (_inviteLink is not null)
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _inviteLink);
    }

    private async Task CopyInviteLinkFor(Guid inviteId)
    {
        var baseUri = NavManager.BaseUri.TrimEnd('/');
        await JS.InvokeVoidAsync("navigator.clipboard.writeText",
            $"{baseUri}/register?invite={inviteId}");
    }

    private async Task LoadActivityAsync()
    {
        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            _activity = await ctx.UserActivities
                .AsNoTracking()
                .OrderByDescending(a => a.Date)
                .Take(200)
                .ToListAsync();
        }
        catch { }
        _loadingActivity = false;
    }

    // ── Actions ──────────────────────────────────────────────────────────────

    private async Task SetPersonLink(Guid userId, Guid? personId)
    {
        _personLinks[userId] = personId;
        var result = await AuthService.LinkPersonAsync(userId, personId);
        if (result.Success)
        {
            var personName = personId.HasValue
                ? _people.FirstOrDefault(p => p.Id == personId.Value)?.FullName ?? "person"
                : null;
            Toast.Success(personName is null ? "Link cleared." : $"Linked to {personName}.");
        }
        else
        {
            Toast.Error(result.Error ?? "Failed to link person.");
        }
    }

    private async Task RestorePersonAsync(DeletedPersonRow row)
    {
        var result = await PersonService.RestoreAsync(row.Id);
        if (result.Success)
        {
            _deleted.Remove(row);
            _deletedCount = Math.Max(0, _deletedCount - 1);
            Toast.Success($"{row.FullName} restored.");
            await LoadAuditAsync();
            _recentAudit = _auditLogs.Take(10).ToList();
        }
        else
        {
            Toast.Error(result.Message);
        }
    }

    // ── Styling helpers ───────────────────────────────────────────────────────

    private static Color AuditChipColor(string action) => action switch
    {
        "Create"  => Color.Success,
        "Update"  => Color.Info,
        "Delete"  => Color.Error,
        "Restore" => Color.Warning,
        _         => Color.Default
    };

    private static string AuditIcon(string action) => action switch
    {
        "Create"  => Icons.Material.Outlined.Add,
        "Update"  => Icons.Material.Outlined.Edit,
        "Delete"  => Icons.Material.Outlined.Delete,
        "Restore" => Icons.Material.Outlined.RestoreFromTrash,
        "Login"   => Icons.Material.Outlined.Login,
        _         => Icons.Material.Outlined.Circle
    };

    private static string AuditChipBg(string action) => action switch
    {
        "Create"  => "rgba(76,175,80,0.12)",
        "Update"  => "rgba(33,150,243,0.12)",
        "Delete"  => "rgba(244,67,54,0.12)",
        "Restore" => "rgba(255,152,0,0.12)",
        _         => "var(--ft-green-50)"
    };

    private static string AuditIconColor(string action) => action switch
    {
        "Create"  => "#4caf50",
        "Update"  => "#2196f3",
