@page "/people/{Id:guid}/edit"
@rendermode InteractiveServer

@using FamilyTree.Core.Services
@using FamilyTree.Shared.DTOs.Person
@using FamilyTree.Web.Modules.Components
@using FamilyTree.Web.Modules.Dialogs
@using FamilyTree.Web.Services
@using FamilyTree.Web.Utils
@using MudBlazor

@inject IPersonService PersonService
@inject NavigationManager Nav
@inject ToastService Toast
@inject IDialogService DialogService

<PageTitle>Edit person</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Success" />
}
else if (_notFound)
{
    <MudAlert Severity="Severity.Warning">Person not found.</MudAlert>
}
else
{
    <div class="ft-form-page">
        <MudContainer MaxWidth="MaxWidth.Medium">
            <div class="page-header">Edit @_person!.FullName</div>
            <PersonForm Initial="_formModel"
                        EditingId="@Id"
                        AllPeople="_allPeople"
                        SubmitLabel="Save changes"
                        OnSubmit="HandleSubmit"
                        OnCancel="@(() => Nav.NavigateTo("/"))" />
            <div style="display:flex; gap:8px; justify-content:flex-end; margin-top:16px;">
                <MudButton Variant="Variant.Outlined" Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Delete"
                           OnClick="HandleDelete">
                    Delete person
                </MudButton>
            </div>
        </MudContainer>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private PersonDto? _person;
    private PersonUpsertDto? _formModel;
    private List<PersonDto> _allPeople = [];
    private bool _loading = true;
    private bool _notFound;

    protected override async Task OnInitializedAsync()
    {
        var personResult = await PersonService.GetByIdAsync(Id);
        var allResult    = await PersonService.GetAllAsync();

        if (!personResult.Success)
        {
            Toast.Error(personResult.Message);
            _notFound = true;
            _loading  = false;
            return;
        }

        if (!allResult.Success)
            Toast.Warning(allResult.Message);

        _person    = personResult.Data!;
        _allPeople = allResult.Data ?? [];
        _formModel = new PersonUpsertDto
        {
            FirstName       = _person.FirstName,
            LastName        = _person.LastName,
            MiddleName      = _person.MiddleName,
            MaidenName      = _person.MaidenName,
            BirthDate       = _person.BirthDate,
            BirthPlace      = _person.BirthPlace,
            DeathDate       = _person.DeathDate,
            DeathPlace      = _person.DeathPlace,
            BiographyNotes  = _person.BiographyNotes,
            ProfilePhotoUrl = _person.ProfilePhotoUrl,
            Gender          = _person.Gender,
            ParentIds       = _person.ParentIds       ?? [],
            SpouseIds       = _person.SpouseIds       ?? [],
            FormerSpouseIds = _person.FormerSpouseIds ?? [],
            SiblingIds      = _person.SiblingIds      ?? [],
            ChildIds        = _person.ChildIds        ?? []
        };
        _loading = false;
    }

    private async Task HandleSubmit(PersonUpsertDto dto)
    {
        var result = await PersonService.UpdateAsync(Id, dto);
        Toast.ShowResult(result, $"{_person!.FullName} saved.");
        if (!result.Success) return;

        // Surface captured questions in biography notes
        var questions = QuestionDetector.ExtractQuestions(dto.BiographyNotes);
        if (questions.Count > 0)
        {
            var preview = string.Join(" · ", questions.Take(2));
            var suffix  = questions.Count > 2 ? $" +{questions.Count - 2} more" : "";
            Toast.Info($"Questions captured: {preview}{suffix}", "Biography notes");
        }

        // Offer to link missing sibling connections
        var originalSiblingIds = _person.SiblingIds ?? [];
        var addedIds = dto.SiblingIds.Except(originalSiblingIds).ToList();
        await OfferSiblingLinks(dto, addedIds);

        Nav.NavigateTo("/");
    }

    private async Task OfferSiblingLinks(PersonUpsertDto submittedDto, List<Guid> addedSiblingIds)
    {
        if (addedSiblingIds.Count == 0) return;

        var suggestions  = new List<PersonDto>();
        PersonDto? firstSibling = null;

        foreach (var sibId in addedSiblingIds)
        {
            var sib = _allPeople.FirstOrDefault(p => p.Id == sibId);
            if (sib == null) continue;

            var missing = (sib.SiblingIds ?? [])
                .Where(id => id != Id && !submittedDto.SiblingIds.Contains(id))
                .Select(id => _allPeople.FirstOrDefault(p => p.Id == id))
                .Where(p => p != null).Select(p => p!)
                .ToList();

            if (missing.Count > 0) firstSibling ??= sib;

            foreach (var m in missing)
                if (!suggestions.Any(s => s.Id == m.Id))
                    suggestions.Add(m);
        }

        if (suggestions.Count == 0 || firstSibling == null) return;

        var parameters = new DialogParameters<SiblingInferenceDialog>
        {
            { d => d.NewPersonName,     _person!.FullName },
            { d => d.LinkedSiblingName, firstSibling.FullName },
            { d => d.SuggestedSiblings, suggestions }
        };

        var dialog = await DialogService.ShowAsync<SiblingInferenceDialog>(
            "Link more siblings?", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });

        var dialogResult = await dialog.Result;
        if (dialogResult is { Canceled: false })
        {
            submittedDto.SiblingIds = [.. submittedDto.SiblingIds, .. suggestions.Select(p => p.Id)];
            await PersonService.UpdateAsync(Id, submittedDto);
            Toast.Success($"Linked as sibling to {suggestions.Count} more.");
        }
    }

    private async Task HandleDelete()
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Message, $"This will remove {_person!.FullName} from your family tree. This action cannot be undone." },
            { x => x.ConfirmLabel, "Delete" }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(
            $"Delete {_person.FullName}?", parameters);

        var result = await dialog.Result;
        if (!result.Canceled)
        {
            var deleteResult = await PersonService.DeleteAsync(Id);
            if (deleteResult.Success)
            {
                Toast.Success($"{_person.FullName} has been deleted");
                Nav.NavigateTo("/people");
            }
            else
            {
                Toast.Error(deleteResult.Message);
            }
        }
    }
}
