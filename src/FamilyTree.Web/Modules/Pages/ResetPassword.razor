@page "/reset-password"
@rendermode InteractiveServer

@using MudBlazor
@using FamilyTree.Core.Services
@inject IAuthService AuthService
@inject NavigationManager Nav

<PageTitle>Reset password — ArborKin</PageTitle>

<div class="ft-auth-page">
    <div class="intro-glass auth-card" style="max-width:420px;">

        @* ── Branding ──────────────────────────────────────────────────────── *@
        <div style="display:flex; justify-content:center; margin-bottom:16px; user-select:none;">
            <img src="/images/arborkin-logo__transparent.png" alt="ArborKin"
                 style="height:80px;" />
        </div>

        <div style="font-size:20px; font-weight:600; color:var(--ft-text-primary); margin-bottom:8px;">
            Set new password
        </div>

        @if (_invalidLink)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">
                This reset link is missing required information. Please request a new one.
            </MudAlert>
            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Outlined.ArrowBack"
                       OnClick='() => Nav.NavigateTo("/forgot-password")'>
                Request a new link
            </MudButton>
        }
        else if (_done)
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-4">
                Your password has been updated. You can now sign in with your new password.
            </MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       FullWidth="true"
                       OnClick='() => Nav.NavigateTo("/")'>
                Go to sign in
            </MudButton>
        }
        else
        {
            @if (_error is not null)
            {
                <div class="auth-error" style="margin-bottom:12px;">@_error</div>
            }

            <div class="ft-field-label">New password</div>
            <MudTextField @bind-Value="_password"
                          Placeholder="Minimum 10 characters"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                          Disabled="_loading"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showPassword ? Icons.Material.Outlined.VisibilityOff
                                                         : Icons.Material.Outlined.Visibility)"
                          OnAdornmentClick="() => _showPassword = !_showPassword"
                          Error="@(!string.IsNullOrEmpty(_passwordError))"
                          ErrorText="@_passwordError" />

            <div class="ft-field-label" style="margin-top:12px;">Confirm password</div>
            <MudTextField @bind-Value="_confirm"
                          Placeholder="Re-enter your password"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          InputType="@(_showConfirm ? InputType.Text : InputType.Password)"
                          Disabled="_loading"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showConfirm ? Icons.Material.Outlined.VisibilityOff
                                                        : Icons.Material.Outlined.Visibility)"
                          OnAdornmentClick="() => _showConfirm = !_showConfirm"
                          Error="@(!string.IsNullOrEmpty(_confirmError))"
                          ErrorText="@_confirmError" />

            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       FullWidth="true" Class="mt-4"
                       OnClick="Submit"
                       Disabled="_loading">
                @if (_loading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true"
                                         Style="color:#fff; margin-right:8px;" />
                }
                Update password
            </MudButton>
        }

    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "email")] public string? Email { get; set; }
    [SupplyParameterFromQuery(Name = "token")] public string? Token { get; set; }

    private string  _password      = "";
    private string  _confirm       = "";
    private bool    _showPassword;
    private bool    _showConfirm;
    private bool    _loading;
    private bool    _done;
    private bool    _invalidLink;
    private string? _error;
    private string  _passwordError = "";
    private string  _confirmError  = "";

    protected override void OnParametersSet()
    {
        _invalidLink = string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Token);
    }

    private async Task Submit()
    {
        _error = null;
        _passwordError = _confirmError = "";

        var valid = true;
        if (string.IsNullOrWhiteSpace(_password))
        { _passwordError = "Required"; valid = false; }
        else if (_password.Length < 10)
        { _passwordError = "Minimum 10 characters"; valid = false; }

        if (string.IsNullOrWhiteSpace(_confirm))
        { _confirmError = "Required"; valid = false; }
        else if (_confirm != _password)
        { _confirmError = "Passwords do not match"; valid = false; }

        if (!valid) return;

        _loading = true;
        var result = await AuthService.ResetPasswordAsync(Email!, Token!, _password);
        _loading = false;

        if (!result.Success)
            _error = result.Error;
        else
            _done = true;
    }
}
