@page "/about"
@rendermode InteractiveServer

@using FamilyTree.Web.Modules.Components
@using MudBlazor

@inject NavigationManager Nav

<PageTitle>About — ArborKin</PageTitle>

<div style="max-width:800px; margin:0 auto; padding:48px 24px 80px;
    font-family:var(--ft-font-body);">

    @* ── Hero ─────────────────────────────────────────────────────────────── *@
    <div style="text-align:center; margin-bottom:56px;">
        <MudIcon Icon="@Icons.Material.Outlined.Park"
                 Style="font-size:52px; color:var(--ft-green-600); margin-bottom:14px; display:block;" />
        <div style="font-size:36px; font-weight:700; font-style:italic;
            font-family:var(--ft-font-display); color:var(--ft-green-800);
            line-height:1.15; margin-bottom:10px;">
            FamilyTree
        </div>
        <div style="font-size:16px; color:var(--ft-gray-400); max-width:480px;
            margin:0 auto; line-height:1.7;">
            A private, modern family tree app for people who care about
            preserving their family history — without handing it to Ancestry.
        </div>
    </div>

    @* ── The project ──────────────────────────────────────────────────────── *@
    <CustomSection Title="The project">
        <p style="font-size:15px; color:var(--ft-gray-600); line-height:1.8; margin:0 0 14px;">
            FamilyTree is a personal project built to solve a real frustration: existing genealogy tools
            are either locked behind expensive subscriptions, hard to use, or require surrendering your
            family's data to a commercial platform.
        </p>
        <p style="font-size:15px; color:var(--ft-gray-600); line-height:1.8; margin:0;">
            This app is free, self-hostable, and designed from the ground up for clarity —
            a clean visual tree, simple data entry, and first-class support for importing
            from common genealogy formats.
        </p>
    </CustomSection>

    @* ── Tech stack ───────────────────────────────────────────────────────── *@
    <CustomSection Title="Built with">
        <div style="display:flex; flex-wrap:wrap; gap:10px; margin-top:4px;">
            @foreach (var chip in TechChips)
            {
                <div style="display:flex; align-items:center; gap:6px; background:@chip.Color; color:#fff;
                    font-size:12px; font-weight:500; padding:5px 12px 5px 10px; border-radius:20px;
                    letter-spacing:0.02em;">
                    @if (chip.IsGitHub)
                    {
                        <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor" style="flex-shrink:0;" aria-hidden="true">
                            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
                        </svg>
                    }
                    else
                    {
                        <MudIcon Icon="@chip.Icon" Style="font-size:14px; flex-shrink:0;" />
                    }
                    @chip.Label
                </div>
            }
        </div>
    </CustomSection>

    @* ── Built by ─────────────────────────────────────────────────────────── *@
    <CustomSection Title="Built by">
        <p style="font-size:15px; color:var(--ft-gray-600); line-height:1.8; margin:0 0 16px;">
            ArborKin is a solo project by <strong style="color:var(--ft-green-800);">Doug Rosenberg</strong> —
            built end-to-end as both a real tool for his own family and a hands-on deep dive into
            modern .NET, Blazor, and AI-assisted development.
        </p>
        <div style="display:flex; gap:12px; flex-wrap:wrap;">
            <a href="https://www.dougrosenbergdev.com" target="_blank" rel="noopener"
               style="display:inline-flex; align-items:center; gap:8px; padding:9px 16px;
                   border:1px solid var(--ft-line-border); border-radius:10px; text-decoration:none;
                   font-size:13px; font-weight:500; color:var(--ft-green-700); background:var(--ft-green-50);">
                @* Inlined from dougrosenbergdev.com/logos/favicon.svg — the site's own
                   hexagon "dr" mark, embedded so it renders without an external request. *@
                <svg width="16" height="16" viewBox="0 0 256 256" aria-hidden="true" style="flex-shrink:0;">
                    <defs>
                        <linearGradient id="drFaviconGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#1e3a5f" />
                            <stop offset="100%" stop-color="#1ABC9C" />
                        </linearGradient>
                    </defs>
                    <g transform="translate(128, 128)">
                        <polygon points="0,-125 108,-62 108,62 0,125 -108,62 -108,-62" fill="url(#drFaviconGrad)" />
                        <text x="0" y="30" text-anchor="middle" dominant-baseline="middle" fill="#FFFFFF"
                              font-family="Montserrat, system-ui, sans-serif" font-size="140" font-weight="700"
                              letter-spacing="0.02em">dr</text>
                    </g>
                </svg>
                dougrosenbergdev.com
            </a>
        </div>
    </CustomSection>

    @* ── Privacy commitment ───────────────────────────────────────────────── *@
    <CustomSection Title="Privacy commitment">
        <div style="display:flex; flex-direction:column; gap:12px;">
            @foreach (var (icon, text) in new (string,string)[]{
                (Icons.Material.Outlined.Lock, "Your data is yours. We do not sell, share, or mine your family information."),
                (Icons.Material.Outlined.VisibilityOff, "No ads, no tracking pixels, no third-party analytics on your tree data."),
                (Icons.Material.Outlined.Security, "Data is encrypted at rest (Azure SQL TDE) and in transit (TLS 1.3)."),
                (Icons.Material.Outlined.Download, "You can export your complete data at any time in standard formats."),
                (Icons.Material.Outlined.DeleteOutline, "Account deletion removes all your data permanently within 30 days.")
            })
            {
                <div style="display:flex; gap:12px; align-items:flex-start;">
                    <MudIcon Icon="@icon"
                             Style="font-size:18px; color:var(--ft-green-600); flex-shrink:0; margin-top:2px;" />
                    <span style="font-size:14px; color:var(--ft-gray-600); line-height:1.6;">@text</span>
                </div>
            }
        </div>
    </CustomSection>

    @* ── Roadmap highlights ───────────────────────────────────────────────── *@
    <CustomSection Title="What's coming">
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
            @foreach (var (label, done) in new (string,bool)[]{
                ("User accounts & authentication", false),
                ("AI-powered document import", false),
                ("GEDCOM import & export", false),
                ("Excel / CSV import & export", false),
                ("Advanced tree visualizations", false),
                ("Family statistics & insights", false),
                ("Shared family trees (multi-user)", false),
                ("Mobile-friendly layout", false)
            })
            {
                <div style="display:flex; align-items:center; gap:8px; font-size:13px; color:var(--ft-gray-600);">
                    <MudIcon Icon="@(done ? Icons.Material.Outlined.CheckCircle : Icons.Material.Outlined.RadioButtonUnchecked)"
                             Style="@RoadmapIconStyle(done)" />
                    @label
                </div>
            }
        </div>
    </CustomSection>

    @* ── Donate ───────────────────────────────────────────────────────────── *@
    <div style="background:var(--ft-brown-50); border:1px solid var(--ft-brown-200);
        border-radius:var(--ft-radius-card); padding:32px; text-align:center; margin-bottom:32px;">
        <MudIcon Icon="@Icons.Material.Outlined.VolunteerActivism"
                 Style="font-size:36px; color:var(--ft-brown-400); margin-bottom:10px; display:block;" />
        <div style="font-size:20px; font-weight:600; font-style:italic;
            font-family:var(--ft-font-display); color:var(--ft-brown-800); margin-bottom:8px;">
            Support this project
        </div>
        <div style="font-size:14px; color:var(--ft-gray-500); line-height:1.7;
            max-width:420px; margin:0 auto 20px;">
            FamilyTree is free to use. If it's helped you preserve your family's history,
            a small donation covers hosting costs and keeps development going.
        </div>
        <div style="display:flex; justify-content:center; gap:12px; flex-wrap:wrap;">
            <MudButton Variant="Variant.Filled"
                       Style="background:#3D95CE; color:#fff; font-size:14px;"
                       StartIcon="@Icons.Material.Outlined.AttachMoney"
                       Href="https://venmo.com/u/doug-Rosenberg-2" Target="_blank">
                $5 on Venmo
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Style="background:#3D95CE; color:#fff; font-size:14px;"
                       StartIcon="@Icons.Material.Outlined.AttachMoney"
                       Href="https://venmo.com/u/doug-Rosenberg-2" Target="_blank">
                $10 on Venmo
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Style="border-color:var(--ft-brown-400); color:var(--ft-brown-600);"
                       StartIcon="@Icons.Material.Outlined.AttachMoney"
                       Href="https://venmo.com/u/doug-Rosenberg-2" Target="_blank">
                Custom amount
            </MudButton>
        </div>
        <div style="font-size:11px; color:var(--ft-gray-300); margin-top:12px;">
            Opens Venmo in a new tab · @("@doug-Rosenberg-2") on Venmo
        </div>
    </div>

    @* ── Footer links ─────────────────────────────────────────────────────── *@
    <div style="display:flex; justify-content:center; gap:20px; flex-wrap:wrap;">
        <a href="/faq" style="font-size:13px; color:var(--ft-green-600); text-decoration:none;">FAQ & security</a>
        <a href="/dashboard" style="font-size:13px; color:var(--ft-green-600); text-decoration:none;">Dashboard</a>
        <a href="/" style="font-size:13px; color:var(--ft-green-600); text-decoration:none;">Family tree</a>
    </div>

</div>

@code {
    private static string RoadmapIconStyle(bool done) =>
        done ? "font-size:16px; color:var(--ft-green-600);"
             : "font-size:16px; color:var(--ft-gray-200);";

    // IsGitHub picks the hand-drawn octocat mark below instead of a MudIcon —
    // a generic Material icon there would read as "not really GitHub", and
    // the octocat silhouette is simple/iconic enough to inline accurately.
    private static readonly (string Label, string Color, string Icon, bool IsGitHub)[] TechChips =
    [
        (".NET 10",                "#512bd4", Icons.Material.Filled.Code,        false),
        ("C# 13",                  "#239120", Icons.Material.Filled.DataObject,  false),
        ("Blazor Server",          "#7014e8", Icons.Material.Filled.Bolt,        false),
        ("MudBlazor",              "#594ae2", Icons.Material.Filled.Restaurant,  false),
        ("Entity Framework Core",  "#0078d4", Icons.Material.Filled.Storage,     false),
        ("Azure SQL",              "#0078d4", Icons.Material.Filled.TableChart,  false),
        ("Azure Blob Storage",     "#0078d4", Icons.Material.Filled.Inventory2,  false),
        ("Azure App Service",      "#0078d4", Icons.Material.Filled.Cloud,       false),
        ("GitHub Actions CI/CD",   "#24292f", "",                                true),
        ("Claude",                 "#da7756", Icons.Material.Filled.AutoAwesome, false),
    ];
}