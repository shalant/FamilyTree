@page "/stories"
@rendermode InteractiveServer

@using FamilyTree.Core.Services
@using FamilyTree.Shared.DTOs.Person
@using FamilyTree.Shared.DTOs.Story
@using FamilyTree.Web.Modules.Components
@using FamilyTree.Web.Services
@using MudBlazor

@inject IStoryService StoryService
@inject IPersonService PersonService
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject ToastService Toast

<PageTitle>Stories</PageTitle>

<MudPaper Elevation="0" Class="pa-4" Style="background:var(--ft-surface);">
    <MudStack Row="true" AlignItems="AlignItems.Center"
              Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.h5"
                     Style="font-style:italic; font-family:Georgia,serif;
                color:var(--ft-green-800);">
                Family stories
            </MudText>
            @if (!_loading && _stories.Any())
            {
                <MudChip T="string" Size="Size.Small"
                         Style="background:var(--ft-green-50); color:var(--ft-green-700);">
                    @_stories.Count total
                </MudChip>
            }
        </MudStack>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Success"
                   StartIcon="@Icons.Material.Outlined.AddCircleOutline"
                   OnClick="AddStory">
            Add story
        </MudButton>
    </MudStack>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Success" Class="mb-4" />
    }
    else if (!_stories.Any())
    {
        <MudPaper Elevation="2" Class="pa-6 mx-auto text-center"
                  Style="max-width:420px; background:rgba(245,245,245,0.4);
            backdrop-filter:blur(12px); border-radius:12px;">
            <MudText Typo="Typo.h6" Style="font-style:italic; color:var(--ft-green-800);">
                No stories yet
            </MudText>
            <MudText Typo="Typo.body2" Style="color:var(--ft-gray-500);">
                Share a memory about a family member to start the collection.
            </MudText>
            <MudButton Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.AddCircleOutline"
                       Style="background:var(--ft-green-600); color:#fff; margin-top:16px;"
                       OnClick="AddStory">
                Add story
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudStack Spacing="3">
            @foreach (var story in _stories)
            {
                <MudPaper Elevation="0" Class="pa-4"
                          Style="background:var(--ft-surface-card); border-radius:var(--ft-radius-card);
                    border:0.5px solid var(--ft-line-border);">
                    <div style="font-size:15px; font-weight:600; color:var(--ft-text-primary);">
                        @story.Title
                    </div>
                    <div style="font-size:12px; color:var(--ft-gray-400); margin:4px 0 10px;">
                        About
                        @if (story.PersonId is { } pid && _peopleById.TryGetValue(pid, out var p))
                        {
                            <a style="color:var(--ft-green-600); cursor:pointer; text-decoration:none;"
                               @onclick="@(() => Nav.NavigateTo($"/?view={pid}"))">@p.FullName</a>
                        }
                        else
                        {
                            <span>@(story.UnlinkedPersonName ?? "someone not yet in the tree")</span>
                        }
                        · by @(story.AuthorDisplayName ?? story.AuthorName ?? "Unknown")
                        · @story.CreatedAt.ToLocalTime().ToString("d MMM yyyy")
                    </div>
                    <p style="font-size:14px; color:var(--ft-gray-600); line-height:1.6; margin:0; white-space:pre-wrap;">
                        @story.Body
                    </p>
                </MudPaper>
            }
        </MudStack>
    }
</MudPaper>

@code {
    private List<StoryDto> _stories = [];
    private List<PersonDto> _allPeople = [];
    private Dictionary<Guid, PersonDto> _peopleById = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        var peopleTask = PersonService.GetAllAsync();
        var storiesTask = StoryService.GetAllApprovedAsync();
        await Task.WhenAll(peopleTask, storiesTask);

        if (peopleTask.Result.Success)
        {
            _allPeople = peopleTask.Result.Data!;
            _peopleById = _allPeople.ToDictionary(p => p.Id);
        }

        if (storiesTask.Result.Success)
            _stories = storiesTask.Result.Data!;
        else
            Toast.Error(storiesTask.Result.Message);

        _loading = false;
    }

    private async Task AddStory()
    {
        var parameters = new DialogParameters<StoryFormDialog>
        {
            { d => d.AllPeople, _allPeople },
        };

        var dialog = await DialogService.ShowAsync<StoryFormDialog>(
            "Add a story", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Toast.Success("Story added");
            var refreshed = await StoryService.GetAllApprovedAsync();
            if (refreshed.Success) _stories = refreshed.Data!;
        }
    }
}
