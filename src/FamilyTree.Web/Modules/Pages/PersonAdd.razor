@page "/people/add"
@rendermode InteractiveServer

@using FamilyTree.Core.Services
@using FamilyTree.Shared.DTOs.Person
@using FamilyTree.Shared.DTOs.Relationship
@using FamilyTree.Shared.Enums
@using FamilyTree.Web.Modules.Components
@using FamilyTree.Web.Modules.Dialogs
@using FamilyTree.Web.Services
@using MudBlazor

@inject IPersonService PersonService
@inject IRelationshipService RelationshipService
@inject NavigationManager Nav
@inject ToastService Toast
@inject IDialogService DialogService

<PageTitle>Add person</PageTitle>


@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Success" />
}
else
{
    <div class="ft-form-page">
        <MudContainer MaxWidth="MaxWidth.Medium">
            <div class="page-header">Add person</div>
            <PersonForm @ref="_form"
                        AllPeople="_allPeople"
                        Initial="_initial"
                        SubmitLabel="Add person"
                        OnSubmit="HandleSubmit"
                        OnCancel="@(() => Nav.NavigateTo("/people"))" />
        </MudContainer>
    </div>
}

@if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
}

@code {
    [SupplyParameterFromQuery(Name = "name")] public string? PrefillName { get; set; }

    private PersonForm? _form;
    private List<PersonDto> _allPeople = [];
    private PersonUpsertDto? _initial;
    private bool _loading = true;
    private string _error = "";

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(PrefillName))
        {
            var parts = PrefillName.Trim().Split(' ', 2, StringSplitOptions.RemoveEmptyEntries);
            _initial = new PersonUpsertDto
            {
                FirstName = parts.Length > 0 ? parts[0] : "",
                LastName = parts.Length > 1 ? parts[1] : "",
            };
        }

        try
        {
            var result = await PersonService.GetAllAsync();
            if (result.Success)
                _allPeople = result.Data!;
            else
                Toast.Error(result.Message);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Toast.Error(ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task HandleSubmit(PersonUpsertDto dto)
    {
        try
        {
            var result = await PersonService.CreateAsync(dto);
            if (!result.Success)
            {
                _error = result.Message;
                Toast.Error(result.Message);
                return;
            }

            var newPerson = result.Data!;
            Toast.Success($"{newPerson.FullName} added.");

            // The person exists now, so a failure below is reported on its own rather than
            // undoing the add. Until 2026-10-25 these steps ignored their results and a
            // Member's photo and extra sibling links were silently lost (Outreach A2).
            if (_form?.HasPendingPhotos == true)
            {
                var upload = await _form.UploadPendingAsync(newPerson.Id);
                foreach (var failure in upload.Failures)
                    Toast.Error($"Photo not saved. {failure}");
                if (upload.PrimaryMediumId is { } mediumId)
                {
                    var photo = await PersonService.SetProfilePhotoAsync(newPerson.Id, mediumId);
                    if (!photo.Success)
                        Toast.Error($"Photo saved, but not set as the profile photo. {photo.Message}");
                }
            }

            // Offer to link missing sibling connections
            await OfferSiblingLinks(newPerson.Id, newPerson.FullName, dto);

            Nav.NavigateTo("/people");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Toast.Error(ex.Message);
        }
    }

    private async Task OfferSiblingLinks(Guid newPersonId, string newPersonName, PersonUpsertDto submittedDto)
    {
        var linkedSiblingIds = submittedDto.SiblingIds;
        if (linkedSiblingIds.Count == 0) return;

        var suggestions  = new List<PersonDto>();
        PersonDto? firstSibling = null;

        foreach (var sibId in linkedSiblingIds)
        {
            var sib = _allPeople.FirstOrDefault(p => p.Id == sibId);
            if (sib == null) continue;

            var missing = (sib.SiblingIds ?? [])
                .Where(id => id != newPersonId && !linkedSiblingIds.Contains(id))
                .Select(id => _allPeople.FirstOrDefault(p => p.Id == id))
                .Where(p => p != null).Select(p => p!)
                .ToList();

            if (missing.Count > 0) firstSibling ??= sib;

            foreach (var m in missing)
                if (!suggestions.Any(s => s.Id == m.Id))
                    suggestions.Add(m);
        }

        if (suggestions.Count == 0 || firstSibling == null) return;

        var parameters = new DialogParameters<SiblingInferenceDialog>
        {
            { d => d.NewPersonName,     newPersonName },
            { d => d.LinkedSiblingName, firstSibling.FullName },
            { d => d.SuggestedSiblings, suggestions }
        };

        var dialog = await DialogService.ShowAsync<SiblingInferenceDialog>(
            "Link more siblings?", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });

        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            // One link at a time through RelationshipService, which Members may use, rather
            // than PersonService.UpdateAsync, which they may not.
            var failed = new List<string>();
            foreach (var sibling in suggestions)
            {
                var link = await RelationshipService.CreateAsync(new RelationshipUpsertDto
                {
                    PersonAId = newPersonId,
                    PersonBId = sibling.Id,
                    Type = RelationshipType.Sibling,
                });
                if (!link.Success) failed.Add($"{sibling.FullName} ({link.Message})");
            }

            var linked = suggestions.Count - failed.Count;
            if (linked > 0)
                Toast.Success($"Linked as sibling to {linked} more.");
            if (failed.Count > 0)
                Toast.Error($"Couldn't link as sibling to {string.Join(", ", failed)}.");
        }
    }
}