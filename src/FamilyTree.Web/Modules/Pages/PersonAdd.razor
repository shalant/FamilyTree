@page "/people/add"
@rendermode InteractiveServer

@using FamilyTree.Core.Services
@using FamilyTree.Shared.DTOs.Person
@using FamilyTree.Web.Modules.Components
@using MudBlazor

@inject IPersonService PersonService
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Add person</PageTitle>


@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudContainer MaxWidth="MaxWidth.Medium" Class="pb-8" Style="margin:auto;">
        <div class="page-header">
            Add person
        </div>

        <MudCard Class="pa-4 mb-4">
            <PersonForm @ref="_form"
                        AllPeople="_allPeople"
                        SubmitLabel="Add person"
                        OnSubmit="HandleSubmit"
                        OnCancel="@(() => Nav.NavigateTo("/people"))" />
        </MudCard>
    </MudContainer>
}

@if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
}

@code {
    private PersonForm? _form;
    private List<PersonDto> _allPeople = [];
    private bool _loading = true;
    private string _error = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await PersonService.GetAllAsync();
            if (result.Success)
                _allPeople = result.Data!;
            else
                Snackbar.Add(result.Message, Severity.Error);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task HandleSubmit(PersonUpsertDto dto)
    {
        Console.WriteLine($"HandleSubmit fired for {dto.FirstName} {dto.LastName}");
        try
        {
            var result = await PersonService.CreateAsync(dto);
            if (!result.Success)
            {
                _error = result.Message;
                return;
            }

            var personId = result.Data!.Id;

            // Upload any photos queued in the form and back-fill ProfilePhotoUrl
            if (_form?.HasPendingPhotos == true)
            {
                var primaryUrl = await _form.UploadPendingAsync(personId);
                if (primaryUrl is not null)
                {
                    dto.ProfilePhotoUrl = primaryUrl;
                    await PersonService.UpdateAsync(personId, dto);
                }
            }

            Nav.NavigateTo("/people");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
