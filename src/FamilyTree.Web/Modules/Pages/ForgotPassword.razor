@page "/forgot-password"
@rendermode InteractiveServer

@using MudBlazor
@inject NavigationManager Nav

<PageTitle>Forgot password — ArborKin</PageTitle>

<div class="ft-auth-page">
    <div class="intro-glass auth-card" style="max-width:420px;">

        @* ── Branding ──────────────────────────────────────────────────────── *@
        <div style="display:flex; justify-content:center; margin-bottom:16px; user-select:none;">
            <img src="/images/arborkin-logo.png" alt="ArborKin"
                 style="height:90px;" />
        </div>

        <div style="font-size:20px; font-weight:600; color:var(--ft-text-primary); margin-bottom:8px;">
            Password reset
        </div>

        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
            Automated password reset isn't set up yet. Contact the tree administrator to have your password reset manually.
        </MudAlert>

        <MudButton Variant="Variant.Text"
                   StartIcon="@Icons.Material.Outlined.ArrowBack"
                   OnClick='() => Nav.NavigateTo("/")'>
            Back to sign in
        </MudButton>

    </div>
</div>
