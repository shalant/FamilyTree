@page "/forgot-password"
@layout AuthLayout
@rendermode InteractiveServer

@using MudBlazor
@using FamilyTree.Core.Services
@inject IAuthService AuthService
@inject NavigationManager Nav

<PageTitle>Forgot password — ArborKin</PageTitle>

<div class="ft-auth-page">
    <div class="intro-glass auth-card" style="max-width:420px;">

        @* ── Branding ──────────────────────────────────────────────────────── *@
        <div style="display:flex; justify-content:center; margin-bottom:16px; user-select:none;">
            <img src="/images/arborkin-logo__transparent.png" alt="ArborKin"
                 style="width:80%; max-width:320px; height:auto;" />
        </div>

        <div style="font-size:20px; font-weight:600; color:var(--ft-text-primary); margin-bottom:8px;">
            Password reset
        </div>

        @if (_sent)
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-4">
                If an account exists for that email, a reset link has been sent.
                Check your inbox — it may take a minute to arrive.
            </MudAlert>
        }
        else
        {
            <div style="font-size:13px; color:var(--ft-text-muted); margin-bottom:20px; line-height:1.6;">
                Enter your email address and we'll send you a link to reset your password.
            </div>

            @if (_error is not null)
            {
                <div class="auth-error" style="margin-bottom:12px;">@_error</div>
            }

            <div class="ft-field-label">Email address</div>
            <MudTextField @bind-Value="_email"
                          Placeholder="your@email.com"
                          InputType="InputType.Email"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Disabled="_loading"
                          @onkeydown="@(async e => { if (e.Key == "Enter") await Submit(); })" />

            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       FullWidth="true" Class="mt-4"
                       OnClick="Submit"
                       Disabled="_loading">
                @if (_loading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true"
                                         Style="color:#fff; margin-right:8px;" />
                }
                Send reset link
            </MudButton>
        }

        <div style="margin-top:16px; text-align:center;">
            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Outlined.ArrowBack"
                       Style="color:var(--ft-gray-400); font-size:13px;"
                       OnClick='() => Nav.NavigateTo("/")'>
                Back to sign in
            </MudButton>
        </div>

    </div>
</div>

@code {
    private string _email   = "";
    private bool   _loading;
    private bool   _sent;
    private string? _error;

    private async Task Submit()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_email))
        {
            _error = "Please enter your email address.";
            return;
        }

        _loading = true;
        await AuthService.RequestPasswordResetAsync(_email.Trim(), Nav.BaseUri);
        _loading = false;
        _sent = true;
    }
}
