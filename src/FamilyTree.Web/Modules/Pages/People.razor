@page "/people"
@rendermode InteractiveServer

@using FamilyTree.Api.Services
@using FamilyTree.Shared.DTOs.Person
@using FamilyTree.Shared.Enums
@using MudBlazor

@inject IPersonService PersonService
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>People</PageTitle>

<MudPaper Elevation="0" Class="pa-4" Style="background:var(--ft-surface);">
    <MudStack Row="true" AlignItems="AlignItems.Center"
              Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.h5"
                     Style="font-style:italic; font-family:Georgia,serif;
                color:var(--ft-green-800);">
                Family members
            </MudText>
            @if (!_loading && _people.Any())
            {
                <MudChip T="string" Size="Size.Small"
                         Style="background:var(--ft-green-50); color:var(--ft-green-700);">
                    @_people.Count total
                </MudChip>
            }
        </MudStack>

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudTextField @bind-Value="_search"
                          Placeholder="Search by name or place…"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Style="min-width:220px;"
                          Class="search-field" />
            <MudToggleGroup T="string" @bind-Value="_statusFilter"
                            SelectionMode="SelectionMode.SingleSelection"
                            Style="height:36px;">
                <MudToggleItem Value="@("all")" Text="All" />
                <MudToggleItem Value="@("living")" Text="Living" />
                <MudToggleItem Value="@("deceased")" Text="Deceased" />
            </MudToggleGroup>
            <MudTooltip Text="Add person" Placement="Placement.Bottom">
                <MudIconButton Icon="@Icons.Material.Outlined.PersonAdd"
                               Color="Color.Success"
                               OnClick='() => Nav.NavigateTo("/people/add")' />
            </MudTooltip>
        </MudStack>
    </MudStack>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Success" Class="mb-4" />
    }
    else if (!_people.Any())
    {
        <MudPaper Elevation="2" Class="pa-6 mx-auto text-center"
                  Style="max-width:420px; background:rgba(245,245,245,0.4);
            backdrop-filter:blur(12px); border-radius:12px;">
            <MudText Typo="Typo.h6" Style="font-style:italic; color:var(--ft-green-800);">
                No family members yet
            </MudText>
            <MudText Typo="Typo.body2" Style="color:var(--ft-gray-500);">
                Add your first person to begin building your tree.
            </MudText>
            <MudButton Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.PersonAdd"
                       Href="/people/add"
                       Style="background:var(--ft-green-600); color:#fff; margin-top:16px;">
                Add person
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudTable Items="FilteredPeople" Hover="true"
                  T="PersonDto"
                  OnRowClick="@(e => Nav.NavigateTo($"/people/{e.Item!.Id}/edit"))"
                  Class="people-table">
            <HeaderContent>
                <MudTh Style="width:36px;"></MudTh>
                <MudTh><MudTableSortLabel T="PersonDto" SortBy="p => p.LastName">Name</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="PersonDto" SortBy="p => p.BirthDate">Born</MudTableSortLabel></MudTh>
                <MudTh>Birthplace</MudTh>
                <MudTh><MudTableSortLabel T="PersonDto" SortBy="p => p.DeathDate">Died</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="PersonDto" SortBy="p => p.Age">Age</MudTableSortLabel></MudTh>
                <MudTh></MudTh>
            </HeaderContent>

            <RowTemplate Context="person">
                <MudTd>
                    <MudTooltip Text="@(person.IsDeceased ? "Deceased" : "Living")">
                        <div style="width:8px; height:8px; border-radius:50%;
                            background:@(person.IsDeceased ? "var(--ft-gray-300)" : "var(--ft-green-500)");
                            margin:auto;" />
                    </MudTooltip>
                </MudTd>
                <MudTd DataLabel="Name">
                    <span style="font-weight:500;">@person.FullName</span>
                    @if (person.Gender.HasValue && person.Gender != Gender.Unknown)
                    {
                        <MudIcon Icon="@GenderIcon(person.Gender)"
                                 Style="font-size:14px; color:var(--ft-gray-300); margin-left:5px; vertical-align:middle;" />
                    }
                    @if (!string.IsNullOrWhiteSpace(person.MaidenName))
                    {
                        <span style="font-size:12px; color:var(--ft-gray-400); margin-left:4px;">
                            (née @person.MaidenName)
                        </span>
                    }
                </MudTd>
                <MudTd DataLabel="Born">@person.BirthDate?.ToString("d MMM yyyy")</MudTd>
                <MudTd DataLabel="Birthplace" Style="color:var(--ft-gray-500); font-size:13px;">
                    @person.BirthPlace
                </MudTd>
                <MudTd DataLabel="Died">@person.DeathDate?.ToString("d MMM yyyy")</MudTd>
                <MudTd DataLabel="Age">@person.Age</MudTd>
                <MudTd>
                    <MudTooltip Text="Edit" Placement="Placement.Left">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       OnClick="@(() => Nav.NavigateTo($"/people/{person.Id}/edit"))" />
                    </MudTooltip>
                </MudTd>
            </RowTemplate>

            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    }
</MudPaper>

@code {
    private List<PersonDto> _people = [];
    private bool _loading = true;
    private string _search = "";
    private string _statusFilter = "all";

    protected override async Task OnInitializedAsync()
    {
        var result = await PersonService.GetAllAsync();
        if (result.Success)
            _people = result.Data!;
        else
            Snackbar.Add(result.Message, Severity.Error);

        _loading = false;
    }

    private IEnumerable<PersonDto> FilteredPeople
    {
        get
        {
            var q = _people.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_search))
                q = q.Where(p =>
                    p.FullName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    (p.BirthPlace ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    (p.DeathPlace ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase));

            q = _statusFilter switch
            {
                "living" => q.Where(p => !p.IsDeceased),
                "deceased" => q.Where(p => p.IsDeceased),
                _ => q
            };

            return q;
        }
    }

    private static string GenderIcon(Gender? gender) => gender switch
    {
        Gender.Male => Icons.Material.Outlined.Male,
        Gender.Female => Icons.Material.Outlined.Female,
        _ => Icons.Material.Outlined.Transgender
    };
}