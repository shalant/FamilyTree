@page "/import"
@rendermode InteractiveServer

@using FamilyTree.Web.Modules.Components

@inject NavigationManager Nav

<PageTitle>Import data</PageTitle>

<div style="max-width:860px; margin:0 auto; padding:28px 24px 64px;
    font-family:var(--ft-font-body);">

    @* ── Back + header ────────────────────────────────────────────────────── *@
    <div style="display:flex; align-items:center; gap:8px; margin-bottom:28px;">
        <MudIconButton Icon="@Icons.Material.Outlined.ArrowBack"
                       Style="color:var(--ft-gray-500);"
                       OnClick='() => Nav.NavigateTo("/dashboard")' />
        <div>
            <div style="font-size:12px; color:var(--ft-gray-300); letter-spacing:0.04em; margin-bottom:1px;">
                Dashboard
            </div>
            <div style="font-size:22px; font-weight:600; font-style:italic;
                font-family:var(--ft-font-display); color:var(--ft-green-800); line-height:1.1;">
                Import family data
            </div>
        </div>
    </div>

    <ImportFormPanel BackUrl="/dashboard" />

</div>
