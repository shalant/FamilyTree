@page "/import"
@rendermode InteractiveServer

@inject NavigationManager Nav

<PageTitle>Import data</PageTitle>

@* Bulk import is deactivated for now — the layout engine's fragility with
   hand-entered edge cases (siblings without a shared parent, cross-root couples,
   etc.) this session made clear that arbitrary bulk-imported genealogy data would
   surface many of those same issues at once, with much less chance to catch and
   fix them one at a time. See docs/FutureFeatures/bulk-import-deactivated.md.
   ImportFormPanel/ClaudeImportService/ImportsTab are left in place, unreferenced,
   for whenever this gets revisited (likely alongside dropping the birth-year-based
   Y-axis in favor of pure generational depth). *@
<div style="max-width:640px; margin:80px auto; padding:0 24px; text-align:center;
    font-family:var(--ft-font-body);">
    <MudIcon Icon="@Icons.Material.Outlined.Construction"
             Style="font-size:40px; color:var(--ft-gray-300); margin-bottom:12px;" />
    <div style="font-size:20px; font-weight:600; font-style:italic;
        font-family:var(--ft-font-display); color:var(--ft-green-800); margin-bottom:8px;">
        Bulk import is temporarily unavailable
    </div>
    <p style="font-size:14px; color:var(--ft-gray-400); line-height:1.6; margin-bottom:24px;">
        We're holding off on bulk import while we make sure the family tree renders
        correctly for hand-entered data first. Add people one at a time for now —
        we'll bring bulk import back once it's ready.
    </p>
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               OnClick='() => Nav.NavigateTo("/dashboard")'>
        Back to dashboard
    </MudButton>
</div>
