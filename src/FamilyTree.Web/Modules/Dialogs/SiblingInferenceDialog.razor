@using FamilyTree.Shared.DTOs.Person
@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-weight:600">Link more siblings?</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Style="margin-bottom:16px">
            <strong>@NewPersonName</strong> was linked as a sibling of <strong>@LinkedSiblingName</strong>.
            @if (SuggestedSiblings.Count == 1)
            {
                <text> They also have another sibling who isn't linked yet:</text>
            }
            else
            {
                <text> They also have @SuggestedSiblings.Count siblings who aren't linked yet:</text>
            }
        </MudText>

        <div class="sibling-suggestion-list">
            @foreach (var p in SuggestedSiblings)
            {
                <div class="sibling-suggestion-item">
                    <div class="sibling-suggestion-avatar">
                        @(string.IsNullOrWhiteSpace(p.FirstName) ? "?" : p.FirstName[0].ToString().ToUpper())
                    </div>
                    <span>@p.FullName</span>
                </div>
            }
        </div>

        <MudText Typo="Typo.body2" Style="margin-top:16px; color:var(--ft-text-secondary)">
            Should @NewPersonName be linked as a sibling of
            @(SuggestedSiblings.Count == 1 ? "this person" : "all these people") too?
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Skip for now</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Confirm">
            Yes, link @(SuggestedSiblings.Count == 1 ? "them" : "all")
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
    .sibling-suggestion-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .sibling-suggestion-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 12px;
        background: var(--ft-green-50);
        border: 1px solid var(--ft-green-100);
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--ft-text-primary);
    }

    .sibling-suggestion-avatar {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: var(--ft-green-200);
        color: var(--ft-green-800);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        font-weight: 700;
        flex-shrink: 0;
    }
</style>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public required string NewPersonName    { get; set; }
    [Parameter] public required string LinkedSiblingName { get; set; }
    [Parameter] public required List<PersonDto> SuggestedSiblings { get; set; }

    private void Cancel()  => MudDialog.Cancel();
    private void Confirm() => MudDialog.Close(true);
}
