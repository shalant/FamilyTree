@inherits BaseComponent

@using FamilyTree.Shared.DTOs.Admin
@using FamilyTree.Shared.DTOs.Person
@using FamilyTree.Web.Components
@inject IPersonService PersonService
@inject IDataIntegrityService DataIntegrityService

<MudPaper Class="pa-3 mb-3" Style="background:var(--ft-surface-card);" Elevation="0">
    <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px;">
        <div>
            <MudText Typo="Typo.subtitle2">Data integrity</MudText>
            <MudText Typo="Typo.caption" Style="color:var(--ft-text-muted);">
                Checks for relationships still pointing at a soft-deleted person and auto-fixes any found.
            </MudText>
        </div>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Outlined.HealthAndSafety"
                   Disabled="@_checkingIntegrity"
                   OnClick="RunIntegrityCheckAsync">
            @if (_checkingIntegrity)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Run integrity check
        </MudButton>
    </div>
    @if (_lastIntegrityFixes != null)
    {
        @if (_lastIntegrityFixes.Count == 0)
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mt-2" Dense="true">
                No orphaned relationships found.
            </MudAlert>
        }
        else
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-2" Dense="true">
                Fixed @_lastIntegrityFixes.Count orphaned relationship(s):
                <ul style="margin:4px 0 0 20px;">
                    @foreach (var fix in _lastIntegrityFixes)
                    {
                        <li>@fix.Type: @fix.PersonAName ↔ @fix.PersonBName</li>
                    }
                </ul>
            </MudAlert>
        }
    }
</MudPaper>

@if (_loadingDeleted)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_deleted.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        No deleted people. Soft-deleted records will appear here for review and restore.
    </MudAlert>
}
else
{
    <MudTable Items="_deleted" Hover="true" Dense="true"
              Virtualize="false"
              Style="background:var(--ft-surface-card);">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Deleted</MudTh>
            <MudTh>Born</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd Style="@(context.IsRestored ? "opacity:0.5;" : null)">@context.FullName</MudTd>
            <MudTd Style="@(context.IsRestored ? "opacity:0.5;" : null)">
                <MudText Typo="Typo.caption" Style="color:var(--ft-text-muted);">
                    @context.DeletedAt?.ToString("MMM d, yyyy h:mm tt")
                </MudText>
            </MudTd>
            <MudTd Style="@(context.IsRestored ? "opacity:0.5;" : null)">
                <MudText Typo="Typo.caption">
                    @(context.BirthDate?.ToString("yyyy") ?? "—")
                </MudText>
            </MudTd>
            <MudTd Style="text-align:right;">
                @if (context.IsRestored)
                {
                    <MudText Typo="Typo.caption" Style="color:var(--ft-green-600);">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Style="vertical-align:middle;" /> Restored
                    </MudText>
                }
                else
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Success"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Outlined.RestoreFromTrash"
                               Disabled="@context.IsRestoring"
                               OnClick="@(() => RestorePersonAsync(context))">
                        @if (context.IsRestoring)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Restore
                    </MudButton>
                }
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
        </PagerContent>
    </MudTable>
}

@code {
    private bool _loadingDeleted = true;
    private List<DeletedPersonRow> _deleted = [];
    private bool _checkingIntegrity;
    private List<OrphanedRelationshipFixDto>? _lastIntegrityFixes;

    protected override async Task OnInitializedAsync()
    {
        await LoadDeletedAsync();
    }

    private async Task RunIntegrityCheckAsync()
    {
        _checkingIntegrity = true;
        try
        {
            var fixes = await TryAsync(
                () => DataIntegrityService.FixOrphanedRelationshipsAsync(),
                "Running integrity check");

            if (fixes != null)
            {
                _lastIntegrityFixes = fixes;
                if (fixes.Count > 0)
                    ToastService.Success($"Fixed {fixes.Count} orphaned relationship(s).");
            }
        }
        finally
        {
            _checkingIntegrity = false;
        }
    }

    private async Task LoadDeletedAsync()
    {
        var data = await TryAsync(
            () => PersonService.GetDeletedAsync(),
            "Loading deleted persons");

        if (data != null)
            _deleted = data.Select(d => new DeletedPersonRow(d)).ToList();

        _loadingDeleted = false;
    }

    private async Task RestorePersonAsync(DeletedPersonRow row)
    {
        // Guard against a double-fire on the same row (e.g. an accidental second click
        // before the button's Disabled state re-renders).
        if (row.IsRestoring || row.IsRestored) return;

        row.IsRestoring = true;
        try
        {
            var success = await TryAsync(
                () => PersonService.RestoreAsync(row.Id),
                $"Restoring {row.FullName}");

            if (success)
            {
                // Deliberately NOT removed from _deleted here. Instantly removing a row
                // shifts every row below it up by one position — found 2026-07-07: a
                // single restore click was followed by two more, unintended restores on
                // whatever people had shifted into that same screen position by the time
                // later clicks landed, confirmed via the audit log (Gladys, then Dora
                // Herskovitz, then Harvey Fleishman, none of which were the second click
                // the user remembered making). Marking the row "restored" in place keeps
                // every other row's position stable for the rest of this viewing session;
                // it only disappears from the list on the next full reload.
                row.IsRestored = true;
                ToastService.Success($"{row.FullName} restored.");
            }
        }
        finally
        {
            row.IsRestoring = false;
        }
    }

    private sealed class DeletedPersonRow(PersonDto dto)
    {
        public Guid Id { get; } = dto.Id;
        public string FullName { get; } = dto.FullName;
        public DateTime? DeletedAt { get; } = dto.DeletedAt;
        public DateOnly? BirthDate { get; } = dto.BirthDate;
        public bool IsRestoring { get; set; }
        public bool IsRestored { get; set; }
    }
}
