@inherits BaseComponent

@using FamilyTree.Core.Models
@using FamilyTree.Core.Services
@using FamilyTree.Web.Components
@using FamilyTree.Web.Modules.Components
@inject IAdminActivityService AdminActivityService
@inject IDialogService DialogService

@if (_loadingActivity)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_activity.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        No activity recorded yet. Daily action counts per user will appear here once users are active.
    </MudAlert>
}
else
{
    <MudTable Items="_activity" T="UserActivity" Hover="true" Dense="true"
              OnRowClick="@(e => ShowActivityDetailAsync(e.Item!))"
              Style="background:var(--ft-surface-card); cursor:pointer;">
        <HeaderContent>
            <MudTh>Date</MudTh>
            <MudTh>User</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Date.ToString("MMM d, yyyy")</MudTd>
            <MudTd>
                <MudText Typo="Typo.caption" Style="color:var(--ft-text-muted);">
                    @(context.UserId.HasValue ? context.UserId.Value.ToString()[..8] + "…" : "—")
                </MudText>
            </MudTd>
            <MudTd>@context.ActionCount</MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
        </PagerContent>
    </MudTable>
}

@code {
    private bool _loadingActivity = true;
    private List<UserActivity> _activity = [];
    private List<AuditLog> _auditLogs = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadActivityAsync();
    }

    private async Task LoadActivityAsync()
    {
        _activity = await TryAsync(
            () => AdminActivityService.GetRecentActivityAsync(200),
            "Loading activity") ?? [];

        _auditLogs = await TryAsync(
            () => AdminActivityService.GetActivityAuditLogsAsync(null, DateOnly.FromDateTime(DateTime.Today)),
            "Loading audit logs") ?? [];

        _loadingActivity = false;
    }

    private async Task ShowActivityDetailAsync(UserActivity activity)
    {
        var entries = await TryAsync(
            () => AdminActivityService.GetActivityAuditLogsAsync(activity.UserId, activity.Date),
            "Loading activity details") ?? [];

        var who = activity.UserId.HasValue
            ? activity.UserId.Value.ToString()[..8] + "…"
            : "Unknown user";

        var parameters = new DialogParameters<ActivityDetailDialog>
        {
            { d => d.Entries, entries },
        };

        await DialogService.ShowAsync<ActivityDetailDialog>(
            $"{who} — {activity.Date:MMM d, yyyy}", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
    }
}
