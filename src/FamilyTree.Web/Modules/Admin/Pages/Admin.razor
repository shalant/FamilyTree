@page "/admin"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin,SuperUser")]

<PageTitle>Admin — ArborKin</PageTitle>

<style>
    .ft-admin-stat { transition: box-shadow 0.15s; cursor: default; }
    .ft-admin-stat:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.08) !important; }
    .ft-admin-nav-row { transition: background 0.1s; border-radius: 8px; cursor: pointer; }
    .ft-admin-nav-row:hover { background: var(--ft-green-50) !important; }
    /* The panels area is a flex row and the active panel is its only child, so without a basis it
       shrank to its content: Activity's table was 519px and Messages' 787px in a 1152px panel
       (UX/UI review A8, 2026-11-17). The old rule here named .mud-tabs-panel, a class MudBlazor
       does not render (it is .mud-tab-panel). */
    .ft-admin-tabs .mud-tab-panel { flex: 1 1 100%; min-width: 0; }
    /* Secondary text in the Admin tables (dates, ids, senders) is 12px or smaller light grey;
       readable for a quick look, not for someone squinting at a laptop (A7). */
    .ft-admin-tabs .ft-admin-secondary { font-size: 13px; color: var(--ft-gray-600); }
    .mud-tabs-panel { min-width: 0; }
    /* A wide table (Users, Stories) used to push the panel past the page's 1100px container, so
       the right edge jumped from tab to tab (UX/UI review A1, 2026-11-15). The panel area keeps
       its width and a wide table scrolls inside it. */
    .ft-admin-tabs .mud-tabs-panels { min-width: 0; overflow-x: auto; }
</style>

<div style="padding:24px; max-width:1400px; margin:auto;">

    <div style="margin-bottom:24px;">
        <div style="font-size:22px; font-weight:600; font-style:italic;
            font-family:var(--ft-font-display); color:var(--ft-green-800); line-height:1.2;">
            Admin
        </div>
        <div style="font-size:13px; color:var(--ft-gray-400); margin-top:2px;">
            ArborKin system management
        </div>
    </div>

    <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true"
             Position="Position.Left" Class="ft-admin-tabs"
             @bind-ActivePanelIndex="_activeTab">

        <MudTabPanel Text="Dashboard" Icon="@Icons.Material.Outlined.SpaceDashboard">
            <DashboardTab />
        </MudTabPanel>

        <MudTabPanel Text="Deleted" Icon="@Icons.Material.Outlined.DeleteSweep">
            <DeletedTab />
        </MudTabPanel>

        <MudTabPanel Text="Data check" Icon="@Icons.Material.Outlined.FactCheck">
            <DataCheckTab />
        </MudTabPanel>

        @* SuperUser-only (finding S2, docs/security.md): Users exposes every family's
           accounts plus copyable password-reset links; audit log and activity have no
           family scope.
           The services refuse family Admins too; hiding the tabs just avoids an error. *@
        @if (_isSuperUser)
        {
            <MudTabPanel Text="Problems" Icon="@Icons.Material.Outlined.ReportProblem">
                <ProblemsTab />
            </MudTabPanel>

            <MudTabPanel Text="Users" Icon="@Icons.Material.Outlined.Group">
                <UsersTab />
            </MudTabPanel>

            <MudTabPanel Text="Audit log" Icon="@Icons.Material.Outlined.History">
                <AuditLogTab />
            </MudTabPanel>

            <MudTabPanel Text="Activity" Icon="@Icons.Material.Outlined.BarChart">
                <ActivityTab />
            </MudTabPanel>

            @* Messages: every family writes to the owner's one inbox (UserMessageService). *@
            <MudTabPanel Text="Messages" Icon="@Icons.Material.Outlined.MailOutline">
                <MessagesTab />
            </MudTabPanel>
        }

        <MudTabPanel Text="Stories" Icon="@Icons.Material.Outlined.AutoStories">
            <StoriesTab />
        </MudTabPanel>

    </MudTabs>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private int _activeTab;
    private bool _isSuperUser;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
            _isSuperUser = (await AuthState).User.IsInRole("SuperUser");
    }
}
