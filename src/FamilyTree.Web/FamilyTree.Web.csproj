<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FamilyTree.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.8" />
    <PackageReference Include="MudBlazor" Version="9.4.0" />
    <PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Web references Shared only — never references Api directly -->
    <ProjectReference Include="..\FamilyTree.Api\FamilyTree.Api.csproj" />
    <ProjectReference Include="..\FamilyTree.Shared\FamilyTree.Shared.csproj" />
  </ItemGroup>
</Project>
