@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using FamilyTree.Web.Modules.Components

@* Rendered once, outside the Router, so it survives navigation between pages that use
   different layouts (Home's TreeLayout vs. everything else's MainLayout vs. AuthLayout).
   Each layout previously had its own <ToastContainer />, so swapping layouts disposed
   the old one mid-flight — its Dispose() cancels each toast's dismiss timer without
   removing it from ToastService, so the orphaned toast sat in the shared list forever
   and got "revived" with a full fresh countdown by the next layout's container whenever
   it next called HandleChanged(). That's what showed up live as toasts reappearing
   minutes later, or several piling up at once. One instance for the whole circuit fixes
   it at the root instead of patching Dispose(). See FamilyTree.Web/Services/ToastService.cs. *@
<ToastContainer />

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)">
            @* No <LayoutView> here: AuthorizeRouteView already renders NotAuthorized inside
               DefaultLayout. Wrapping it in a second MainLayout nested two MudPopoverProviders
               whenever a user navigated into a protected page from another MainLayout page
               (e.g. /faq -> /dashboard signed out), throwing "already a subscriber to the
               content with the given section ID 'mud-overlay-to-popover-provider'" and
               killing the circuit. *@
            <NotAuthorized>
                <div class="ft-inline-error-wrap">
                    <ErrorStateCard Icon="@Icons.Material.Outlined.Lock"
                                    Title="Access denied"
                                    Message="You don't have permission to view this page." />
                </div>
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="@typeof(Layout.MainLayout)">
            <div class="ft-inline-error-wrap">
                <ErrorStateCard Icon="@Icons.Material.Outlined.ExploreOff"
                                Title="Page not found"
                                Message="Sorry, there's nothing at this address." />
            </div>
        </LayoutView>
    </NotFound>
</Router>

@code {
    [Inject] private IJSRuntime JS { get; set; } = null!;

    // App.razor shows a static #ft-splash until the circuit connects (prerender is off).
    // First render of this root component means the circuit is up and content is painting.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { await JS.InvokeVoidAsync("ftHideSplash"); }
        catch (JSDisconnectedException) { }
    }
}
