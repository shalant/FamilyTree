<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>ArborKin</title>
    <base href="/" />
    <link rel="icon" type="image/svg+xml" href="/img/arborkin-favicon.svg" />
    <link rel="icon" type="image/png"     href="/img/arborkin-icon.png" sizes="32x32" />
    <script src="/js/theme-init.js?v=@AssetVersion("js/theme-init.js")"></script>
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="css/app.css?v=@AssetVersion("css/app.css")" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <HeadOutlet @rendermode="@InteractiveServer" />
</head>
<body>
    <Routes @rendermode="@InteractiveServer" />
    <div id="components-reconnect-modal">
        <div class="ft-reconnect-card">
            <div class="ft-reconnect-logo">
                <img src="/images/arborkin-logo__transparent.png" alt="ArborKin" />
            </div>

            <div class="ft-reconnect-body ft-reconnect-body--reconnecting">
                <div class="ft-reconnect-spinner"></div>
                <p>Reconnecting…</p>
                <p class="ft-reconnect-sub">Hang tight, this only takes a moment.</p>
            </div>
            <div class="ft-reconnect-body ft-reconnect-body--failed">
                <div class="ft-reconnect-icon ft-reconnect-icon--warn">📡</div>
                <p>Connection lost</p>
                <p class="ft-reconnect-sub">Check your connection and try again.</p>
                <button class="ft-reconnect-btn" id="ft-reconnect-retry">Try again</button>
                <button class="ft-reconnect-btn ft-reconnect-btn--ghost" id="ft-reconnect-reload">Reload page</button>
            </div>
            <div class="ft-reconnect-body ft-reconnect-body--rejected">
                <div class="ft-reconnect-icon">⏳</div>
                <p>Session expired</p>
                <p class="ft-reconnect-sub">Reloading in <span id="ft-reload-countdown">3</span>s…</p>
                <button class="ft-reconnect-btn" id="ft-reconnect-reload-now">Reload now</button>
            </div>
        </div>
    </div>
    <div id="blazor-error-ui">
        <span>An unexpected error occurred.</span>
        <a href="" class="reload">Reload</a>
        <a class="dismiss" aria-label="Dismiss">✕</a>
    </div>
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="/js/clipboard.js?v=@AssetVersion("js/clipboard.js")"></script>
    <script src="/js/ftUtils.js?v=@AssetVersion("js/ftUtils.js")"></script>
</body>
</html>

@code {
    // No Cache-Control header is set on static files (plain app.UseStaticFiles() in
    // Program.cs), so browsers fall back to heuristic caching off Last-Modified — the
    // longer it's been since a deploy touched a file, the longer a browser will trust
    // its cached copy without even revalidating. A production circuit that lived through
    // a deploy (or a browser that just hadn't revalidated in a while) could keep
    // rendering old CSS/JS indefinitely. Appending each file's own last-write time as a
    // query string forces a new URL — and a real fetch — the moment that specific file
    // changes on disk, without needing any build-time versioning infrastructure.
    [Inject] private IWebHostEnvironment Env { get; set; } = null!;

    private string AssetVersion(string relativePath)
    {
        try
        {
            var path = Path.Combine(Env.WebRootPath, relativePath);
            return File.GetLastWriteTimeUtc(path).Ticks.ToString();
        }
        catch
        {
            // A missing/unreadable file shouldn't block the page — this is the HTML shell.
            return "0";
        }
    }
}
