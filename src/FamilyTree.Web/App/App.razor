<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ArborKin</title>
    <base href="/" />
    <link rel="icon" type="image/svg+xml" href="/img/arborkin-favicon.svg" />
    <link rel="icon" type="image/png"     href="/img/arborkin-icon.png" sizes="32x32" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="css/app.css" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <HeadOutlet @rendermode="@InteractiveServer" />
</head>
<body>
    <Routes @rendermode="@InteractiveServer" />
    <div id="components-reconnect-modal">
        <div class="ft-reconnect-card">
            <div class="ft-reconnect-logo">
                <img src="/images/arborkin-logo__transparent.png" alt="ArborKin" />
            </div>

            <div class="ft-reconnect-body ft-reconnect-body--reconnecting">
                <div class="ft-reconnect-spinner"></div>
                <p>Reconnecting…</p>
                <p class="ft-reconnect-sub">Hang tight, this only takes a moment.</p>
            </div>
            <div class="ft-reconnect-body ft-reconnect-body--failed">
                <div class="ft-reconnect-icon ft-reconnect-icon--warn">📡</div>
                <p>Connection lost</p>
                <p class="ft-reconnect-sub">Check your connection and try again.</p>
                <button class="ft-reconnect-btn" onclick="window.Blazor.reconnect()">Try again</button>
                <button class="ft-reconnect-btn ft-reconnect-btn--ghost" onclick="location.reload()">Reload page</button>
            </div>
            <div class="ft-reconnect-body ft-reconnect-body--rejected">
                <div class="ft-reconnect-icon">⏳</div>
                <p>Session expired</p>
                <p class="ft-reconnect-sub">Reloading in <span id="ft-reload-countdown">3</span>s…</p>
                <button class="ft-reconnect-btn" onclick="location.reload()">Reload now</button>
            </div>
        </div>
    </div>
    <div id="blazor-error-ui">
        <span>An unexpected error occurred.</span>
        <a href="" class="reload">Reload</a>
        <a class="dismiss" aria-label="Dismiss">✕</a>
    </div>
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="/js/clipboard.js"></script>
    <script src="/js/ftUtils.js"></script>
</body>
</html>
